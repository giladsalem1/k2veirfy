stages:
  Stage 1:
    actors:
      DbCommand1:
        parent: DbCommand
        in:
          interface:
            const: K2VERIFY_OPERATIONAL_DB
          sql:
            const: select * from public.customer_test_1m_trg_pii_70pass where customer_id<=300000
        out:
          result:
            schema: '#ref'
  Stage 2:
    actors:
      CsvBuilder1:
        parent: CsvBuilder
        in:
          stream:
            const: true
          maps:
            link: DbCommand1/result
  Stage 3:
    actors:
      FileWrite1:
        parent: FileWrite
        in:
          interface:
            const: file:///opt/apps/fabric/workspace/project/project-resources
          path:
            const: tar_customer_1.csv
          stream:
            link: CsvBuilder1/csv
  Stage 4:
    actors:
      DbCommand2:
        parent: DbCommand
        in:
          interface:
            const: K2VERIFY_OPERATIONAL_DB
          sql:
            const: select * from public.customer_test_1m_trg_pii_70pass where customer_id
              >300000 AND customer_id <=600000
        out:
          result:
            schema: '#ref'
  Stage 5:
    actors:
      CsvBuilder2:
        parent: CsvBuilder
        in:
          stream:
            const: true
          maps:
            link: DbCommand2/result
  Stage 6:
    actors:
      FileWrite2:
        parent: FileWrite
        in:
          interface:
            const: file:///opt/apps/fabric/workspace/project/project-resources
          path:
            const: tar_customer_2.csv
          stream:
            link: CsvBuilder2/csv
  Stage 7:
    actors:
      DbCommand3:
        parent: DbCommand
        in:
          interface:
            const: K2VERIFY_OPERATIONAL_DB
          sql:
            const: select * from public.customer_test_1m_trg_pii_70pass where customer_id
              >600000
        out:
          result:
            schema: '#ref'
  Stage 8:
    actors:
      CsvBuilder3:
        parent: CsvBuilder
        in:
          stream:
            const: true
          maps:
            link: DbCommand3/result
  Stage 9:
    actors:
      FileWrite3:
        parent: FileWrite
        in:
          interface:
            const: file:///opt/apps/fabric/workspace/project/project-resources
          path:
            const: tar_customer_3.csv
          stream:
            link: CsvBuilder3/csv
