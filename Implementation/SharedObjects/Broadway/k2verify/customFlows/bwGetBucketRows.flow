tags: D2D,k2verify,testing
stages:
  Inputs:
    actors:
      CustomKey:
        parent: Const
        in:
          value:
            const: null
            external: customizedKey
        out:
          value:
            schema: string
      Delim:
        parent: Const
        in:
          value:
            const: null
            external: delimeter
        out:
          value:
            schema: string
      RESULT_INTERFACE:
        parent: GetLUVariable
        in:
          luName:
            const: verify
          variableName:
            const: K2VERIFY_OPERATIONAL_INTERFACE
      LOAD_SCHEMA:
        parent: GetLUVariable
        in:
          luName:
            const: verify
          variableName:
            const: K2VERIFY_OPERATIONAL_SCHEMA
      KEYS_TABLE_NAME:
        parent: GetLUVariable
        in:
          luName:
            const: verify
          variableName:
            const: K2VERIFY_KEYS_TABLE_NAME
      Exclude Condition:
        parent: Const
        in:
          value:
            const: null
            external: excludeCondition
        out:
          value:
            schema: string
      environment:
        parent: Const
        in:
          value:
            const: null
            external: environment
            schema: string
        out:
          value:
            schema: string
  Prepare data:
    actors:
      strKeys:
        parent: Replace
        in:
          search:
            const: null
            link: Delim/value
          replace:
            const: ' ,'
          string:
            link: CustomKey/value
      concatKeys:
        parent: Replace
        in:
          search:
            const: null
            link: Delim/value
          replace:
            const: ' || '
          string:
            link: CustomKey/value
      Replace1:
        parent: Replace
        in:
          search:
            const: null
            link: Delim/value
          replace:
            const: ' || ''|'' || '
          string:
            link: CustomKey/value
      exclude clause for single bucket:
        parent: StringFormat
        in:
          format:
            const: 'where ${where} '
          where:
            link: Exclude Condition/value
            schema: string
            mandatory: false
            createdBy: format
      IfElse2:
        parent: IfElse
        in:
          test:
            link: Exclude Condition/value
          a:
            link: exclude clause for single bucket/string
        out:
          result:
            schema: string
      Exclude Clause:
        parent: StringFormat
        in:
          format:
            const: ' and ${where} '
          where:
            link: Exclude Condition/value
            schema: string
            mandatory: false
      IfElse1:
        parent: IfElse
        in:
          test:
            link: Exclude Condition/value
          a:
            link: Exclude Clause/string
        out:
          result:
            schema: string
      SET ENVIRONMENT:
        parent: FabricSet
        in:
          key:
            const: ENVIRONMENT
          value:
            link: environment/value
      Exclude Clause1:
        parent: StringFormat
        in:
          format:
            const: ' where ${where} '
          where:
            link: Exclude Condition/value
            schema: string
            mandatory: false
      IfElse3:
        parent: IfElse
        in:
          a:
            link: Exclude Clause1/string
        out:
          result:
            schema: string
  '# Buckets is 1':
    dependsOn: Prepare data
    actors:
      =1:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: '1'
            schema: string
          a:
            external: bucketsNum
    split: '--------------------'
  Else:
    else: true
    dependsOn: Prepare data
  Cass DB query for 1 bucket:
    else: false
    dependsOn: '# Buckets is 1'
    actors:
      CASS DB:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: Cassandra (Db)
            schema: string
          a:
            external: interfaceType
      DbCommand4:
        parent: DbCommand
        in:
          interface:
            const: null
            link: RESULT_INTERFACE/variableValue
          sql:
            const: select org_key as "${@keysAlias}" from ${@keysTableSchema}.${@keysTable}
          keysTableSchema:
            link: LOAD_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          keysTable:
            link: KEYS_TABLE_NAME/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          keysAlias:
            link: Replace1/string
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  Stage 1:
    else: true
    dependsOn: '# Buckets is 1'
    actors:
      DbCommand1:
        parent: DbCommand
        in:
          interface:
            const: null
            external: interface
          sql:
            const: SELECT ${@key} as "${@keysAlias}"  FROM ${@schema}.${@table} ${@where}
          key:
            link: Replace1/string
            schema: string
            mandatory: false
            createdBy: sql
          schema:
            external: schema
            schema: string
            mandatory: false
            createdBy: sql
          table:
            external: table
            schema: string
            mandatory: false
            createdBy: sql
          keysAlias:
            link: CustomKey/value
            schema: string
            mandatory: false
            createdBy: sql
          where:
            link: IfElse2/result
            schema: any
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  Execute filtering query:
    dependsOn: Else
    actors:
      Oracle DB1:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: Oracle (Db)
            schema: string
          a:
            external: interfaceType
      DbCommand9:
        parent: DbCommand
        in:
          interface:
            const: null
            external: interface
          sql:
            const: SELECT ${@key} as "${@keysAlias}"  FROM ${@schema}.${@table} WHERE
              MOD(ORA_HASH(${@concatKey}), ${@bucketsNum}) = ${@bucketID} ${@and}
          key:
            link: Replace1/string
            schema: string
            mandatory: false
            createdBy: sql
          schema:
            external: schema
            schema: string
            mandatory: false
            createdBy: sql
          table:
            external: table
            schema: string
            mandatory: false
            createdBy: sql
          concatKey:
            link: concatKeys/string
            schema: string
            mandatory: false
            createdBy: sql
          bucketsNum:
            external: bucketsNum
            schema: string
            mandatory: false
            createdBy: sql
          bucketID:
            external: bucketID
            schema: string
            mandatory: false
            createdBy: sql
          and:
            link: IfElse1/result
            schema: string
            mandatory: false
            createdBy: sql
          keysAlias:
            link: CustomKey/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  Stage 10:
    else: true
    dependsOn: Else
    actors:
      DB2 DB1:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: DB2 (Db)
            schema: string
          a:
            external: interfaceType
      DbCommand5:
        parent: DbCommand
        in:
          interface:
            const: null
            external: interface
          sql:
            const: SELECT ${@key} as "${@keysAlias}" FROM ${@schema}.${@table} WHERE
              MOD(ABS(HASH8(${@concatKey})), ${@bucketsNum}) = ${@bucketID} ${@and}
          key:
            link: Replace1/string
            schema: string
            mandatory: false
            createdBy: sql
          schema:
            external: schema
            schema: string
            mandatory: false
            createdBy: sql
          table:
            external: table
            schema: string
            mandatory: false
            createdBy: sql
          concatKey:
            link: concatKeys/string
            schema: string
            mandatory: false
            createdBy: sql
          bucketsNum:
            external: bucketsNum
            schema: string
            mandatory: false
            createdBy: sql
          bucketID:
            external: bucketID
            schema: string
            mandatory: false
            createdBy: sql
          and:
            link: IfElse1/result
            schema: any
            mandatory: false
            createdBy: sql
          keysAlias:
            link: CustomKey/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  Stage 11:
    else: true
    dependsOn: Else
    actors:
      PG DB1:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: PostgreSQL (Db)
            schema: string
          a:
            external: interfaceType
      DbCommand6:
        parent: DbCommand
        in:
          interface:
            const: null
            external: interface
          sql:
            const: SELECT ${@key} as "${@keysAlias}" FROM ${@schema}.${@table} WHERE  MOD(ABS(hashtext(${@concatKey}
              || '')::bigint),${@bucketsNum}) = ${@bucketID} ${@and}
          key:
            link: Replace1/string
            schema: string
            mandatory: false
            createdBy: sql
          schema:
            external: schema
            schema: string
            mandatory: false
            createdBy: sql
          table:
            external: table
            schema: string
            mandatory: false
            createdBy: sql
          concatKey:
            link: concatKeys/string
            schema: string
            mandatory: false
            createdBy: sql
          bucketsNum:
            external: bucketsNum
            schema: string
            mandatory: false
            createdBy: sql
          bucketID:
            external: bucketID
            schema: string
            mandatory: false
            createdBy: sql
          and:
            link: IfElse1/result
            schema: any
            mandatory: false
            createdBy: sql
          keysAlias:
            link: CustomKey/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  Stage 12:
    else: true
    dependsOn: Else
    actors:
      Sqlite DB:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: sqlite (Db)
            schema: string
          a:
            external: interfaceType
      DbCommand2:
        parent: DbCommand
        in:
          interface:
            const: null
            external: interface
          sql:
            const: |-
              SELECT ${@key} AS "${@keysAlias}"
              FROM ${@schema}.${@table} ${@and}
          key:
            link: Replace1/string
            schema: string
            mandatory: false
            createdBy: sql
          keysAlias:
            link: CustomKey/value
            schema: string
            mandatory: false
            createdBy: sql
          schema:
            external: schema
            schema: string
            mandatory: false
            createdBy: sql
          table:
            external: table
            schema: string
            mandatory: false
            createdBy: sql
          and:
            link:
            - IfElse1/result
            - IfElse3/result
            schema: any
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  Stage 4:
    else: true
    dependsOn: Else
    actors:
      CASS DB1:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: Cassandra (Db)
            schema: string
          a:
            external: interfaceType
      DbCommand7:
        parent: DbCommand
        in:
          interface:
            const: null
            link: RESULT_INTERFACE/variableValue
          sql:
            const: select org_key as "${@keysAlias}" from ${@keysTableSchema}.${@keysTable}
              where group_id='${@bucketID}' ${@and}
          keysTableSchema:
            link: LOAD_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          bucketID:
            external: bucketID
            schema: string
            mandatory: false
            createdBy: sql
          keysTable:
            link: KEYS_TABLE_NAME/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          and:
            link: IfElse1/result
            schema: any
            mandatory: false
            createdBy: sql
          keysAlias:
            link: CustomKey/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  Stage 2:
    else: true
    dependsOn: Else
    actors:
      Mysql:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: Mysql (Db)
            schema: string
          a:
            external: interfaceType
      DbCommand2 - MySQL:
        parent: DbCommand
        in:
          interface:
            const: null
            external: interface
          sql:
            const: SELECT ${@key} as "${@keysAlias}"  FROM ${@schema}.${@table} WHERE
              MOD(CAST(CRC32(${@concatKey}) AS "UNSIGNED"), ${@bucketsNum}) = ${@bucketID}
              ${@and}
          key:
            link: Replace1/string
            schema: string
            mandatory: false
            createdBy: sql
          schema:
            external: schema
            schema: string
            mandatory: false
            createdBy: sql
          table:
            external: table
            schema: string
            mandatory: false
            createdBy: sql
          concatKey:
            link: concatKeys/string
            schema: string
            mandatory: false
            createdBy: sql
          bucketsNum:
            external: bucketsNum
            schema: string
            mandatory: false
            createdBy: sql
          bucketID:
            external: bucketID
            schema: string
            mandatory: false
            createdBy: sql
          and:
            link: IfElse1/result
            schema: string
            mandatory: false
            createdBy: sql
          keysAlias:
            link: CustomKey/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  Stage 5:
    else: true
    dependsOn: Else
    actors:
      vsam (Db):
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: vsam (Db)
            schema: string
          a:
            external: interfaceType
      DbCommand3:
        parent: DbCommand
        in:
          interface:
            const: null
            external: interface
          sql:
            const: SELECT ${@key} as "${@keysAlias}"  FROM ${@schema}.${@table} WHERE
              MOD(CAST(${@concatKey} AS INTEGER),  ${@bucketsNum}) = ${@bucketID}
              ${@and}
          key:
            link: Replace1/string
            schema: string
            mandatory: false
            createdBy: sql
          schema:
            external: schema
            schema: string
            mandatory: false
            createdBy: sql
          table:
            external: table
            schema: string
            mandatory: false
            createdBy: sql
          concatKey:
            link: concatKeys/string
            schema: string
            mandatory: false
            createdBy: sql
          bucketsNum:
            external: bucketsNum
            schema: string
            mandatory: false
            createdBy: sql
          bucketID:
            external: bucketID
            schema: string
            mandatory: false
            createdBy: sql
          and:
            link: IfElse1/result
            schema: string
            mandatory: false
            createdBy: sql
          keysAlias:
            link: CustomKey/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Stage 3:
    actors:
      DeepCopyKeysRS1:
        parent: DeepCopy
        height: 3499
        in:
          value:
            link:
            - DbCommand4/result
            - DbCommand1/result
            - DbCommand9/result
            - DbCommand5/result
            - DbCommand6/result
            - DbCommand2/result
            - DbCommand7/result
            - DbCommand2 - MySQL/result
            - DbCommand3/result
        out:
          value:
            external: bucketRows
            schema: '#ref'
schemas:
  DbCommand4.out.result:
    type: array
    items:
      type: object
      properties:
        org_key:
          type: string
  DbCommand1.out.result:
    type: array
    items:
      type: object
      properties:
        CUSTOMER_ID:
          type: string
        SSN:
          type: string
  DbCommand9.out.result:
    type: array
    items:
      type: object
      properties:
        CUSTOMER_ID:
          type: string
        SSN:
          type: string
  DbCommand5.out.result:
    type: array
    items:
      type: object
      properties:
        CUSTOMER_ID:
          type: string
        SSN:
          type: string
  DbCommand6.out.result:
    type: array
    items:
      type: object
      properties:
        CUSTOMER_ID:
          type: string
        SSN:
          type: string
  DbCommand2.out.result:
    type: array
    items:
      type: object
      properties:
        CUSTOMER_ID:
          type: string
  DbCommand7.out.result:
    type: array
    items:
      type: object
      properties:
        org_key:
          type: string
  DbCommand2 - MySQL.out.result:
    type: array
    items:
      type: object
      properties:
        CUSTOMER_ID:
          type: string
        SSN:
          type: string
  DbCommand3.out.result:
    type: array
    items:
      type: object
      properties:
        AM_GEN_ORG_CODE:
          type: string
  DeepCopyKeysRS1.out.value:
    type: array
    items:
      type: object
      properties:
        ACTIVITY_ID:
          type: integer
        CUSTOMER_ID:
          type: integer
