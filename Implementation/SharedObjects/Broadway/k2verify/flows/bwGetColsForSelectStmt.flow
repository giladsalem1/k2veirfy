tags: k2verify
stages:
  Stage 2:
    actors:
      ColumnMapping:
        parent: Const
        in:
          value:
            const: null
            external: column_mapping
            schema: string
        out:
          value:
            schema: string
      Tar ENV:
        parent: Equals
        in:
          a:
            const: TAR
            schema: string
          b:
            external: env
            schema: string
      Const2:
        parent: Const
        in:
          value:
            const: null
            external: delim
        out:
          value:
            schema: string
  Stage 3:
    actors:
      ColumMapNotNull:
        parent: NotEquals
        in:
          a:
            link: ColumnMapping/value
  ColumnMapping handling:
    dependsOn: Stage 3
    actors:
      And1:
        parent: And
        condition: result
        in:
          b:
            link: Tar ENV/result
          a:
            link: ColumMapNotNull/result
    split: '--------------------'
  Column names without ColumnMapping:
    else: true
    dependsOn: Stage 3
  Stage 29:
    dependsOn: ColumnMapping handling
    actors:
      Split1:
        parent: Split
        in:
          delimiter:
            const: null
            link: Const2/value
          string:
            link: ColumnMapping/value
    split: '--------------------'
  Stage 32:
    dependsOn: Column names without ColumnMapping
    actors:
      Const1:
        parent: Const
        in:
          value:
            const: null
            external: select_columns
        out:
          value:
            schema: '#ref'
  Stage 33:
    dependsOn: Stage 29
    actors:
      mapping1:
        parent: Const
        in:
          value:
            const: null
            link:
              path: Split1/strings
              iterate: Iterate
        out:
          value:
            schema: string
    split: '--------------------'
  Stage 34:
    dependsOn: Stage 32
    actors:
      MapBuild3:
        parent: MapBuild
        in:
          key:
            link:
              path: Const1/value
              iterate: Iterate
          value:
            link:
              path: Const1/value
              iterate: Iterate
        out:
          map:
            schema: '#ref'
  Stage 35:
    dependsOn: Stage 33
    actors:
      Split2:
        parent: Split
        in:
          delimiter:
            const: ':'
          string:
            link: mapping1/value
    split: '--------------------'
  Stage 36:
    dependsOn: Stage 34
  Stage 26:
    dependsOn: Stage 35
    actors:
      orgCol1:
        parent: JavaScript
        in:
          script:
            const: arr[0]
          arr:
            link: Split2/strings
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: string
      mappedCol1:
        parent: JavaScript
        in:
          script:
            const: arr[1]
          arr:
            link: Split2/strings
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: string
    split: '--------------------'
  Stage 27:
    dependsOn: Stage 36
  Stage 37:
    dependsOn: Stage 26
    actors:
      SRC Col1:
        parent: Uppercase
        in:
          string:
            link: orgCol1/result
      TAR Col Map1:
        parent: Uppercase
        in:
          string:
            link: mappedCol1/result
    split: '--------------------'
  Stage 38:
    dependsOn: Stage 27
  Stage 39:
    last: 1
    dependsOn: Stage 37
    actors:
      EqualsIgnoreCase2:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: 'true'
            schema: string
          a:
            external: colsFromPII
      MapBuild1:
        parent: MapBuild
        in:
          key:
            link: SRC Col1/string
          value:
            link: TAR Col Map1/string
        out:
          map:
            schema: '#ref'
    split: '--------------------'
  Stage 6:
    last: 1
    else: true
    dependsOn: Stage 37
    actors:
      MapBuild2:
        parent: MapBuild
        in:
          value:
            link: SRC Col1/string
          key:
            link: TAR Col Map1/string
        out:
          map:
            schema: '#ref'
    split: '--------------------'
  Stage 40:
    last: 1
    dependsOn: Stage 38
  Stage 10:
    actors:
      Const3:
        parent: Const
        in:
          value:
            const: null
            external: select_columns
        out:
          value:
            schema: '#ref'
  Stage 21:
    actors:
      JavaScript1:
        parent: JavaScript
        in:
          script:
            const: map.get(col);
          map:
            link:
            - MapBuild3/map
            - MapBuild1/map
            - MapBuild2/map
            schema: '#ref'
            mandatory: false
          col:
            link:
              path: Const3/value
              iterate: Iterate
            schema: string
            mandatory: false
        out:
          result:
            schema: string
  Stage 8:
    dependsOn: Stage 21
    actors:
      NotNull1:
        parent: NotNull
        condition: result
        in:
          value:
            link: JavaScript1/result
    split: '--------------------'
  Stage 11:
    else: true
    dependsOn: Stage 21
    actors:
      ColumnForSelect11:
        parent: Const
        in:
          value:
            const: null
            link:
              path: Const3/value
              iterate: Iterate
        out:
          value:
            schema: string
      ColumnForAlias1:
        parent: Const
        in:
          value:
            const: null
            link:
              path: Const3/value
              iterate: Iterate
        out:
          value:
            schema: string
  Stage 9:
    dependsOn: Stage 8
    actors:
      EqualsIgnoreCase1:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: 'true'
            schema: string
          a:
            external: colsFromPII
      ColumnForSelect1:
        parent: Const
        in:
          value:
            const: null
            link: JavaScript1/result
        out:
          value:
            schema: string
      ColumnForAlias:
        parent: Const
        in:
          value:
            const: null
            link:
              path: Const3/value
              iterate: Iterate
        out:
          value:
            schema: string
    split: '--------------------'
  Stage 13:
    else: true
    dependsOn: Stage 8
    actors:
      ColumnForSelect12:
        parent: Const
        in:
          value:
            const: null
            link:
              path: Const3/value
              iterate: Iterate
        out:
          value:
            schema: string
      ColumnForAlias2:
        parent: Const
        in:
          value:
            const: null
            link: JavaScript1/result
        out:
          value:
            schema: string
    split: '--------------------'
  Stage 12:
    dependsOn: Stage 11
  Stage 1: {
    }
  Stage 4:
    dependsOn: Stage 1
    actors:
      EqualsIgnoreCase3:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: DB2 (Db)
            schema: string
          a:
            external: dbtype
      check if db2:
        parent: Const
        in:
          value:
            const: null
            external: dbtype
        out:
          value:
            schema: string
      interface:
        parent: Const
        in:
          value:
            const: null
            external: interface
        out:
          value:
            schema: string
      table:
        parent: Const
        in:
          value:
            const: null
            external: table
        out:
          value:
            schema: string
      schema:
        parent: Const
        in:
          value:
            const: null
            external: schema
        out:
          value:
            schema: string
    split: '--------------------'
  Stage 5:
    else: true
    dependsOn: Stage 1
  Stage 14:
    dependsOn: Stage 4
    actors:
      RetryPhysicalError1:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      DbCommand1:
        parent: DbCommand
        in:
          interface:
            const: null
            link: interface/value
          sql:
            const: |-
              SELECT typename
              FROM syscat.columns
              WHERE tabname = '${@tablename}'
              AND tabschema = '${@schemaName}' AND colname='${@columnName}'
          tablename:
            link: table/value
            schema: string
            mandatory: false
            createdBy: sql
          schemaName:
            link: schema/value
            schema: string
            mandatory: false
            createdBy: sql
          columnName:
            link:
            - ColumnForSelect11/value
            - ColumnForSelect1/value
            - ColumnForSelect12/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  Stage 15:
    dependsOn: Stage 5
  Stage 16:
    dependsOn: Stage 14
    actors:
      LuFunction1:
        parent: LuFunction
        in:
          functionName:
            const: fnhandleComplexDBColumns
          columnName:
            link:
            - ColumnForSelect11/value
            - ColumnForSelect1/value
            - ColumnForSelect12/value
            schema: string
            mandatory: false
            createdBy: functionName
          dbType:
            link: check if db2/value
            schema: string
            mandatory: false
            createdBy: functionName
          columnType:
            link: DbCommand1/result/TYPENAME
            schema: '#ref'
            mandatory: false
            createdBy: functionName
        out:
          convertedColType:
            schema: string
    split: '--------------------'
  Stage 17:
    dependsOn: Stage 15
  Stage 7:
    actors:
      Build Columns12:
        parent: StringFormat
        in:
          format:
            const: ' ${column}  as "${env}_${map_column}"'
          column:
            link:
            - ColumnForSelect11/value
            - ColumnForSelect1/value
            - ColumnForSelect12/value
            - LuFunction1/convertedColType
            schema: string
            mandatory: false
          env:
            external: env
            schema: string
            mandatory: false
          map_column:
            link:
            - ColumnForAlias1/value
            - ColumnForAlias/value
            - ColumnForAlias2/value
            schema: string
            mandatory: false
      Const8:
        parent: Const
        in:
          value:
            const: null
            link:
            - ColumnForSelect11/value
            - ColumnForSelect1/value
            - ColumnForSelect12/value
        out:
          value:
            schema: string
  Stage 25:
    actors:
      StringBuild1:
        parent: StringBuild
        in:
          input:
            link:
              path: Build Columns12/string
              pos: 0
        out:
          string:
            external: columns_for_select
      ArrayBuilder1:
        parent: ArrayBuilder
        in:
          input:
            link:
              path: Const8/value
              pos: 0
        out:
          array:
            external: columns
            schema: '#ref'
schemas:
  Const1.out.value:
    type: array
    items:
      type: string
  MapBuild3.out.map:
    type: object
    properties:
      LAST_NAME:
        type: string
      FIRST_NAME:
        type: string
  orgCol1.in.arr:
    type: array
    items:
      type: string
  mappedCol1.in.arr:
    type: array
    items:
      type: string
  MapBuild1.out.map:
    type: object
    properties:
      LAST_NAME:
        type: string
      FIRST_NAME:
        type: string
  MapBuild2.out.map:
    type: object
    properties:
      LAST_NAME:
        type: string
      FIRST_NAME:
        type: string
  Const3.out.value:
    type: array
    items:
      type: string
  JavaScript1.in.map:
    type: object
    properties:
      LAST_NAME:
        type: string
      FIRST_NAME:
        type: string
  DbCommand1.out.result:
    type: array
    items:
      type: object
      properties:
        TYPENAME:
          type: string
  LuFunction1.in.columnType:
    type: array
    items:
      type: string
  ArrayBuilder1.out.array:
    type: array
    items:
      type: string
