                                    }
                                ],
                                "outputs": []
                            }
                        }
                    ]
                },
                {
                    "name": "Else",
                    "dependsOnList": [
                        "Set table verify globals"
                    ],
                    "hasElse": true,
                    "actors": []
                }
            ]
        },
        {
            "stages": [
                {
                    "name": "Merge 1",
                    "dependsOnList": [],
                    "actors": []
                }
            ]
        },
        {
            "stages": [
                {
                    "name": "Batch command params",
                    "dependsOnList": [
                        "Merge 1"
                    ],
                    "remark": "the batch is executed on the comparison buckets",
                    "actors": [
                        {
                            "name": "RegularMode",
                            "condition": "result",
                            "actorType": {
                                "parentType": "NotEquals",
                                "inputs": [
                                    {
                                        "name": "a",
                                        "schema": {
                                            "type": "string"
                                        }
                                    },
                                    {
                                        "name": "b",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "const": "true"
                                    }
                                ],
                                "outputs": []
                            }
                        },
                        {
                            "name": "MaxWorkers",
                            "actorType": {
                                "parentType": "NotNull",
                                "inputs": [],
                                "outputs": []
                            }
                        },
                        {
                            "name": "MaxWorkersString",
                            "actorType": {
                                "parentType": "StringFormat",
                                "inputs": [
                                    {
                                        "name": "format",
                                        "const": "MAX_WORKERS_PER_NODE=${maxWorkers}"
                                    },
                                    {
                                        "name": "maxWorkers",
                                        "schema": {},
                                        "createdBy": "format",
                                        "mandatory": false
                                    }
                                ],
                                "outputs": []
                            }
                        },
                        {
                            "name": "IfElse1",
                            "actorType": {
                                "parentType": "IfElse",
                                "inputs": [],
                                "outputs": []
                            }
                        },
                        {
                            "name": "FormatBatchSql",
                            "actorType": {
                                "parentType": "StringFormat",
                                "inputs": [
                                    {
                                        "name": "format",
                                        "const": "WITH RECURSIVE  cnt(IID) AS (SELECT 0 UNION ALL SELECT IID+1 FROM cnt LIMIT ${groupsCnt}  ) SELECT \"${table_name}_@_\"||IID as IID FROM cnt"
                                    },
                                    {
                                        "name": "groupsCnt",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "mandatory": false
                                    },
                                    {
                                        "name": "table_name",
                                        "schema": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "createdBy": "format",
                                        "mandatory": false
                                    }
                                ],
                                "outputs": []
                            }
                        }
                    ]
                },
                {
                    "name": "Retry Mode",
                    "dependsOnList": [
                        "Merge 1"
                    ],
                    "hasElse": true,
                    "actors": [
                        {
                            "name": "SelectFailedBatchID",
                            "actorType": {
                                "parentType": "DbCommand",
                                "inputs": [
                                    {
                                        "name": "interface",
                                        "const": null
                                    },
                                    {
                                        "name": "sql",
                                        "const": "SELECT DISTINCT exe_tbl.batch_id as retry_batch_id\nFROM ${k2verify_schema}.task_execution_tables   exe_tbl\nWHERE exe_tbl.task_id =  ${task_id}\n  AND exe_tbl.table_name = ${Source_Table_Name}\n  and exe_tbl.execution_id=${execution_id}\n"
                                    },
                                    {
                                        "name": "task_id",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "sql",
                                        "mandatory": false
                                    },
                                    {
                                        "name": "Source_Table_Name",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "sql",
                                        "mandatory": false
                                    },
                                    {
                                        "name": "execution_id",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "sql",
                                        "mandatory": false
                                    },
                                    {
                                        "name": "k2verify_schema",
                                        "schema": {},
                                        "createdBy": "sql",
                                        "mandatory": false
                                    }
                                ],
                                "outputs": [
                                    {
                                        "name": "result",
                                        "schema": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "retry_batch_id": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        },
