        {
            "stages": [
                {
                    "name": "Cassandra interface",
                    "dependsOnList": [
                        "Set table verify globals"
                    ],
                    "actors": [
                        {
                            "name": "CassandraInterface",
                            "condition": "result",
                            "actorType": {
                                "parentType": "EqualsIgnoreCase",
                                "inputs": [
                                    {
                                        "name": "b",
                                        "schema": {
