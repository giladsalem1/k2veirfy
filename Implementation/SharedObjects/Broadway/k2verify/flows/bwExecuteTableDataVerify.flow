        {
            "stages": [
                {
                    "name": "Comparison config",
                    "dependsOnList": [],
                    "remark": "Tables comparison custom configurations are stored in k2verify_config mtable. This actor retrieves those configurations from the mtable.",
                    "actors": [
                        {
                            "name": "ErrorHandler1",
                            "onError": "result",
                            "actorType": {
                                "parentType": "ErrorHandler",
                                "inputs": [
                                    {
                                        "name": "config",
                                        "const": [
                                            {
                                                "exceptionKey": "java.lang.Exception",
                                                "conditions": {
                                                    "message": ""
                                                },
                                                "actions": {
                                                    "suppress": false,
                                                    "log": false,
                                                    "flowName": "bwStopBWJob",
                                                    "number_of_retries": "",
                                                    "retry_interval": ""
                                                }
                                            }
                                        ]
                                    }
                                ],
                                "outputs": []
                            }
                        },
                        {
                            "name": "GetTableConfig",
                            "actorType": {
                                "parentType": "InnerFlow",
                                "inputs": [
                                    {
                                        "name": "flowName",
                                        "const": "bwGetTableParams"
                                    },
                                    {
                                        "name": "Source_Table_Name",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "flowName",
                                        "editor": {
                                            "id": "com.k2view.mTableKey"
                                        },
                                        "mandatory": false
                                    },
                                    {
                                        "name": "Source_Interface",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "flowName",
                                        "editor": {
                                            "id": "com.k2view.mTableKey"
                                        },
                                        "mandatory": false
                                    },
                                    {
                                        "name": "Source_Schema",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "flowName",
                                        "editor": {
                                            "id": "com.k2view.mTableKey"
                                        },
                                        "mandatory": false
                                    },
                                    {
                                        "name": "Target_Table_Name",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "flowName",
                                        "editor": {
                                            "id": "com.k2view.mTableKey"
                                        },
                                        "mandatory": false
                                    },
                                    {
                                        "name": "Target_Interface",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "flowName",
                                        "editor": {
                                            "id": "com.k2view.mTableKey"
                                        },
                                        "mandatory": false
                                    },
                                    {
                                        "name": "Target_Schema",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "flowName",
                                        "editor": {
                                            "id": "com.k2view.mTableKey"
                                        },
                                        "mandatory": false
                                    },
                                    {
                                        "name": "Buckets",
                                        "schema": {
                                            "type": "integer"
                                        },
                                        "createdBy": "flowName",
                                        "mandatory": false
                                    }
                                ],
                                "outputs": [
                                    {
                                        "name": "tableParams",
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "Source_Table_Name": {
                                                    "type": "string"
                                                },
                                                "Source_Interface": {
                                                    "type": "string"
                                                },
                                                "Source_Schema": {
                                                    "type": "string"
                                                },
                                                "Source_Transformation_Function_Name": {},
                                                "source_columns_to_Ignore_null": {},
                                                "Target_Table_Name": {
                                                    "type": "string"
                                                },
                                                "Target_Interface": {
                                                    "type": "string"
                                                },
                                                "Target_Schema": {
                                                    "type": "string"
                                                },
                                                "Target_Transformation_Function_Name": {},
                                                "target_columns_to_Ignore_null": {},
                                                "Customized_Key_Comparison": {
                                                    "type": "string"
                                                },
                                                "Pii_Columns": {},
                                                "Excluded_Columns_Names": {},
                                                "Active": {
                                                    "type": "string"
                                                },
                                                "Mode": {},
                                                "Excluded_Rows_Sql": {},
                                                "Column_Mapping": {},
                                                "Buckets": {
                                                    "type": "string"
                                                },
                                                "Buckets_Method": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
