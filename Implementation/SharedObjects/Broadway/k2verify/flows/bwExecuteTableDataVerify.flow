tags: k2verify
stages:
  Flow Params:
    actors:
      LUName:
        parent: GetLUName
        out:
          lu_name:
            schema: string
      Now:
        parent: Now
      START_TIME:
        parent: ToString
        in:
          value:
            link: Now/date
      FabricSetRead1:
        parent: FabricSetRead
        in:
          key:
            const: PARTITION_SIZE
      K2VERIFY_INTERFACE:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_OPERATIONAL_INTERFACE
          luName:
            link: LUName/lu_name
      K2VERIFY_SCHEMA:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_OPERATIONAL_SCHEMA
          luName:
            link: LUName/lu_name
  Comparison config:
    remark: Tables comparison custom configurations are stored in k2verify_config
      mtable. This actor retrieves those configurations from the mtable.
    actors:
      StopJob:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: false
                flowName: bwStopBWJob
                number_of_retries: ''
                retry_interval: ''
      GetTableConfig:
        parent: InnerFlow
        in:
          flowName:
            const: bwGetTableParams
          Source_Table_Name:
            external: Source_Table_Name
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Source_Interface:
            external: Source_Interface
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Source_Schema:
            external: Source_Schema
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Target_Table_Name:
            external: Target_Table_Name
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Target_Interface:
            external: Target_Interface
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Target_Schema:
            external: Target_Schema
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Buckets:
            external: Buckets
            schema: integer
            mandatory: false
            createdBy: flowName
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          tableParams:
            schema: '#ref'
  Get Default Bucket Count:
    actors:
      ResolveDefBucketCount:
        parent: InnerFlow
        in:
          flowName:
            const: bwResolveBucketCount
          partition_size:
            link: FabricSetRead1/result
            schema: string
            mandatory: false
            createdBy: flowName
          Source_Interface:
            external: Source_Interface
            schema: string
            editor:
              interfaceType:
              - database
              - CassandraLoader
              interfaces:
              - fabric
              id: com.k2view.interface
            mandatory: false
            createdBy: flowName
          Source_Schema:
            external: Source_Schema
            schema: string
            mandatory: false
            createdBy: flowName
          Source_Table:
            external: Source_Table_Name
            schema: string
            mandatory: false
            createdBy: flowName
          db_type:
            external: interfaceType
            schema: string
            mandatory: false
            createdBy: flowName
          bucket_count:
            external: Buckets
            schema: string
            mandatory: false
            createdBy: flowName
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: flowName
          Target_Table_Name:
            link: GetTableConfig/tableParams/Target_Table_Name
            schema: string
            mandatory: false
            createdBy: flowName
          Target_Schema:
            link: GetTableConfig/tableParams/Target_Schema
            schema: string
            mandatory: false
        out:
          bucket_count:
            schema: integer
  Update table verify started:
    actors:
      StartedTableVerify:
        parent: DbLoad
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          command:
            const: upsert
          schema:
            const: null
            link: K2VERIFY_SCHEMA/variableValue
          table:
            const: task_execution_tables
          fields:
            const:
            - task_id
            - execution_id
            - table_name
            - status
            - start_time
            - bucket_count
          keys:
            const:
            - task_id
            - execution_id
            - table_name
          dialect:
            const: postgres
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: table
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: table
          table_name:
            external: Source_Table_Name
            schema: string
            mandatory: false
            createdBy: table
          status:
            const: In_Progress
            schema: string
            mandatory: false
            createdBy: table
          start_time:
            link: START_TIME/string
            schema: string
            mandatory: false
            createdBy: table
          bucket_count:
            link: ResolveDefBucketCount/bucket_count
            schema: string
            mandatory: false
            createdBy: fields
  Set table verify globals:
    actors:
      SYNC Force:
        parent: FabricSet
        in:
          key:
            const: sync
          value:
            const: force
      SRC Interface:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_INTERFACE_SRC=?;
          params:
            link:
              path: GetTableConfig/tableParams/Source_Interface
              pos: 0
      SRC Schema:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_SCHEMA_SRC=?;
          params:
            link:
              path: GetTableConfig/tableParams/Source_Schema
              pos: 0
      SRC Table:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_TABLE_SRC=?;
          params:
            link:
              path: GetTableConfig/tableParams/Source_Table_Name
              pos: 0
      TAR Interface:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_INTERFACE_TAR=?;
          params:
            link:
              path: GetTableConfig/tableParams/Target_Interface
              pos: 0
      TAR Schema:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_SCHEMA_TAR=?;
          params:
            link:
              path: GetTableConfig/tableParams/Target_Schema
              pos: 0
      TAR Table:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_TABLE_TAR=?;
          params:
            link:
              path: GetTableConfig/tableParams/Target_Table_Name
              pos: 0
      SRC Interface Type:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_INTERFACE_SRC_TYPE=${interfaceType}
          interfaceType:
            external: interfaceType
            schema: string
            mandatory: false
            createdBy: sql
      TASK ID:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_TASK_ID='${@task_id}'
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
      EXECUTION ID:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_EXEC_ID='${@execution_id}'
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: sql
      LOG PASS:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_LOG_PASS='${@log_pass}'
          log_pass:
            external: log_pass
            schema: string
            mandatory: false
            createdBy: sql
      COMPARE ONLY PII:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_COMPARE_ONLY_PII='${@compare_only_pii}'
          compare_only_pii:
            external: compare_only_pii
            schema: string
            mandatory: false
            createdBy: sql
      BUCKETS NUM:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_TABLE_BUCKETS_NUM=?
          params:
            link:
              path: ResolveDefBucketCount/bucket_count
              pos: 0
      SOURCE ENV:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_SOURCE_ENV='${@source_environment}'
          source_environment:
            external: source_environment
            schema: string
            mandatory: false
            createdBy: sql
      TARGET ENV:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_TARGET_ENV='${@target_environment}'
          target_environment:
            external: target_environment
            schema: string
            mandatory: false
            createdBy: sql
      SOURCE ENV IS PII:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_SRC_CONTAINS_SENSITIVE_DATA='${@source_environment_is_pii}'
          source_environment_is_pii:
            external: source_environment_is_pii
            schema: string
            mandatory: false
            createdBy: sql
      TARGET ENV IS PII:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_TAR_CONTAINS_SENSITIVE_DATA='${@target_environment_is_pii}'
          target_environment_is_pii:
            external: target_environment_is_pii
            schema: string
            mandatory: false
            createdBy: sql
  Cassandra interface:
    dependsOn: Set table verify globals
    actors:
      CassandraInterface:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: Cassandra (Db)
            schema: string
          a:
            external: interfaceType
      ExtractKeysFromCassTable:
        parent: InnerFlow
        in:
          flowName:
            const: bwExtractKeyFromCassTable
          schema:
            link: LUName/lu_name
            schema: string
            mandatory: false
            createdBy: flowName
          customized_key:
            link: GetTableConfig/tableParams/Customized_Key_Comparison
            schema: string
            mandatory: false
            createdBy: flowName
          buckets_count:
            link: ResolveDefBucketCount/bucket_count
            schema: integer
            mandatory: false
            createdBy: flowName
    split: '--------------------'
  Else:
    else: true
    dependsOn: Set table verify globals
  Merge 1: {
    }
  Batch command params:
    remark: the batch is executed on the comparison buckets
    dependsOn: Merge 1
    actors:
      RegularMode:
        parent: NotEquals
        condition: result
        in:
          a:
            external: IsRetryMode
            schema: string
          b:
            const: 'true'
            schema: string
      MaxWorkers:
        parent: NotNull
        in:
          value:
            external: maxWorkers
      MaxWorkersString:
        parent: StringFormat
        in:
          format:
            const: MAX_WORKERS_PER_NODE=${maxWorkers}
          maxWorkers:
            external: maxWorkers
            schema: any
            mandatory: false
            createdBy: format
      IfElse1:
        parent: IfElse
        in:
          test:
            link: MaxWorkers/result
          a:
            link: MaxWorkersString/string
      FormatBatchSql:
        parent: StringFormat
        in:
          format:
            const: WITH RECURSIVE  cnt(IID) AS (SELECT 0 UNION ALL SELECT IID+1 FROM
              cnt LIMIT ${groupsCnt}  ) SELECT "${table_name}_@_"||IID as IID FROM
              cnt
          groupsCnt:
            link: ResolveDefBucketCount/bucket_count
            schema: string
            mandatory: false
          table_name:
            link: GetTableConfig/tableParams/Source_Table_Name
            schema: '#ref'
            mandatory: false
            createdBy: format
    split: '--------------------'
  Retry Mode:
    else: true
    dependsOn: Merge 1
    actors:
      SelectFailedBatchID:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: |
              SELECT DISTINCT exe_tbl.batch_id as retry_batch_id
              FROM ${@k2verify_schema}.task_execution_tables   exe_tbl
              WHERE exe_tbl.task_id =  ${@task_id}
                AND LOWER(exe_tbl.table_name) = LOWER('${@Source_Table_Name}')
                and exe_tbl.execution_id=${@execution_id}
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          Source_Table_Name:
            external: Source_Table_Name
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: sql
          k2verify_schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Batch command:
    dependsOn: Batch command params
    actors:
      BatchCommand:
        parent: StringFormat
        in:
          format:
            const: BATCH ${lut} from fabric using('${sql}') FABRIC_COMMAND="sync_instance
              ${lut}.?" with async='true' ${maxWorkers};
          lut:
            const: verify
            schema: string
            mandatory: false
          maxWorkers:
            link: IfElse1/result
            schema: string
            mandatory: false
          sql:
            link: FormatBatchSql/string
            schema: string
            mandatory: false
    split: '--------------------'
  Batch Retry comand params:
    dependsOn: Retry Mode
    actors:
      batch_retry Command:
        parent: StringFormat
        in:
          format:
            const: batch_retry '${retry_batch_id}'
          retry_batch_id:
            link:
              path: SelectFailedBatchID/result/retry_batch_id
              iterate: First
            schema: '#ref'
            mandatory: false
            createdBy: format
      RetryBatchID:
        parent: Const
        in:
          value:
            const: null
            link:
              path: SelectFailedBatchID/result/retry_batch_id
              iterate: First
        out:
          value:
            schema: string
  Execute buckets bacth:
    dependsOn: Batch command
    actors:
      ExecuteBatch:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: null
            link:
            - BatchCommand/string
            - batch_retry Command/string
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  Execute Batch Retry:
    dependsOn: Batch Retry comand params
    actors:
      ExecuteBatchRetry:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: null
            link: batch_retry Command/string
        out:
          result:
            schema: '#ref'
  Table verify in progress:
    actors:
      VerifyInProgress:
        parent: DbLoad
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          command:
            const: update
          schema:
            const: null
            link: K2VERIFY_SCHEMA/variableValue
          table:
            const: task_execution_tables
          fields:
            const:
            - task_id
            - execution_id
            - table_name
            - batch_id
            - status
            - start_time
          keys:
            const:
            - task_id
            - execution_id
            - table_name
          dialect:
            const: postgres
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: table
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: table
          table_name:
            external: Source_Table_Name
            schema: string
            mandatory: false
            createdBy: table
          batch_id:
            link:
            - RetryBatchID/value
            - path: ExecuteBatch/result/Batch id
              iterate: First
            schema: string
            mandatory: false
            createdBy: table
          status:
            const: In_Progress
            schema: string
            mandatory: false
            createdBy: table
          start_time:
            link: START_TIME/string
            schema: string
            mandatory: false
            createdBy: table
  Wait for the batch to finish:
    actors:
      ErrorFields1:
        parent: ErrorFields
        error: message
        out:
          inputs:
            schema: '#ref'
      BatchWait1:
        parent: BatchWait
        in:
          batchId:
            link:
            - RetryBatchID/value
            - path: ExecuteBatch/result/Batch id
              iterate: First
  Table verify end_time:
    actors:
      TableVerifyEndTime:
        parent: Now
      TableVerifyEndTimeStr:
        parent: ToString
        in:
          value:
            link: TableVerifyEndTime/date
  Batch succeeded:
    dependsOn: Table verify end_time
    actors:
      BatchSuccess:
        parent: IsNull
        condition: result
        in:
          value:
            link: ErrorFields1/error
    split: '--------------------'
  Batch was cancelled:
    else: true
    dependsOn: Table verify end_time
    actors:
      IsCancelled:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: Batch was cancelled
            schema: string
          a:
            link: ErrorFields1/error
      VerifyCancelled:
        parent: DbLoad
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          command:
            const: update
          schema:
            const: null
            link: K2VERIFY_SCHEMA/variableValue
          table:
            const: task_execution_tables
          fields:
            const:
            - task_id
            - execution_id
            - table_name
            - batch_id
            - status
            - start_time
            - end_time
          keys:
            const:
            - task_id
            - execution_id
            - table_name
          dialect:
            const: postgres
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: table
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: table
          table_name:
            external: Source_Table_Name
            schema: string
            mandatory: false
            createdBy: table
          batch_id:
            link:
            - RetryBatchID/value
            - path: ExecuteBatch/result/Batch id
              iterate: First
            schema: string
            mandatory: false
            createdBy: table
          status:
            const: Stopped
            schema: string
            mandatory: false
            createdBy: table
          start_time:
            link: START_TIME/string
            schema: string
            mandatory: false
            createdBy: table
          end_time:
            link: TableVerifyEndTimeStr/string
            schema: string
            mandatory: false
            createdBy: table
    split: '--------------------'
  Batch failed:
    else: true
    dependsOn: Table verify end_time
    actors:
      VerifyFailed:
        parent: DbLoad
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          command:
            const: update
          schema:
            const: null
            link: K2VERIFY_SCHEMA/variableValue
          table:
            const: task_execution_tables
          fields:
            const:
            - task_id
            - execution_id
            - table_name
            - batch_id
            - status
            - start_time
            - end_time
          keys:
            const:
            - task_id
            - execution_id
            - table_name
          dialect:
            const: postgres
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: table
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: table
          table_name:
            external: Source_Table_Name
            schema: string
            mandatory: false
            createdBy: table
          batch_id:
            link:
            - RetryBatchID/value
            - path: ExecuteBatch/result/Batch id
              iterate: First
            schema: string
            mandatory: false
            createdBy: table
          status:
            const: Failed
            schema: string
            mandatory: false
            createdBy: table
          start_time:
            link: START_TIME/string
            schema: string
            mandatory: false
            createdBy: table
          end_time:
            link: TableVerifyEndTimeStr/string
            schema: string
            mandatory: false
            createdBy: table
  dummy:
    dependsOn: Batch succeeded
    split: '--------------------'
  Stage 16:
    dependsOn: Batch was cancelled
    split: '--------------------'
  Stage 20:
    dependsOn: Batch failed
  Buckets failed:
    dependsOn: dummy
    actors:
      BucketsFailed > 0:
        parent: GreaterThan
        condition: result
        in:
          b:
            const: 0
          a:
            link: BatchWait1/failed
      Failed:
        parent: Const
        in:
          value:
            const: Failed
            schema: string
        out:
          value:
            schema: string
    split: '--------------------'
  Stage 12:
    else: true
    dependsOn: dummy
    actors:
      Completed:
        parent: Const
        in:
          value:
            const: Completed
            schema: string
        out:
          value:
            schema: string
    split: '--------------------'
  Stage 17:
    dependsOn: Stage 16
    split: '--------------------'
  Stage 21:
    dependsOn: Stage 20
  Table verify completed:
    dependsOn:
    - Stage 12
    - Buckets failed
    actors:
      VerifyCompleted:
        parent: DbLoad
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          command:
            const: update
          schema:
            const: null
            link: K2VERIFY_SCHEMA/variableValue
          table:
            const: task_execution_tables
          fields:
            const:
            - task_id
            - execution_id
            - table_name
            - batch_id
            - status
            - start_time
            - end_time
          keys:
            const:
            - task_id
            - execution_id
            - table_name
          dialect:
            const: postgres
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: table
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: table
          table_name:
            external: Source_Table_Name
            schema: string
            mandatory: false
            createdBy: table
          batch_id:
            link:
            - RetryBatchID/value
            - path: ExecuteBatch/result/Batch id
              iterate: First
            schema: string
            mandatory: false
            createdBy: table
          status:
            link:
            - Failed/value
            - Completed/value
            schema: string
            mandatory: false
            createdBy: table
          start_time:
            link: START_TIME/string
            schema: string
            mandatory: false
            createdBy: table
          end_time:
            link: TableVerifyEndTimeStr/string
            schema: string
            mandatory: false
            createdBy: table
    split: '--------------------'
  Stage 19:
    dependsOn: Stage 17
    split: '--------------------'
  Stage 22:
    dependsOn: Stage 21
schemas:
  GetTableConfig.out.tableParams:
    type: object
    properties:
      Source_Table_Name:
        type: string
      Source_Interface:
        type: string
      Source_Schema:
        type: string
      Source_Transformation_Function_Name: {
        }
      source_columns_to_Ignore_null: {
        }
      Target_Table_Name:
        type: string
      Target_Interface:
        type: string
      Target_Schema:
        type: string
      Target_Transformation_Function_Name: {
        }
      target_columns_to_Ignore_null: {
        }
      Customized_Key_Comparison:
        type: string
      Pii_Columns: {
        }
      Excluded_Columns_Names: {
        }
      Active:
        type: string
      Mode: {
        }
      Excluded_Rows_Sql: {
        }
      Column_Mapping: {
        }
      Buckets:
        type: string
      Buckets_Method:
        type: string
  FormatBatchSql.in.table_name:
    type: array
    items:
      type: string
  SelectFailedBatchID.out.result:
    type: array
    items:
      type: object
      properties:
        retry_batch_id:
          type: string
  batch_retry Command.in.retry_batch_id:
    type: object
    properties:
      retry_batch_id:
        type: string
  ExecuteBatch.out.result:
    type: array
    items:
      type: object
      properties:
        Batch id:
          type: string
        Execution id:
          type: string
        Notes:
          type: string
  ExecuteBatchRetry.out.result:
    type: array
    items:
      type: object
      properties:
        Batch id:
          type: string
