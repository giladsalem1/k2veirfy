tags: k2verify
stages:
  Stage 17:
    actors:
      ls1:
        parent: ls
        in:
          interface:
            const: null
            external: srcInterface
          pattern:
            const: null
            external: pattern
          directories:
            const: true
        out:
          result:
            schema: '#ref'
      SEPERATOR:
        parent: GetLUVariable
        in:
          luName:
            const: verify
          variableName:
            const: K2VERIFY_CONF_SEPARATOR
  Stage 18:
    actors:
      File:
        parent: Const
        in:
          value:
            const: null
            link:
              path: ls1/result/name
              iterate: Iterate
        out:
          value:
            schema: string
      Count1:
        parent: Count
        out:
          value:
            external: numOfBuckets
            schema: integer
  Stage 19:
    actors:
      FileName:
        parent: Replace
        in:
          search:
            const: .csv
          string:
            link: File/value
  Stage 4:
    actors:
      StringFormat3:
        parent: StringFormat
        in:
          format:
            const: ${fileName}
          fileName:
            link: FileName/string
            schema: string
            mandatory: false
            createdBy: format
      StringFormat1:
        parent: StringFormat
        in:
          format:
            const: '''${fileName}'''
          fileName:
            link: FileName/string
            schema: string
            mandatory: false
            createdBy: format
      bwGetTableParams1:
        parent: InnerFlow
        in:
          flowName:
            const: bwGetTableParams
          Source_Interface:
            external: srcInterface
            schema: string
            mandatory: false
            createdBy: flowName
          Source_Schema:
            external: srcSchema
            schema: string
            mandatory: false
            createdBy: flowName
          Source_Table_Name:
            external: pattern
            schema: string
            mandatory: false
            createdBy: flowName
          Target_Interface:
            external: tarInterface
            schema: string
            mandatory: false
            createdBy: flowName
          Target_Schema:
            external: tarSchema
            schema: string
            mandatory: false
            createdBy: flowName
          Target_Table_Name:
            external: pattern
            schema: string
            mandatory: false
            createdBy: flowName
          Buckets:
            schema: integer
            mandatory: false
            createdBy: flowName
        out:
          tableParams:
            schema: '#ref'
  Stage 2:
    transactional: true
    actors:
      DUMMY GET:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_CSV_MODE_DUMMY_GET='true';
      StringBuild1:
        parent: StringBuild
        in:
          input:
            link:
              path: StringFormat1/string
              pos: 0
        out:
          string:
            external: bucketIDs
  Stage 3:
    transactional: true
    actors:
      FabricGet1:
        parent: FabricGet
        in:
          luType:
            const: verify
          iid:
            const: null
            link:
              path: StringFormat3/string
              pos: 0
            default: false
          syncMode:
            const: 'ON'
  Stage 16:
    last: 1
    transactional: true
    actors:
      bwLoadSrcFilesToTable:
        parent: InnerFlow
        in:
          flowName:
            const: bwLoadFileToLUITable
          interface:
            external: srcInterface
            schema: string
            editor:
              interfaceType:
              - LOCAL
              - SFTP
              - filesystem
              interfaces:
              - file://
              id: com.k2view.interface
            mandatory: false
            createdBy: flowName
          delim:
            link: SEPERATOR/variableValue
            schema: string
            mandatory: false
            createdBy: flowName
          env:
            const: src
            schema: string
            mandatory: false
            createdBy: flowName
          customized_key:
            link: bwGetTableParams1/tableParams/Customized_Key_Comparison
            schema: string
            mandatory: false
            createdBy: flowName
          fileName:
            link: File/value
            schema: string
            mandatory: false
            createdBy: flowName
      bwLoadTarFilesToTable1:
        parent: InnerFlow
        in:
          flowName:
            const: bwLoadFileToLUITable
          delim:
            link: SEPERATOR/variableValue
            schema: string
            mandatory: false
            createdBy: flowName
          env:
            const: tar
            schema: string
            mandatory: false
            createdBy: flowName
          customized_key:
            link: bwGetTableParams1/tableParams/Customized_Key_Comparison
            schema: string
            mandatory: false
            createdBy: flowName
          interface:
            external: tarInterface
            schema: string
            editor:
              interfaceType:
              - LOCAL
              - SFTP
              - filesystem
              interfaces:
              - file://
              id: com.k2view.interface
            mandatory: false
            createdBy: flowName
          fileName:
            link: File/value
            schema: string
            mandatory: false
            createdBy: flowName
  Stage 5:
    transactional: true
    actors:
      SRC Table111:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_CSV_MODE_DUMMY_GET='false';
schemas:
  ls1.out.result:
    type: array
    items:
      type: object
      properties:
        name:
          type: string
        size:
          type: integer
        createTime:
          type: integer
        lastModifiedTime:
          type: integer
        lastAccessTime:
          type: integer
        directory:
          type: boolean
        fullPath:
          type: string
  bwGetTableParams1.out.tableParams:
    type: object
    properties:
      Active:
        type: boolean
      Buckets: {
        }
      Column_Mapping: {
        }
      Customized_Key_Comparison:
        type: string
      Excluded_Columns_Names: {
        }
      Buckets_Method:
        type: string
      Pii_Columns:
        type: string
      Excluded_Rows_Sql: {
        }
      source_columns_to_Ignore_null: {
        }
      Source_Interface:
        type: string
      Source_Schema:
        type: string
      Source_Table_Name:
        type: string
      Source_Transformation_Function_Name: {
        }
      target_columns_to_Ignore_null: {
        }
      Target_Interface:
        type: string
      Target_Schema:
        type: string
      Target_Table_Name:
        type: string
      Target_Transformation_Function_Name: {
        }
