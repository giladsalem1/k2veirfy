tags: k2verify
stages:
  Set source environment:
    actors:
      SetSourceEnv:
        parent: FabricSet
        in:
          key:
            const: environment
          value:
            const: null
            external: source_env
            default: false
  Stage 8:
    actors:
      BucketsCount:
        parent: JavaScript
        in:
          script:
            const: |-
              if(buckets_count == 0) 1;
              else buckets_count;
          buckets_count:
            external: buckets_count
            schema: string
            mandatory: false
        out:
          result:
            schema: string
  ls files:
    actors:
      ls:
        parent: ls
        in:
          interface:
            const: null
            external: srcInterface
          pattern:
            const: null
            external: pattern
        out:
          result:
            schema: '#ref'
  Stage 6:
    actors:
      Const1:
        parent: Const
        in:
          value:
            const: null
            link: ls/result/name
        out:
          value:
            schema: '#ref'
  Stage 1:
    transactional: true
    actors:
      InnerFlowAsync2:
        parent: InnerFlowAsync
        in:
          flowName:
            const: bwLoadFilesToBucketsWrapper
          value:
            link:
              path: Const1/value
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: flowName
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: flowName
          customized_key:
            external: customized_key
            schema: string
            mandatory: false
            createdBy: flowName
          source_env:
            external: source_env
            schema: string
            mandatory: false
            createdBy: flowName
          srcInterface:
            external: srcInterface
            schema: string
            editor:
              interfaceType:
              - LOCAL
              - SFTP
              - filesystem
              interfaces:
              - file://
              id: com.k2view.interface
            mandatory: false
            createdBy: flowName
          buckets_count:
            link: BucketsCount/result
            schema: string
            mandatory: false
            createdBy: flowName
          target_env:
            external: target_env
            schema: string
            mandatory: false
            createdBy: flowName
          tarInterface:
            external: tarInterface
            schema: string
            editor:
              interfaceType:
              - LOCAL
              - SFTP
              - filesystem
              interfaces:
              - file://
              id: com.k2view.interface
            mandatory: false
            createdBy: flowName
        out:
          results:
            schema: '#ref'
  Stage 4:
    last: 1
    transactional: true
    actors:
      LoadFilesToBucketsMapper1:
        parent: Mapper
        disabled: true
        in:
          flowName:
            const: bwLoadFilesToBucketsWrapper
          threadCount:
            const: 3
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: flowName
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: flowName
          customized_key:
            external: customized_key
            schema: string
            mandatory: false
            createdBy: flowName
          source_env:
            external: source_env
            schema: string
            mandatory: false
            createdBy: flowName
          srcInterface:
            external: srcInterface
            schema: string
            editor:
              interfaceType:
              - LOCAL
              - SFTP
              - filesystem
              interfaces:
              - file://
              id: com.k2view.interface
            mandatory: false
            createdBy: flowName
          buckets_count:
            external: buckets_count
            schema: string
            mandatory: false
            createdBy: flowName
          target_env:
            external: target_env
            schema: string
            mandatory: false
            createdBy: flowName
          tarInterface:
            external: tarInterface
            schema: string
            editor:
              interfaceType:
              - LOCAL
              - SFTP
              - filesystem
              interfaces:
              - file://
              id: com.k2view.interface
            mandatory: false
            createdBy: flowName
        out:
          values:
            schema: '#ref'
      InnerFlowJoin1:
        parent: InnerFlowJoin
        in:
          remaining:
            link: InnerFlowAsync2/remaining
  Stage 7:
    transactional: false
    actors:
      Const2:
        parent: Const
        in:
          value:
            const: null
            link: Const1/value
        out:
          value:
            schema: '#ref'
  Stage 3:
    transactional: false
    actors:
      ForLoop:
        parent: ForLoop
        in:
          to:
            link: BucketsCount/result
      FileName:
        parent: Replace
        in:
          search:
            const: .csv
          string:
            link:
              path: Const2/value
              iterate: Iterate
  Stage 2:
    last: 1
    transactional: false
    actors:
      FormatrPartitionName:
        parent: StringFormat
        in:
          format:
            const: ${fileName}_@_${count}
          fileName:
            link: FileName/string
            schema: string
            mandatory: false
            createdBy: format
          count:
            link:
              path: ForLoop/i
              iterate: Iterate
            schema: integer
            mandatory: false
            createdBy: format
      FormatEntityList:
        parent: StringFormat
        in:
          format:
            const: '''${iid}'''
          iid:
            link: FormatrPartitionName/string
            schema: string
            mandatory: false
            createdBy: format
      BuildEntityList:
        parent: StringBuild
        in:
          input:
            link:
              path: FormatEntityList/string
              pos: 0
        out:
          string:
            external: entityList
      ArrayBuilder1:
        parent: ArrayBuilder
        in:
          input:
            link:
              path: FormatrPartitionName/string
              pos: 0
        out:
          array:
            external: entities
  Stage 5:
    last: 1
    transactional: false
schemas:
  ls.out.result:
    type: array
    items:
      type: object
      properties:
        name:
          type: string
        size:
          type: integer
        createTime:
          type: integer
        lastModifiedTime:
          type: integer
        lastAccessTime:
          type: integer
        directory:
          type: boolean
        fullPath:
          type: string
  Const1.out.value:
    type: array
    items:
      type: string
  InnerFlowAsync2.out.results:
    type: array
    items:
      type: object
      properties:
        values:
          type: string
  LoadFilesToBucketsMapper1.out.values:
    type: array
    items:
      type: string
  Const2.out.value:
    type: array
    items:
      type: string
