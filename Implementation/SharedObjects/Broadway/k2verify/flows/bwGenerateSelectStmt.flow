tags: k2verify
stages:
  Stage 1:
    actors:
      Interface:
        parent: Const
        in:
          value:
            const: null
            external: interface
        out:
          value:
            schema: string
      Schema:
        parent: Const
        in:
          value:
            const: null
            external: schema
        out:
          value:
            schema: string
      Table:
        parent: Const
        in:
          value:
            const: null
            external: table
        out:
          value:
            schema: string
      ENV:
        parent: Const
        in:
          value:
            const: null
            external: env_prefix
        out:
          value:
            schema: string
      Excluded Columns:
        parent: Const
        in:
          value:
            const: null
            external: excludedColumnsNames
        out:
          value:
            schema: string
      Keys:
        parent: Const
        in:
          value:
            const: null
            external: customizedKeyComparison
        out:
          value:
            schema: string
      Delimiter:
        parent: Const
        in:
          value:
            const: null
            external: delimiter
        out:
          value:
            schema: string
      ColumnMapping:
        parent: Const
        in:
          value:
            const: null
            external: ColumnMapping
            schema: string
        out:
          value:
            schema: string
      Pii Cols:
        parent: Const
        in:
          value:
            const: null
            external: pii_columns
        out:
          value:
            schema: string
      Exclude Condition:
        parent: Const
        in:
          value:
            const: null
            external: excludeCondition
        out:
          value:
            schema: string
      environment:
        parent: Const
        in:
          value:
            const: null
            external: environment
        out:
          value:
            schema: string
      dbtype:
        parent: Const
        in:
          value:
            const: null
            external: interfaceType
        out:
          value:
            schema: string
  Stage 2:
    actors:
      UppercaseExcluded:
        parent: Uppercase
        in:
          string:
            link: Excluded Columns/value
      Replace1:
        parent: Replace
        in:
          search:
            const: null
            link: Delimiter/value
          replace:
            const: ','
          string:
            link:
            - ENV/value
            - Keys/value
      Exclude Clause:
        parent: StringFormat
        in:
          format:
            const: ' where ${where} '
          where:
            link: Exclude Condition/value
            schema: string
            mandatory: false
      SET ENVIRONMENT:
        parent: FabricSet
        in:
          key:
            const: ENVIRONMENT
          value:
            link: environment/value
  Stage 15:
    actors:
      Split Excluded:
        parent: Split
        in:
          delimiter:
            const: null
            link: Delimiter/value
          string:
            link: UppercaseExcluded/string
  Stage 8:
    dependsOn: Stage 15
    actors:
      Equals1:
        parent: Equals
        condition: result
        in:
          b:
            const: SRC
            schema: string
          a:
            link: ENV/value
      Const3:
        parent: Const
        in:
          value:
            const: null
            link: Split Excluded/strings
        out:
          value:
            schema: '#ref'
    split: '--------------------'
  Stage 14:
    else: true
    dependsOn: Stage 15
    actors:
      MappedCols:
        parent: InnerFlow
        in:
          flowName:
            const: bwGetColsForSelectStmt
          env:
            const: TAR
            schema: string
            mandatory: false
            createdBy: flowName
          column_mapping:
            link: ColumnMapping/value
            schema: string
            mandatory: false
            createdBy: flowName
          delim:
            link: Delimiter/value
            schema: string
            mandatory: false
            createdBy: flowName
          select_columns:
            link: Split Excluded/strings
            schema: string
            mandatory: false
            createdBy: flowName
          colsFromPII:
            const: 'true'
            schema: string
            mandatory: false
            createdBy: flowName
          dbtype:
            link: dbtype/value
            schema: any
            mandatory: false
            createdBy: flowName
          interface:
            link: Interface/value
            schema: any
            mandatory: false
            createdBy: flowName
          table:
            link: Table/value
            schema: any
            mandatory: false
            createdBy: flowName
          schema:
            link: Schema/value
            schema: any
            mandatory: false
            createdBy: flowName
        out:
          columns_for_select:
            schema: string
          columns:
            schema: '#ref'
  Stage 13:
    actors:
      IfElse1:
        parent: IfElse
        in:
          test:
            link: Exclude Condition/value
          a:
            link: Exclude Clause/string
        out:
          result:
            schema: string
      FabricSetRead1:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_COMPARE_ONLY_PII
  Stage 9:
    transactional: false
    dependsOn: Stage 13
    actors:
      EqualsIgnoreCase1:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: 'true'
            schema: string
          a:
            link: FabricSetRead1/result
      Split Pii:
        parent: Split
        in:
          delimiter:
            const: null
            link: Delimiter/value
          string:
            link: Pii Cols/value
      Split Keys:
        parent: Split
        in:
          delimiter:
            const: null
            link: Delimiter/value
          string:
            link: Keys/value
    split: '--------------------'
  Stage 10:
    else: true
    transactional: false
    dependsOn: Stage 13
    actors:
      EqualsIgnoreCase2:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: fabric
            schema: string
          a:
            link: Interface/value
      ErrorHandler2:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: false
                log: false
                flowName: ''
                number_of_retries: '3'
                retry_interval: '1000'
      DbFetchFirstRow1:
        parent: DbFetchFirstRow
        in:
          interface:
            const: fabric
          sql:
            const: select * from ${@schema}.${@table} limit 1
          schema:
            link: Schema/value
            schema: string
            mandatory: false
            createdBy: sql
          table:
            link: Table/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  non-IMS/Vsam DBs:
    else: true
    transactional: false
    dependsOn: Stage 13
    actors:
      NotEquals1:
        parent: NotEquals
        condition: result
        in:
          b:
            const: vsam (Db)
            schema: string
          a:
            external: interfaceType
    split: '--------------------'
  IMS/Vsam DB:
    else: true
    transactional: false
    dependsOn: Stage 13
    actors:
      LuFunction1:
        parent: LuFunction
        disabled: true
        in:
          functionName:
            const: fnFetchColumnsFromIMS
          schema:
            link: Schema/value
            schema: string
            mandatory: false
            createdBy: functionName
          table:
            link: Table/value
            schema: string
            mandatory: false
            createdBy: functionName
          interface_name:
            link: Interface/value
            schema: any
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: '#ref'
  Stage 6:
    transactional: false
    dependsOn: Stage 9
    actors:
      ArrayConcat1:
        parent: ArrayConcat
        in:
          input:
            link:
            - path: Split Pii/strings
              pos: 0
            - path: Split Keys/strings
              pos: 1
        out:
          array:
            schema: '#ref'
    split: '--------------------'
  Stage 11:
    dependsOn: Stage 10
    actors:
      JavaScript2:
        parent: JavaScript
        in:
          script:
            const: object.keySet();
          object:
            link: DbFetchFirstRow1/result
            schema: any
            mandatory: false
    split: '--------------------'
  Stage 18:
    dependsOn: non-IMS/Vsam DBs
    actors:
      Get Columns from Source:
        parent: LuFunction
        in:
          functionName:
            const: fnFetchColumns
          iface:
            link: Interface/value
            schema: string
            mandatory: false
            createdBy: functionName
          schema:
            link: Schema/value
            schema: string
            mandatory: false
            createdBy: functionName
          table:
            link: Table/value
            schema: string
            mandatory: false
            createdBy: functionName
          environment:
            external: environment
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  Stage 21:
    dependsOn: IMS/Vsam DB
  Stage 4:
    dependsOn: Stage 6
    actors:
      Mapper1:
        parent: Mapper
        in:
          script:
            const: value.toUpperCase()
          values:
            link: ArrayConcat1/array
        out:
          values:
            schema: '#ref'
      Const1:
        parent: Const
        in:
          value:
            const: 'true'
            schema: string
        out:
          value:
            schema: string
    split: '--------------------'
  Stage 12:
    dependsOn: Stage 11
    actors:
      Mapper3:
        parent: Mapper
        in:
          script:
            const: value.toUpperCase()
          values:
            link: JavaScript2/result
        out:
          values:
            schema: '#ref'
    split: '--------------------'
  Stage 19:
    dependsOn: Stage 18
    actors:
      Const2:
        parent: Const
        in:
          value:
            const: 'false'
            schema: string
        out:
          value:
            schema: string
    split: '--------------------'
  Stage 22:
    dependsOn: Stage 21
  Stage 5:
    actors:
      Filter Columns:
        parent: Filter
        in:
          script:
            const: excludeList.indexOf(value) === -1
          excludeList:
            link:
            - Const3/value
            - MappedCols/columns
            schema: '#ref'
            mandatory: false
          values:
            link:
            - LuFunction1/result
            - Get Columns from Source/result
            - Mapper1/values
            - Mapper3/values
        out:
          values:
            schema: '#ref'
  Stage 17:
    actors:
      DeepCopy1:
        parent: DeepCopy
        in:
          value:
            link: Filter Columns/values
        out:
          value:
            schema: '#ref'
  Stage 3:
    actors:
      bwGetColsForSelectStmt1:
        parent: InnerFlow
        in:
          flowName:
            const: bwGetColsForSelectStmt
          env:
            link: ENV/value
            schema: string
            mandatory: false
            createdBy: flowName
          select_columns:
            link: DeepCopy1/value
            schema: '#ref'
            mandatory: false
            createdBy: flowName
          column_mapping:
            link: ColumnMapping/value
            schema: string
            mandatory: false
            createdBy: flowName
          delim:
            link: Delimiter/value
            schema: string
            mandatory: false
            createdBy: flowName
          colsFromPII:
            link:
            - Const1/value
            - Const2/value
            schema: string
            mandatory: false
            createdBy: flowName
          dbtype:
            link: dbtype/value
            schema: any
            mandatory: false
            createdBy: flowName
          interface:
            link: Interface/value
            schema: any
            mandatory: false
            createdBy: flowName
          table:
            link: Table/value
            schema: any
            mandatory: false
            createdBy: flowName
          schema:
            link: Schema/value
            schema: any
            mandatory: false
            createdBy: flowName
        out:
          columns_for_select:
            schema: string
          columns:
            external: columns
            schema: '#ref'
  Stage 7:
    actors:
      Query:
        parent: StringFormat
        in:
          format:
            const: select ${columns} from ${schema}.${table} ${and}
          columns:
            link: bwGetColsForSelectStmt1/columns_for_select
            schema: string
            mandatory: false
          and:
            schema: string
            mandatory: false
          table:
            link: Table/value
            schema: string
            mandatory: false
          schema:
            external: schema
            schema: string
            mandatory: false
        out:
          string:
            external: sql
schemas:
  Const3.out.value:
    type: array
    items:
      type: string
  MappedCols.out.columns:
    type: array
    items:
      type: string
  DbFetchFirstRow1.out.result:
    type: object
    properties:
      CUSTOMER_ID:
        type: string
      SSN:
        type: string
      FIRST_NAME:
        type: string
      LAST_NAME:
        type: string
  LuFunction1.out.result:
    type: array
    items:
      type: string
  ArrayConcat1.out.array:
    type: array
    items:
      type: string
  Get Columns from Source.out.result:
    type: array
    items:
      type: string
  Mapper1.out.values:
    type: array
    items:
      type: string
  Mapper3.out.values:
    type: array
    items:
      type: string
  Filter Columns.in.excludeList:
    type: array
    items:
      type: string
  Filter Columns.out.values:
    type: array
    items:
      type: string
  DeepCopy1.out.value:
    type: array
    items:
      type: string
  bwGetColsForSelectStmt1.in.select_columns:
    type: array
    items:
      type: string
  bwGetColsForSelectStmt1.out.columns:
    type: array
    items:
      type: string
