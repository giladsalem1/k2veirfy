tags: k2verify
stages:
  Normalize Inputs:
    actors:
      ToNumber1:
        parent: ToNumber
        in:
          value:
            external: bucket_count
      DefaultPartitionSize:
        parent: Const
        in:
          value:
            const: 1000000
            schema: integer
        out:
          value:
            schema: integer
      HasPartitionSize:
        parent: NotNull
        in:
          value:
            external: partition_size
      PartitionSizeOrDefault:
        parent: IfElse
        in:
          b:
            link: DefaultPartitionSize/value
          test:
            link: HasPartitionSize/result
          a:
            external: partition_size
        out:
          result:
            schema: integer
      OperationalInterface:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_OPERATIONAL_INTERFACE
      OperationalSchema:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_OPERATIONAL_SCHEMA
      Const1:
        parent: Const
        in:
          value:
            const: null
            external: db_type
        out:
          value:
            schema: string
      Now:
        parent: Now
      Updated_At:
        parent: ToString
        in:
          value:
            link: Now/date
      source schema:
        parent: Const
        in:
          value:
            const: null
            external: Source_Schema
        out:
          value:
            schema: string
      Source_Table:
        parent: Const
        in:
          value:
            const: null
            external: Source_Table
        out:
          value:
            schema: string
      target schema:
        parent: Const
        in:
          value:
            const: null
            external: Target_Schema
        out:
          value:
            schema: string
      target table:
        parent: Const
        in:
          value:
            const: null
            external: Target_Table_Name
        out:
          value:
            schema: string
      'task id ':
        parent: Const
        in:
          value:
            const: null
            external: task_id
        out:
          value:
            schema: string
      source schema and table:
        parent: Concat
        in:
          delimiter:
            const: .
          elements:
            link:
            - path: source schema/value
              pos: 0
            - path: Source_Table/value
              pos: 1
      taget table and schema:
        parent: Concat
        in:
          delimiter:
            const: .
          elements:
            link:
            - path: target schema/value
              pos: 0
            - path: target table/value
              pos: 1
  Cache:
    dependsOn: Normalize Inputs
    actors:
      IsManualBucketsProvided:
        parent: GreaterThan
        condition: result
        in:
          b:
            const: 0
          a:
            link: ToNumber1/number
      ReturnManualBucketCount:
        parent: Const
        in:
          value:
            const: null
            link: ToNumber1/number
            schema: integer
        out:
          value:
            external: bucket_count
            schema: integer
    split: '--------------------'
  Stage 1:
    else: true
    dependsOn: Normalize Inputs
    actors:
      BuildEstRowsSql:
        parent: JavaScript
        in:
          script:
            const: |
              var t = (db_type || "").toUpperCase();
              var sql = null;

              if (t.indexOf("POSTGRES") >= 0 || t.indexOf("CASSANDRA") >= 0) {
                sql =
                  "SELECT COALESCE(c.reltuples::bigint, 0) AS \"APPROX_ROWS\" " +
                  "FROM pg_class c " +
                  "JOIN pg_namespace n ON n.oid = c.relnamespace " +
                  "WHERE n.nspname = ? AND c.relname = ?" ;
              }
              else if (t.indexOf("ORACLE") >= 0) {
                sql =
                  "SELECT COALESCE(num_rows, 0) AS \"APPROX_ROWS\" " +
                  "FROM all_tables " +
                  "WHERE owner = ? AND table_name = ?";
              }
              else if (t.indexOf("DB2") >= 0) {
                sql =
                  "SELECT COALESCE(card, 0) AS \"APPROX_ROWS\" " +
                  "FROM syscat.tables " +
                  "WHERE tabschema = ? AND tabname = ?";
              }
              else if (t.indexOf("CASSANDRA") >= 0) {
                sql =
                  "SELECT  SUM(partitions_count) AS \"APPROX_ROWS\" FROM system.size_estimates WHERE keyspace_name = ? AND table_name = ?";
              }
              else if (t.indexOf("MYSQL") >= 0) {
                sql =
                  "SELECT TABLE_ROWS AS \"APPROX_ROWS\" FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = ? AND TABLE_NAME = ?";
              }
              sql;
          db_type:
            link: Const1/value
            schema: string
            mandatory: false
          Source_Schema:
            external: Source_Schema
            schema: string
            mandatory: false
          Source_Table:
            external: Source_Table
            schema: string
            mandatory: false
        out:
          result:
            schema: string
      BuildParams:
        parent: JavaScript
        in:
          script:
            const: '[ Source_Schema, Source_Table ];'
          Source_Schema:
            external: Source_Schema
            schema: string
            mandatory: false
          Source_Table:
            external: Source_Table
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  Lookup bucket_count:
    dependsOn: Cache
    split: '--------------------'
  Stage 2:
    dependsOn: Stage 1
    actors:
      SuppressCatalogEstimateErrors:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: true
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      DbFetchField1:
        parent: DbFetchField
        in:
          interface:
            const: null
            external: Source_Interface
          sql:
            const: null
            link: BuildEstRowsSql/result
          params:
            link: BuildParams/result
        out:
          result:
            schema: integer
  Detect Source DB Type:
    dependsOn: Lookup bucket_count
    split: '--------------------'
  Stage 4:
    dependsOn: Stage 2
    actors:
      NotNull1:
        parent: NotNull
        condition: result
        in:
          value:
            link: DbFetchField1/result
      CalcBucketCount:
        parent: JavaScript
        in:
          script:
            const: |
              var rows = est_rows;
              var ps = partition_size;

              if (rows === null || rows === undefined) rows = 0;
              if (ps === null || ps === undefined || ps <= 0) ps = 1000000;

              rows = Math.floor(Number(rows));
              ps = Math.floor(Number(ps));

              var bc = Math.ceil(rows / ps);
              if (!isFinite(bc) || bc < 1) bc = 1;

              bc;
          est_rows:
            link: DbFetchField1/result
            schema: integer
            mandatory: false
          partition_size:
            link: PartitionSizeOrDefault/result
            schema: integer
            mandatory: false
        out:
          result:
            schema: integer
    split: '--------------------'
  Stage 6:
    else: true
    dependsOn: Stage 2
    actors:
      SuppressUpsertErrors:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: true
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      CountRows:
        parent: InnerFlow
        in:
          flowName:
            const: bwCountRowsTimed
          interfaceName:
            external: Source_Interface
            schema: string
            mandatory: false
            createdBy: flowName
          schemaName:
            external: Source_Schema
            schema: string
            mandatory: false
            createdBy: flowName
          tableName:
            external: Source_Table
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          row_count:
            schema: integer
  Cassandra – Extract Keys +Count:
    dependsOn: Detect Source DB Type
    split: '--------------------'
  Stage 5:
    dependsOn: Stage 4
    split: '--------------------'
  Stage 7:
    dependsOn: Stage 6
    actors:
      HasCountResult:
        parent: NotNull
        condition: result
        in:
          value:
            link: CountRows/row_count
      CalcBucketCount1:
        parent: JavaScript
        in:
          script:
            const: |
              var rows = rows_count;
              var ps = partition_size;

              if (rows === null || rows === undefined) rows = 0;
              if (ps === null || ps === undefined || ps <= 0) ps = 1000000;

              rows = Math.floor(Number(rows));
              ps = Math.floor(Number(ps));

              var bc = Math.ceil(rows / ps);
              if (!isFinite(bc) || bc < 1) bc = 1;

              bc;
          rows_count:
            link: CountRows/row_count
            schema: integer
            mandatory: false
          partition_size:
            link: PartitionSizeOrDefault/result
            schema: integer
            mandatory: false
        out:
          result:
            external: bucket_count
            schema: integer
    split: '--------------------'
  Stage 8:
    else: true
    dependsOn: Stage 6
    actors:
      Const2:
        parent: Const
        in:
          value:
            const: 1
            schema: integer
        out:
          value:
            external: bucket_count
            schema: integer
  Stage 3:
    dependsOn: Cassandra – Extract Keys +Count
    split: '--------------------'
  Stage 10:
    dependsOn:
    - Stage 7
    - Stage 8
    - Stage 5
    actors:
      ReturnBucketCountFromEstRows:
        parent: Const
        in:
          value:
            const: null
            link: CalcBucketCount/result
        out:
          value:
            external: bucket_count
            schema: integer
      UpsertCacheRow:
        parent: DbLoad
        in:
          interface:
            const: K2VERIFY_OPERATIONAL_DB
            link: OperationalInterface/variableValue
            default: true
          command:
            const: upsert
          schema:
            const: null
            link: OperationalSchema/variableValue
          table:
            const: k2verify_table_count
          fields:
            const:
            - source_interface
            - source_schema
            - source_table
            - db_type
            - est_rows
            - bucket_count
            - updated_at
          keys:
            const:
            - source_interface
            - source_schema
            - source_table
          dialect:
            const: postgres
          source_interface:
            external: Source_Interface
            schema: string
            mandatory: false
            createdBy: schema
          source_schema:
            external: Source_Schema
            schema: string
            mandatory: false
            createdBy: schema
          source_table:
            external: Source_Table
            schema: string
            mandatory: false
            createdBy: schema
          db_type:
            link: Const1/value
            schema: string
            mandatory: false
            createdBy: schema
          est_rows:
            link: DbFetchField1/result
            schema: integer
            mandatory: false
            createdBy: schema
          bucket_count:
            link:
            - CalcBucketCount/result
            - CalcBucketCount1/result
            schema: integer
            mandatory: false
            createdBy: schema
          updated_at:
            link: Updated_At/string
            schema: string
            mandatory: false
            createdBy: schema
      MapCreate2:
        parent: MapCreate
        in:
          src:
            link: source schema and table/string
            schema: string
            mandatory: false
          tar:
            link: taget table and schema/string
            schema: string
            mandatory: false
          buckets:
            link:
            - CalcBucketCount/result
            - CalcBucketCount1/result
            schema: string
            mandatory: false
        out:
          map:
            schema: '#ref'
      ArrayBuilder1:
        parent: ArrayBuilder
        in:
          input:
            link: MapCreate2/map
        out:
          array:
            schema: '#ref'
      ToString1:
        parent: ToString
        in:
          value:
            link: ArrayBuilder1/array
      DbLoad1:
        parent: DbLoad
        in:
          interface:
            const: K2VERIFY_OPERATIONAL_DB
            link: OperationalInterface/variableValue
            default: true
          command:
            const: update
          schema:
            const: null
            link: OperationalSchema/variableValue
          table:
            const: task_table_properties
          fields:
            const:
            - task_id
            - source_table_name
            - target_table_name
            - table_properties
          keys:
            const:
            - task_id
            - source_table_name
            - target_table_name
          dialect:
            const: postgres
          task_id:
            link: task id /value
            schema: string
            mandatory: false
            createdBy: table
          source_table_name:
            link: source schema and table/string
            schema: string
            mandatory: false
            createdBy: table
          target_table_name:
            link: taget table and schema/string
            schema: string
            mandatory: false
            createdBy: table
          table_properties:
            link: ToString1/string
            schema: '#ref'
            mandatory: false
            createdBy: table
schemas:
  BuildParams.out.result:
    type: array
    items:
      type: string
  MapCreate2.out.map:
    type: object
    properties:
      src:
        type: string
      tar:
        type: string
      buckets:
        type: string
  ArrayBuilder1.out.array:
    type: array
    items:
      type: object
      properties:
        src:
          type: string
        tar:
          type: string
        buckets:
          type: string
  DbLoad1.in.table_properties:
    type: object
    properties:
      src:
        type: string
      tar:
        type: string
      buckets:
        type: string
