tags: k2verify
stages:
  Normalize Inputs:
    actors:
      DefaultPartitionSize:
        parent: Const
        in:
          value:
            const: 1000000
            schema: integer
        out:
          value:
            schema: integer
      HasPartitionSize:
        parent: NotNull
        in:
          value:
            external: partition_size
      PartitionSizeOrDefault:
        parent: IfElse
        in:
          b:
            link: DefaultPartitionSize/value
          test:
            link: HasPartitionSize/result
          a:
            external: partition_size
        out:
          result:
            schema: integer
      ParseBucketsConfig:
        parent: JavaScript
        in:
          script:
            const: |
              var s = buckets_config;

              if (s && s.length) s = s[0];

              var n = parseInt(("" + s).trim(), 10);
              if (isNaN(n) || n <= 0) n = 0;

              n;
          buckets_config:
            external: buckets_config
            schema: integer
            mandatory: false
        out:
          result:
            schema: integer
      LUName:
        parent: GetLUName
        out:
          lu_name:
            schema: string
      OperationalInterface:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_OPERATIONAL_INTERFACE
      OperationalSchema:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_OPERATIONAL_SCHEMA
  Manual Buckets:
    dependsOn: Normalize Inputs
    actors:
      IsManualBucketsProvided:
        parent: GreaterThan
        condition: result
        in:
          b:
            const: 0
          a:
            link: ParseBucketsConfig/result
      ReturnManualBucketCount:
        parent: Const
        in:
          value:
            const: null
            link: ParseBucketsConfig/result
            schema: integer
        out:
          value:
            external: bucket_count
            schema: integer
    split: '--------------------'
  Cache:
    else: true
    dependsOn: Normalize Inputs
    actors:
      SuppressCacheLookupErrors:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      BuildCacheLookupParams:
        parent: JavaScript
        in:
          script:
            const: '[Source_Interface, Source_Schema, Source_Table];'
          Source_Interface:
            external: Source_Interface
            schema: string
            mandatory: false
          Source_Schema:
            external: Source_Schema
            schema: string
            mandatory: false
          Source_Table:
            external: Source_Table
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  Stage 17:
    dependsOn: Manual Buckets
    split: '--------------------'
  Lookup bucket_count:
    dependsOn: Cache
    actors:
      FetchCachedBucketCountRow:
        parent: DbFetchFirstRow
        in:
          interface:
            const: null
            link: OperationalInterface/variableValue
          sql:
            const: |-
              SELECT (
              SELECT bucket_count
              FROM k2verify.k2verify_table_count
              WHERE source_interface = ?
                AND source_schema = ?
                AND source_table = ?
              ) AS bucket_count;
          params:
            link: BuildCacheLookupParams/result
        out:
          result:
            schema: '#ref'
  Stage 22:
    dependsOn: Stage 17
    split: '--------------------'
  Detect Source DB Type:
    else: false
    dependsOn: Lookup bucket_count
    actors:
      HasCachedBucketCount:
        parent: NotNull
        condition: result
        in:
          value:
            link: FetchCachedBucketCountRow/result/bucket_count
      ReturnLookUpBucketCount:
        parent: Const
        in:
          value:
            const: null
            link: FetchCachedBucketCountRow/result/bucket_count
        out:
          value:
            external: bucket_count
            schema: '#ref'
    split: '--------------------'
  Stage 2:
    else: true
    dependsOn: Lookup bucket_count
    actors:
      Const1:
        parent: Const
        in:
          value:
            const: null
            external: db_type
        out:
          value:
            schema: string
  Stage 24:
    dependsOn: Stage 22
    split: '--------------------'
  Cassandra – Extract Keys +Count:
    dependsOn: Detect Source DB Type
    split: '--------------------'
  Stage 4:
    dependsOn: Stage 2
    actors:
      BuildParams:
        parent: JavaScript
        in:
          script:
            const: '[ Source_Schema, Source_Table ];'
          Source_Schema:
            external: Source_Schema
            schema: string
            mandatory: false
          Source_Table:
            external: Source_Table
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
      BuildEstRowsSql:
        parent: JavaScript
        in:
          script:
            const: |
              var t = (db_type || "").toUpperCase();
              var sql = null;

              if (t.indexOf("POSTGRES") >= 0 || t.indexOf("CASSANDRA") >= 0) {
                sql =
                  "SELECT COALESCE(c.reltuples::bigint, 0) AS \"APPROX_ROWS\" " +
                  "FROM pg_class c " +
                  "JOIN pg_namespace n ON n.oid = c.relnamespace " +
                  "WHERE n.nspname = ? AND c.relname = ?" ;
              }
              else if (t.indexOf("ORACLE") >= 0) {
                sql =
                  "SELECT COALESCE(num_rows, 0) AS \"APPROX_ROWS\" " +
                  "FROM all_tables " +
                  "WHERE owner = 'aa' AND table_name = 'aa'";
              }
              else if (t.indexOf("DB2") >= 0) {
                sql =
                  "SELECT COALESCE(card, 0) AS \"APPROX_ROWS\" " +
                  "FROM syscat.tables " +
                  "WHERE tabschema = ? AND tabname = ?";
              }
              else if (t.indexOf("CASSANDRA") >= 0) {
                sql =
                  "SELECT  SUM(partitions_count) AS \"APPROX_ROWS\" FROM system.size_estimates WHERE keyspace_name = ? AND table_name = ?";
              }
              else if (t.indexOf("MYSQL") >= 0) {
                sql =
                  "SELECT TABLE_ROWS AS \"APPROX_ROWS\" FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = ? AND TABLE_NAME = ?";
              }
              sql;
          db_type:
            link: Const1/value
            schema: string
            mandatory: false
          Source_Schema:
            external: Source_Schema
            schema: string
            mandatory: false
          Source_Table:
            external: Source_Table
            schema: string
            mandatory: false
        out:
          result:
            schema: string
  Stage 1:
    dependsOn: Stage 24
    split: '--------------------'
  Stage 3:
    dependsOn: Cassandra – Extract Keys +Count
    split: '--------------------'
  Stage 6:
    dependsOn: Stage 4
    actors:
      SuppressCatalogEstimateErrors:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: true
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      DbFetchField1:
        parent: DbFetchField
        disabled: true
        in:
          interface:
            const: null
            external: Source_Interface
          sql:
            const: null
            link: BuildEstRowsSql/result
          params:
            link: BuildParams/result
        out:
          result:
            schema: integer
  Fetch Est Rows:
    dependsOn: Stage 1
    split: '--------------------'
  Default bucket_count:
    else: false
    dependsOn: Stage 3
    split: '--------------------'
  Stage 7:
    dependsOn: Stage 6
    actors:
      NotNull1:
        parent: NotNull
        condition: result
        in:
          value:
            link: DbFetchField1/result
      CalcBucketCount:
        parent: JavaScript
        in:
          script:
            const: |
              var rows = est_rows;
              var ps = partition_size;

              if (rows === null || rows === undefined) rows = 0;
              if (ps === null || ps === undefined || ps <= 0) ps = 1000000;

              rows = Math.floor(Number(rows));
              ps = Math.floor(Number(ps));

              var bc = Math.ceil(rows / ps);
              if (!isFinite(bc) || bc < 1) bc = 1;

              bc;
          est_rows:
            link: DbFetchField1/result
            schema: integer
            mandatory: false
          partition_size:
            link: PartitionSizeOrDefault/result
            schema: integer
            mandatory: false
        out:
          result:
            schema: integer
    split: '--------------------'
  Stage 23:
    else: true
    dependsOn: Stage 6
    actors:
      SuppressUpsertErrors:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: true
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      CountRows:
        parent: InnerFlow
        in:
          flowName:
            const: bwCountRowsTimed
          interfaceName:
            external: Source_Interface
            schema: string
            mandatory: false
            createdBy: flowName
          schemaName:
            external: Source_Schema
            schema: string
            mandatory: false
            createdBy: flowName
          tableName:
            external: Source_Table
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          row_count:
            schema: integer
  Stage 5:
    dependsOn: Fetch Est Rows
    split: '--------------------'
  Calculate bucket_count:
    dependsOn: Default bucket_count
    split: '--------------------'
  Stage 9:
    dependsOn: Stage 7
    actors:
      Now:
        parent: Now
      Updated_At:
        parent: ToString
        in:
          value:
            link: Now/date
    split: '--------------------'
  Stage 25:
    dependsOn: Stage 23
    actors:
      HasCountResult:
        parent: NotNull
        condition: result
        in:
          value:
            link: CountRows/row_count
      CalcBucketCount1:
        parent: JavaScript
        in:
          script:
            const: |
              var rows = rows_count;
              var ps = partition_size;

              if (rows === null || rows === undefined) rows = 0;
              if (ps === null || ps === undefined || ps <= 0) ps = 1000000;

              rows = Math.floor(Number(rows));
              ps = Math.floor(Number(ps));

              var bc = Math.ceil(rows / ps);
              if (!isFinite(bc) || bc < 1) bc = 1;

              bc;
          rows_count:
            link: CountRows/row_count
            schema: integer
            mandatory: false
          partition_size:
            link: PartitionSizeOrDefault/result
            schema: integer
            mandatory: false
        out:
          result:
            external: bucket_count
            schema: integer
    split: '--------------------'
  Stage 34:
    else: true
    dependsOn: Stage 23
    actors:
      Const2:
        parent: Const
        in:
          value:
            const: 1
            schema: integer
        out:
          value:
            external: bucket_count
            schema: integer
  Stage 13:
    dependsOn: Stage 5
    split: '--------------------'
  Upsert Cache Row:
    dependsOn: Calculate bucket_count
    split: '--------------------'
  Stage 12:
    dependsOn: Stage 9
    actors:
      UpsertCacheRow:
        parent: DbLoad
        in:
          interface:
            const: K2VERIFY_OPERATIONAL_DB
            link: OperationalInterface/variableValue
            default: true
          command:
            const: upsert
          schema:
            const: null
            link: OperationalSchema/variableValue
          table:
            const: k2verify_table_count
          fields:
            const:
            - source_interface
            - source_schema
            - source_table
            - db_type
            - est_rows
            - bucket_count
            - updated_at
          keys:
            const:
            - source_interface
            - source_schema
            - source_table
          dialect:
            const: postgres
          source_interface:
            external: Source_Interface
            schema: string
            mandatory: false
            createdBy: schema
          source_schema:
            external: Source_Schema
            schema: string
            mandatory: false
            createdBy: schema
          source_table:
            external: Source_Table
            schema: string
            mandatory: false
            createdBy: schema
          db_type:
            link: Const1/value
            schema: string
            mandatory: false
            createdBy: schema
          est_rows:
            link: DbFetchField1/result
            schema: integer
            mandatory: false
            createdBy: schema
          bucket_count:
            link: CalcBucketCount/result
            schema: integer
            mandatory: false
            createdBy: schema
          updated_at:
            link: Updated_At/string
            schema: string
            mandatory: false
            createdBy: schema
    split: '--------------------'
  Stage 26:
    dependsOn: Stage 25
    actors:
      Now1:
        parent: Now
      Updated_At1:
        parent: ToString
        in:
          value:
            link: Now1/date
    split: '--------------------'
  Stage 36:
    dependsOn: Stage 34
  Stage 16:
    dependsOn: Stage 13
    split: '--------------------'
  Stage 29:
    dependsOn: Upsert Cache Row
    split: '--------------------'
  Stage 14:
    dependsOn: Stage 12
    actors:
      ReturnBucketCountFromEstRows:
        parent: Const
        in:
          value:
            const: null
            link: CalcBucketCount/result
        out:
          value:
            external: bucket_count
            schema: integer
    split: '--------------------'
  Stage 27:
    dependsOn: Stage 26
    actors:
      UpsertCacheRow1:
        parent: DbLoad
        in:
          interface:
            const: K2VERIFY_OPERATIONAL_DB
            link: OperationalInterface/variableValue
            default: true
          command:
            const: upsert
          schema:
            const: null
            link: OperationalSchema/variableValue
          table:
            const: k2verify_table_count
          fields:
            const:
            - source_interface
            - source_schema
            - source_table
            - db_type
            - est_rows
            - bucket_count
            - updated_at
          keys:
            const:
            - source_interface
            - source_schema
            - source_table
          dialect:
            const: postgres
          source_interface:
            external: Source_Interface
            schema: string
            mandatory: false
            createdBy: schema
          source_schema:
            external: Source_Schema
            schema: string
            mandatory: false
            createdBy: schema
          source_table:
            external: Source_Table
            schema: string
            mandatory: false
            createdBy: schema
          db_type:
            link: Const1/value
            schema: string
            mandatory: false
            createdBy: schema
          est_rows:
            link: CountRows/row_count
            schema: integer
            mandatory: false
            createdBy: schema
          bucket_count:
            link: CalcBucketCount1/result
            schema: integer
            mandatory: false
            createdBy: schema
          updated_at:
            link: Updated_At1/string
            schema: string
            mandatory: false
            createdBy: schema
    split: '--------------------'
  Stage 37:
    dependsOn: Stage 36
schemas:
  BuildCacheLookupParams.out.result:
    type: array
    items:
      type: string
  FetchCachedBucketCountRow.out.result:
    type: object
    properties:
      bucket_count: {
        }
  ReturnLookUpBucketCount.out.value:
    type: object
    properties: {
      }
  BuildParams.out.result:
    type: array
    items:
      type: string
