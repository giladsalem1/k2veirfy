schemas:
  BuildCacheLookupParams.out.result:
    type: array
    items:
      type: string
  DbFetchFirstRow1.out.result:
    type: object
    properties:
      bucket_count:
        type: integer
  ReturnLookUpBucketCount.out.value:
    type: object
    properties: {
      }
  BuildParams.out.result:
    type: array
    items:
      type: string
  DbFetchFirstRow2.out.result:
    type: object
    properties:
      coalesce:
        type: integer
  BuildParams11.out.result:
    type: array
    items:
      type: string
  ErrorFields1.out.inputs:
    type: object
    properties:
      flowName:
        type: string
      innerFlowClose:
        type: boolean
      Source_Schema:
        type: string
      Source_Table:
        type: string
      Source_Interface:
        type: string
  BuildParams1.out.result:
    type: array
    items:
      type: string
