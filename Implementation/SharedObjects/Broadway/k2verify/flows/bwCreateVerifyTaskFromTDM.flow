        type: string
  Get Task Interfaces.out.result:
    type: array
    items:
      type: object
      properties:
        interface_name:
          type: string
  Get Task Tables.out.result:
    type: array
    items:
      type: object
      properties:
        task_ref_table_id:
          type: integer
        task_id:
          type: integer
        ref_table_name:
          type: string
        lu_name:
          type: string
        schema_name:
          type: string
        interface_name:
