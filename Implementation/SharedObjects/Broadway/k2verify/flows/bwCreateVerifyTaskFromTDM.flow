      delete_before_load:
        type: boolean
      replace_sequences:
        type: boolean
      scheduler:
        type: string
      task_created_by:
        type: string
      task_creation_date:
        type: date
      task_last_updated_date:
        type: date
      task_last_updated_by:
        type: string
      source_env_name:
        type: string
      source_environment_id:
        type: integer
      load_entity:
        type: boolean
      task_type:
        type: string
      version_ind:
        type: boolean
      retention_period_type:
        type: string
      retention_period_value:
        type: integer
      selected_version_task_exe_id:
        type: integer
