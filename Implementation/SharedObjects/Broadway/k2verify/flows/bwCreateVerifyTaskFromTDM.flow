        type: boolean
      task_description:
        type: string
      clone_ind:
        type: boolean
      execution_mode:
        type: string
      enable_execution:
        type: boolean
  TDM Task details.out.result:
    type: object
    properties:
      task_id:
        type: integer
      task_title:
        type: string
      task_status:
        type: string
      task_execution_status:
        type: string
      num_of_entities:
        type: integer
      environment_id:
        type: integer
