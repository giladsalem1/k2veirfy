        }
      K2VERIFY_TAR_CONTAINS_SENSITIVE_DATA: {
        }
      K2VERIFY_TABLE_LIST: {
        }
      K2VERIFY_MAXWORKERSPERNODE: {
        }
      K2VERIFY_LOGPASS: {
        }
      K2VERIFY_PII_ONLY_COMPARISON: {
        }
  Create Verify Task.in.task_params:
    type: array
    items:
      type: blob
