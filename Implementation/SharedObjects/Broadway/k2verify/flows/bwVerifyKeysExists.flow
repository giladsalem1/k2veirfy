tags: d2d,d2dv2,D2D,k2verify
stages:
  Check record emoty:
    transactional: true
    actors:
      SrcRecord=[{}]:
        parent: Equals
        in:
          b:
            const: {
              }
            schema: '#ref'
          a:
            external: src_row
      IsNull1:
        parent: IsNull
        in:
          value:
            external: src_row
      TarRecord=[{}]:
        parent: Equals
        in:
          b:
            const: {
              }
            schema: '#ref'
          a:
            external: tar_row
      IsNull2:
        parent: IsNull
        in:
          value:
            external: tar_row
  Src record doesn't exist:
    transactional: true
    dependsOn: Check record emoty
    actors:
      SrcEmpty:
        parent: Or
        condition: result
        in:
          b:
            link: SrcRecord=[{}]/result
          a:
            link: IsNull1/result
      ReportDetailsMap1:
        parent: MapCreate
        in:
          EXECUTION_ID:
            external: execution_id
            schema: string
            mandatory: false
          CUSTOMIZED_KEY:
            external: customized_key
            schema: string
            mandatory: false
          TARGET_COLUMN_VALUE:
            external: target_column_value
            schema: '#ref'
            mandatory: false
          MATCH_RESULT:
            const: Target Key Not Found In Source
            schema: string
            mandatory: false
          SOURCE_TABLE_NAME:
            external: source_table_name
            schema: string
            mandatory: false
          TARGET_TABLE_NAME:
            external: target_table_name
            schema: string
            mandatory: false
          COLUMN_NAME:
            external: key_columns
            schema: string
            mandatory: false
          IID:
            const: '0'
            schema: string
            mandatory: false
        out:
          map:
            schema: '#ref'
      Const2:
        parent: Const
        in:
          value:
            const: Target Key Not Found In Source
            schema: string
        out:
          value:
            schema: string
    split: '--------------------'
  Tar record doesn't exist:
    transactional: true
    dependsOn: Check record emoty
    actors:
      TAREmpty:
        parent: Or
        condition: result
        in:
          b:
            link: TarRecord=[{}]/result
          a:
            link: IsNull2/result
      ReportDetailsMap11:
        parent: MapCreate
        in:
          EXECUTION_ID:
            external: execution_id
            schema: string
            mandatory: false
          CUSTOMIZED_KEY:
            external: customized_key
            schema: string
            mandatory: false
          TARGET_COLUMN_VALUE:
            external: target_column_value
            schema: '#ref'
            mandatory: false
          MATCH_RESULT:
            const: Source Key Not Found In Target
            schema: string
            mandatory: false
          SOURCE_TABLE_NAME:
            external: source_table_name
            schema: string
            mandatory: false
          TARGET_TABLE_NAME:
            external: target_table_name
            schema: string
            mandatory: false
          COLUMN_NAME:
            external: key_columns
            schema: string
            mandatory: false
          IID:
            const: '0'
            schema: string
            mandatory: false
        out:
          map:
            schema: '#ref'
      Const3:
        parent: Const
        in:
          value:
            const: Source Key Not Found In Target
            schema: string
        out:
          value:
            schema: string
    split: '--------------------'
  Stage 2:
    else: true
    transactional: true
    dependsOn: Check record emoty
  Src/Tar Empty:
    transactional: true
    actors:
      Or1:
        parent: Or
        in:
          a:
            link: SrcEmpty/result
          b:
            link: TAREmpty/result
        out:
          result:
            external: keyNotFound
  Report key is missing:
    transactional: true
    actors:
      =true:
        parent: Equals
        condition: result
        in:
          b:
            const: true
            schema: boolean
          a:
            link: Or1/result
      Const6:
        parent: Const
        in:
          value:
            const: null
            external: columns
        out:
          value:
            schema: string
  Stage 6:
    transactional: true
    actors:
      ReportDetailsMap12:
        parent: MapCreate
        in:
          EXECUTION_ID:
            external: execution_id
            schema: string
            mandatory: false
          CUSTOMIZED_KEY:
            external: customized_key
            schema: string
            mandatory: false
          TARGET_COLUMN_VALUE:
            schema: '#ref'
            mandatory: false
          MATCH_RESULT:
            link:
            - Const2/value
            - Const3/value
            schema: string
            mandatory: false
          SOURCE_TABLE_NAME:
            external: source_table_name
            schema: string
            mandatory: false
          TARGET_TABLE_NAME:
            external: target_table_name
            schema: string
            mandatory: false
          COLUMN_NAME:
            link:
              path: Const6/value
              iterate: Iterate
            schema: string
            mandatory: false
          IID:
            const: '0'
            schema: string
            mandatory: false
        out:
          map:
            schema: '#ref'
  Stage 5:
    last: 1
    transactional: true
    actors:
      ArrayBuilder2:
        parent: ArrayBuilder
        in:
          input:
            link:
              path: ReportDetailsMap12/map
              pos: 0
        out:
          array:
            schema: '#ref'
  Stage 8:
    transactional: true
    actors:
      Const1:
        parent: Const
        in:
          value:
            const: null
            link: ArrayBuilder2/array
            schema: '#ref'
        out:
          value:
            schema: '#ref'
      Result Files Dir:
        parent: FabricSetRead
        in:
          key:
            const: verify.K2VERIFY_RESULT_FILES_PATH
  Stage 7:
    transactional: true
    actors:
      CsvBuilder1:
        parent: CsvBuilder
        in:
          header:
            const: false
          columns:
            const:
            - EXECUTION_ID
            - IID
            - SOURCE_TABLE_NAME
            - TARGET_TABLE_NAME
            - CUSTOMIZED_KEY
            - COLUMN_NAME
            - MATCH_RESULT
            - TARGET_VALUE_SECURED
            - SOURCE_COLUMN_VALUE
            - TARGET_COLUMN_VALUE
          maps:
            link: Const1/value
      Format File Name:
        parent: StringFormat
        in:
          format:
            const: ${dir}/verify_fields_results_${source_table_name}_${execution_id}_${bucket_id}.csv
          bucket_id:
            external: bucket_id
            schema: string
            mandatory: false
            createdBy: format
          dir:
            link: Result Files Dir/result
            schema: any
            mandatory: false
            createdBy: format
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: format
          source_table_name:
            external: source_table_name
            schema: any
            mandatory: false
            createdBy: format
  Write to file:
    transactional: true
    actors:
      FileWrite1:
        parent: FileWrite
        in:
          interface:
            const: file://
          append:
            const: true
          stream:
            link: CsvBuilder1/csv
          path:
            link: Format File Name/string
schemas:
  SrcRecord=[{}].in.b:
    type: array
    items: {
      }
  TarRecord=[{}].in.b:
    type: array
    items: {
      }
  ReportDetailsMap1.in.TARGET_COLUMN_VALUE:
    type: array
    items: {
      }
  ReportDetailsMap1.out.map:
    type: object
    properties:
      EXECUTION_ID:
        type: string
      CUSTOMIZED_KEY: {
        }
      TARGET_COLUMN_VALUE:
        type: string
      MATCH_RESULT:
        type: string
  ReportDetailsMap11.in.TARGET_COLUMN_VALUE:
    type: array
    items: {
      }
  ReportDetailsMap11.out.map:
    type: object
    properties:
      EXECUTION_ID:
        type: string
      CUSTOMIZED_KEY: {
        }
      TARGET_COLUMN_VALUE:
        type: string
      MATCH_RESULT:
        type: string
  ReportDetailsMap12.in.TARGET_COLUMN_VALUE:
    type: array
    items: {
      }
  ReportDetailsMap12.out.map:
    type: object
    properties:
      EXECUTION_ID:
        type: string
      CUSTOMIZED_KEY: {
        }
      TARGET_COLUMN_VALUE:
        type: string
      MATCH_RESULT:
        type: string
  ArrayBuilder2.out.array:
    type: array
    items:
      type: object
      properties:
        EXECUTION_ID:
          type: string
        IID:
          type: string
        SOURCE_TABLE_NAME:
          type: string
        TARGET_TABLE_NAME:
          type: string
        CUSTOMIZED_KEY: {
          }
        SOURCE_COLUMN_ORIG_VALUE: {
          }
        TARGET_COLUMN_ORIG_VALUE: {
          }
        COLUMN_NAME:
          type: string
        SOURCE_COLUMN_VALUE:
          type: string
        TARGET_COLUMN_VALUE:
          type: string
        MATCH_RESULT:
          type: string
        TARGET_VALUE_SECURED:
          type: string
  Const1.in.value:
    type: array
    items: {
      }
  Const1.out.value:
    type: array
    items:
      type: object
      properties:
        EXECUTION_ID:
          type: string
        IID:
          type: string
        SOURCE_TABLE_NAME:
          type: string
        TARGET_TABLE_NAME:
          type: string
        CUSTOMIZED_KEY: {
          }
        SOURCE_COLUMN_ORIG_VALUE: {
          }
        TARGET_COLUMN_ORIG_VALUE: {
          }
        COLUMN_NAME:
          type: string
        SOURCE_COLUMN_VALUE:
          type: string
        TARGET_COLUMN_VALUE:
          type: string
        MATCH_RESULT:
          type: string
        TARGET_VALUE_SECURED:
          type: string
