tags: d2d,d2dv2,D2D,k2verify
stages:
  Check record emoty:
    transactional: true
    actors:
      SrcRecord=[{}]:
        parent: Equals
        in:
          b:
            const: {
              }
            schema: '#ref'
          a:
            external: src_row
      IsNull1:
        parent: IsNull
        in:
          value:
            external: src_row
      TarRecord=[{}]:
        parent: Equals
        in:
          b:
            const: {
              }
            schema: '#ref'
          a:
            external: tar_row
      IsNull2:
        parent: IsNull
        in:
          value:
            external: tar_row
  Src record doesn't exist:
    transactional: true
    dependsOn: Check record emoty
    actors:
      SrcEmpty:
        parent: Or
        condition: result
        in:
          b:
            link: SrcRecord=[{}]/result
          a:
            link: IsNull1/result
      ReportDetailsMap1:
        parent: MapCreate
        in:
          EXECUTION_ID:
            external: execution_id
            schema: string
            mandatory: false
          CUSTOMIZED_KEY:
            external: customized_key
            schema: string
            mandatory: false
          TARGET_COLUMN_VALUE:
            external: target_column_value
            schema: '#ref'
            mandatory: false
          MATCH_RESULT:
            const: Target Key Not Found In Source
            schema: string
            mandatory: false
          SOURCE_TABLE_NAME:
            external: source_table_name
            schema: string
            mandatory: false
          TARGET_TABLE_NAME:
            external: target_table_name
            schema: string
            mandatory: false
          COLUMN_NAME:
            external: key_columns
            schema: string
            mandatory: false
          IID:
            const: '0'
            schema: string
            mandatory: false
        out:
          map:
            schema: '#ref'
    split: '--------------------'
  Tar record doesn't exist:
    transactional: true
    dependsOn: Check record emoty
    actors:
      TAREmpty:
        parent: Or
        condition: result
        in:
          b:
            link: TarRecord=[{}]/result
          a:
            link: IsNull2/result
      ReportDetailsMap11:
        parent: MapCreate
        in:
          EXECUTION_ID:
            external: execution_id
            schema: string
            mandatory: false
          CUSTOMIZED_KEY:
            external: customized_key
            schema: string
            mandatory: false
          TARGET_COLUMN_VALUE:
            external: target_column_value
            schema: '#ref'
            mandatory: false
          MATCH_RESULT:
            const: Source Key Not Found In Target
            schema: string
            mandatory: false
          SOURCE_TABLE_NAME:
            external: source_table_name
            schema: string
            mandatory: false
          TARGET_TABLE_NAME:
            external: target_table_name
            schema: string
            mandatory: false
          COLUMN_NAME:
            external: key_columns
            schema: string
            mandatory: false
          IID:
            const: '0'
            schema: string
            mandatory: false
        out:
          map:
            schema: '#ref'
    split: '--------------------'
  Stage 2:
    else: true
    transactional: true
    dependsOn: Check record emoty
  Src/Tar Empty:
    transactional: true
    actors:
      Or1:
        parent: Or
        in:
          a:
            link: SrcEmpty/result
          b:
            link: TAREmpty/result
        out:
          result:
            external: keyNotFound
  Report key is missing:
    transactional: true
    actors:
      =true:
        parent: Equals
        condition: result
        in:
          b:
            const: true
            schema: boolean
          a:
            link: Or1/result
      Result Files Dir:
        parent: FabricSetRead
        in:
          key:
            const: k2verify.K2VERIFY_RESULT_FILES_PATH
      Format File Name:
        parent: StringFormat
        in:
          format:
            const: ${dir}/verify_fields_results_${source_table_name}_${execution_id}_${bucket_id}.csv
          bucket_id:
            external: bucket_id
            schema: string
            mandatory: false
            createdBy: format
          dir:
            link: Result Files Dir/result
            schema: any
            mandatory: false
            createdBy: format
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: format
          source_table_name:
            external: source_table_name
            schema: any
            mandatory: false
            createdBy: format
  Format Csv:
    transactional: true
    actors:
      CsvBuilder1:
        parent: CsvBuilder
        in:
          header:
            const: false
          columns:
            const:
            - EXECUTION_ID
            - IID
            - SOURCE_TABLE_NAME
            - TARGET_TABLE_NAME
            - CUSTOMIZED_KEY
            - COLUMN_NAME
            - MATCH_RESULT
            - TARGET_VALUE_SECURED
            - SOURCE_COLUMN_VALUE
            - TARGET_COLUMN_VALUE
          maps:
            link:
            - ReportDetailsMap1/map
            - ReportDetailsMap11/map
  Write to file:
    transactional: true
    actors:
      FileWrite1:
        parent: FileWrite
        in:
          interface:
            const: file://
          append:
            const: true
          path:
            link: Format File Name/string
          stream:
            link: CsvBuilder1/csv
schemas:
  SrcRecord=[{}].in.b:
    type: array
    items: {
      }
  TarRecord=[{}].in.b:
    type: array
    items: {
      }
  ReportDetailsMap1.in.TARGET_COLUMN_VALUE:
    type: array
    items: {
      }
  ReportDetailsMap1.out.map:
    type: object
    properties:
      EXECUTION_ID:
        type: string
      CUSTOMIZED_KEY: {
        }
      TARGET_COLUMN_VALUE:
        type: string
      MATCH_RESULT:
        type: string
  ReportDetailsMap11.in.TARGET_COLUMN_VALUE:
    type: array
    items: {
      }
  ReportDetailsMap11.out.map:
    type: object
    properties:
      EXECUTION_ID:
        type: string
      CUSTOMIZED_KEY: {
        }
      TARGET_COLUMN_VALUE:
        type: string
      MATCH_RESULT:
        type: string
