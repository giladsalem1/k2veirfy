tags: d2d,d2dv2,D2D,k2verify
stages:
  Flow inputs:
    transactional: true
    actors:
      SrcRow:
        parent: Const
        in:
          value:
            const: null
            external: src_row
        out:
          value:
            schema: '#ref'
      TarRow:
        parent: Const
        in:
          value:
            const: null
            external: tar_row
        out:
          value:
            schema: '#ref'
  Stage 34:
    transactional: true
    actors:
      ErrorHandler1:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: true
                log: true
                flowName: bwCheckErrorThresholds
                number_of_retries: ''
                retry_interval: ''
          operational_interface:
            external: operational_interface
            schema: string
            mandatory: false
          task_id:
            external: task_id
            schema: string
            mandatory: false
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
          table_name:
            external: source_table_name
            schema: string
            mandatory: false
          bucket_id:
            external: bucket_id
            schema: string
            mandatory: false
      LuFunction2:
        parent: LuFunction
        in:
          functionName:
            const: fnVerifySourceNTarget
          source_columns_to_Ignore_null:
            external: source_columns_to_Ignore_null
            schema: string
            mandatory: false
            createdBy: functionName
          target_columns_to_Ignore_null:
            external: target_columns_to_Ignore_null
            schema: string
            mandatory: false
            createdBy: functionName
          pii_columns:
            external: pii_columns
            schema: string
            mandatory: false
            createdBy: functionName
          sourceMap:
            link: SrcRow/value
            schema: '#ref'
            mandatory: false
            createdBy: functionName
          targetMap:
            link: TarRow/value
            schema: '#ref'
            mandatory: false
            createdBy: functionName
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: functionName
          source_table_name:
            external: source_table_name
            schema: string
            mandatory: false
            createdBy: functionName
          target_table_name:
            external: target_table_name
            schema: string
            mandatory: false
            createdBy: functionName
          customized_key_values:
            external: customized_key_values
            schema: string
            mandatory: false
            createdBy: functionName
          log_pass:
            external: log_pass
            schema: string
            mandatory: false
            createdBy: functionName
          source_env_contains_sensitive_data:
            external: source_env_contains_sensitive_data
            schema: any
            mandatory: false
            createdBy: functionName
          target_env_contains_sensitive_data:
            external: target_env_contains_sensitive_data
            schema: any
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: '#ref'
  Stage 1:
    transactional: true
    dependsOn: Stage 34
    actors:
      Equals1:
        parent: Equals
        condition: result
        in:
          b:
            const: true
            schema: boolean
          a:
            link: ErrorHandler1/result
    split: '--------------------'
  Stage 2:
    else: true
    transactional: true
    dependsOn: Stage 34
  Stage 7:
    transactional: true
    dependsOn: Stage 1
    split: '--------------------'
  If MisMatch Found:
    transactional: true
    dependsOn: Stage 2
    actors:
      JavaScript1:
        parent: JavaScript
        condition: result
        in:
          script:
            const: |-
              var hasNotPassed = false;


                  for (var i = 0; i < input1.length; i++) {
                      if (input1[i] === "NOT PASSED") {
                          hasNotPassed = true;
                          break;
                      }
                  }


              hasNotPassed
          input1:
            link: LuFunction2/result/MATCH_RESULT
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: boolean
      FabricSetRead1:
        parent: FabricSetRead
        disabled: true
        in:
          key:
            const: MISMATCHED_RECORD_COUNT
      MathDivMod:
        parent: MathDivMod
        disabled: true
        in:
          b:
            const: 2000
            schema: integer
          a:
            link: FabricSetRead1/result
      MathAdd1:
        parent: MathAdd
        disabled: true
        in:
          b:
            const: 1
          a:
            link: FabricSetRead1/result
      SetMismatchRecCount:
        parent: FabricSet
        disabled: true
        in:
          key:
            const: MISMATCHED_RECORD_COUNT
          value:
            const: null
            link: MathAdd1/result
            default: false
    split: '--------------------'
  No MisMatches - Do Nothing:
    else: true
    transactional: true
    dependsOn: Stage 2
  Stage 3:
    transactional: true
    dependsOn: Stage 7
    actors:
      Const6:
        parent: Const
        in:
          value:
            const: null
            external: columns
        out:
          value:
            schema: string
    split: '--------------------'
  Check Mismatch Threshold:
    transactional: true
    dependsOn: If MisMatch Found
    actors:
      100 mismatched:
        parent: Equals
        condition: result
        disabled: true
        in:
          b:
            const: 0
            schema: integer
          a:
            link: MathDivMod/mod
      CheckMismatchThresholds:
        parent: InnerFlow
        in:
          flowName:
            const: bwCheckMismatchThresholds
          error:
            schema: any
            mandatory: false
            createdBy: flowName
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: flowName
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: flowName
          table_name:
            external: source_table_name
            schema: string
            mandatory: false
            createdBy: flowName
          bucket_id:
            external: bucket_id
            schema: string
            mandatory: false
            createdBy: flowName
    split: '--------------------'
  Stage 30:
    else: true
    transactional: true
    dependsOn: If MisMatch Found
    split: '--------------------'
  Stage 8:
    transactional: true
    dependsOn: No MisMatches - Do Nothing
  Stage 17:
    transactional: true
    dependsOn: Stage 3
    actors:
      MapCreate1:
        parent: MapCreate
        in:
          EXECUTION_ID:
            external: execution_id
            schema: string
            mandatory: false
          IID:
            const: '0'
            schema: string
            mandatory: false
          SOURCE_TABLE_NAME:
            external: source_table_name
            schema: string
            mandatory: false
          TARGET_TABLE_NAME:
            external: target_table_name
            schema: string
            mandatory: false
          CUSTOMIZED_KEY:
            external: customized_key_values
            schema: string
            mandatory: false
          SOURCE_COLUMN_ORIG_VALUE:
            schema: any
            mandatory: false
          TARGET_COLUMN_ORIG_VALUE:
            schema: any
            mandatory: false
          COLUMN_NAME:
            link:
              path: Const6/value
              iterate: Iterate
            schema: string
            mandatory: false
          SOURCE_COLUMN_VALUE:
            const: Failed
            schema: string
            mandatory: false
          TARGET_COLUMN_VALUE:
            const: Failed
            schema: string
            mandatory: false
          MATCH_RESULT:
            const: NOT PASSED
            schema: string
            mandatory: false
          TARGET_VALUE_SECURED:
            const: 'false'
            schema: string
            mandatory: false
        out:
          map:
            schema: '#ref'
    split: '--------------------'
  Stage 18:
    transactional: true
    dependsOn: Check Mismatch Threshold
    split: '--------------------'
  Stage 32:
    dependsOn: Stage 30
    split: '--------------------'
  Stage 11:
    transactional: true
    dependsOn: Stage 8
  Stage 36:
    last: 1
    transactional: true
    dependsOn: Stage 17
    actors:
      ArrayBuilder2:
        parent: ArrayBuilder
        in:
          input:
            link:
              path: MapCreate1/map
              pos: 0
        out:
          array:
            schema: '#ref'
    split: '--------------------'
  Stage 5:
    last: 1
    else: false
    transactional: true
    dependsOn: Stage 18
    split: '--------------------'
  Stage 33:
    last: 1
    dependsOn: Stage 32
    split: '--------------------'
  Stage 12:
    last: 1
    transactional: true
    dependsOn: Stage 11
  Stage 9:
    transactional: true
    dependsOn: Stage 36
    actors:
      Const1:
        parent: Const
        in:
          value:
            const: null
            link: ArrayBuilder2/array
            schema: '#ref'
        out:
          value:
            schema: '#ref'
    split: '--------------------'
  Stage 10:
    transactional: true
    dependsOn:
    - Stage 5
    - Stage 12
    - Stage 33
    actors:
      Const2:
        parent: Const
        in:
          value:
            const: null
            link: LuFunction2/result
        out:
          value:
            schema: '#ref'
  Stage 16:
    transactional: true
    actors:
      Const5:
        parent: Const
        in:
          value:
            const: null
            link:
            - Const1/value
            - Const2/value
        out:
          value:
            schema: '#ref'
  Stage 4:
    transactional: true
    actors:
      StringFormat1:
        parent: StringFormat
        in:
          format:
            const: ${verify_dir}/verify_fields_results_${source_table_name}_${execution_id}_${bucket_id}.csv
          bucket_id:
            external: bucket_id
            schema: string
            mandatory: false
            createdBy: format
          verify_dir:
            external: verify_dir
            schema: string
            mandatory: false
            createdBy: format
          source_table_name:
            external: source_table_name
            schema: string
            mandatory: false
            createdBy: format
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: format
  Stage 14:
    transactional: true
    actors:
      CsvBuilder1:
        parent: CsvBuilder
        in:
          header:
            const: false
          columns:
            const:
            - EXECUTION_ID
            - IID
            - SOURCE_TABLE_NAME
            - TARGET_TABLE_NAME
            - CUSTOMIZED_KEY
            - COLUMN_NAME
            - MATCH_RESULT
            - TARGET_VALUE_SECURED
            - SOURCE_COLUMN_VALUE
            - TARGET_COLUMN_VALUE
            - SOURCE_COLUMN_VALUE_TRANS
            - TARGET_COLUMN_VALUE_TRANS
          maps:
            link: Const5/value
  Stage 31:
    transactional: true
    actors:
      ErrorHandler2:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: true
                log: false
                flowName: bwPhysicalError
                number_of_retries: ''
                retry_interval: ''
          physical_error_type:
            const: STORAGE_WRITE_FAILED
            schema: string
            mandatory: false
      FileWrite1:
        parent: FileWrite
        in:
          interface:
            const: file://
          append:
            const: true
          stream:
            link: CsvBuilder1/csv
          path:
            external: file_name
  Stage 6:
    transactional: true
  Stage 13:
    transactional: true
  Stage 15:
    transactional: true
  Stage 19:
    transactional: true
  Stage 20:
    transactional: true
  Stage 21:
    transactional: true
  Stage 22:
    transactional: true
  Stage 23:
    transactional: true
  Stage 24:
    transactional: true
  Stage 25:
    transactional: true
  Stage 26:
    transactional: true
  Stage 27:
    transactional: true
  Stage 28:
    transactional: true
  Stage 29:
    transactional: true
