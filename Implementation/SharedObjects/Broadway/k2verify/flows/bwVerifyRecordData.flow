tags: d2d,d2dv2,D2D,k2verify
stages:
  Flow inputs:
    transactional: true
    actors:
      SrcRow:
        parent: Const
        in:
          value:
            const: null
            external: src_row
        out:
          value:
            schema: '#ref'
      TarRow:
        parent: Const
        in:
          value:
            const: null
            external: tar_row
        out:
          value:
            schema: '#ref'
  Stage 34:
    transactional: true
    actors:
      ErrorHandler1:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: true
                log: true
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      LuFunction2:
        parent: LuFunction
        in:
          functionName:
            const: fnVerifySourceNTarget
          source_columns_to_Ignore_null:
            external: source_columns_to_Ignore_null
            schema: any
            mandatory: false
            createdBy: functionName
          target_columns_to_Ignore_null:
            external: target_columns_to_Ignore_null
            schema: any
            mandatory: false
            createdBy: functionName
          pii_columns:
            external: pii_columns
            schema: string
            mandatory: false
            createdBy: functionName
          sourceMap:
            link: SrcRow/value
            schema: '#ref'
            mandatory: false
            createdBy: functionName
          targetMap:
            link: TarRow/value
            schema: '#ref'
            mandatory: false
            createdBy: functionName
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: functionName
          source_table_name:
            external: source_table_name
            schema: string
            mandatory: false
            createdBy: functionName
          target_table_name:
            external: target_table_name
            schema: string
            mandatory: false
            createdBy: functionName
          customized_key_values:
            external: customized_key_values
            schema: string
            mandatory: false
            createdBy: functionName
          log_pass:
            external: log_pass
            schema: string
            mandatory: false
            createdBy: functionName
          source_env_contains_sensitive_data:
            external: source_env_contains_sensitive_data
            schema: any
            mandatory: false
            createdBy: functionName
          target_env_contains_sensitive_data:
            external: target_env_contains_sensitive_data
            schema: any
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: '#ref'
  Stage 1:
    transactional: true
    dependsOn: Stage 34
    actors:
      Equals1:
        parent: Equals
        condition: result
        in:
          b:
            const: true
            schema: boolean
          a:
            link: ErrorHandler1/result
      DbFetchField1:
        parent: DbFetchField
        in:
          interface:
            const: null
            external: operational_interface
          sql:
            const: |-
              select failed_records from ${@schema}.task_execution_buckets
              WHERE task_id = ${task_id}
                AND execution_id = ${execution_id}
                AND table_name = ${table_name}
                AND bucket_id = ${bucket_id};
          schema:
            external: operational_schema
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: sql
          table_name:
            external: source_table_name
            schema: string
            mandatory: false
            createdBy: sql
          bucket_id:
            external: bucket_id
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: integer
      ToNumber1:
        parent: ToNumber
        in:
          value:
            link: DbFetchField1/result
      MathAdd1:
        parent: MathAdd
        in:
          b:
            const: 1
          a:
            link: ToNumber1/number
      ArrayBuilder1:
        parent: ArrayBuilder
    split: '--------------------'
  Stage 2:
    else: true
    transactional: true
    dependsOn: Stage 34
  Stage 7:
    transactional: true
    dependsOn: Stage 1
    actors:
      DbLoad1:
        parent: DbLoad
        in:
          interface:
            const: null
            external: operational_interface
          command:
            const: update
          schema:
            const: null
            external: operational_schema
          table:
            const: task_execution_buckets
          fields:
            const:
            - task_id
            - execution_id
            - table_name
            - bucket_id
            - failed_records
          keys:
            const:
            - task_id
            - execution_id
            - table_name
            - bucket_id
          dialect:
            const: postgres
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: table
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: table
          table_name:
            external: source_table_name
            schema: string
            mandatory: false
            createdBy: table
          bucket_id:
            external: bucket_id
            schema: string
            mandatory: false
            createdBy: table
          failed_records:
            link: MathAdd1/result
            schema: number
            mandatory: false
            createdBy: table
    split: '--------------------'
  Stage 8:
    transactional: true
    dependsOn: Stage 2
  Stage 3:
    transactional: true
    dependsOn: Stage 7
    actors:
      Const6:
        parent: Const
        in:
          value:
            const: null
            external: columns
        out:
          value:
            schema: string
    split: '--------------------'
  Stage 6:
    transactional: true
    dependsOn: Stage 8
  Stage 17:
    transactional: true
    dependsOn: Stage 3
    actors:
      MapCreate1:
        parent: MapCreate
        in:
          EXECUTION_ID:
            external: execution_id
            schema: string
            mandatory: false
          IID:
            const: '0'
            schema: string
            mandatory: false
          SOURCE_TABLE_NAME:
            external: source_table_name
            schema: string
            mandatory: false
          TARGET_TABLE_NAME:
            external: target_table_name
            schema: string
            mandatory: false
          CUSTOMIZED_KEY:
            external: customized_key_values
            schema: any
            mandatory: false
          SOURCE_COLUMN_ORIG_VALUE:
            schema: any
            mandatory: false
          TARGET_COLUMN_ORIG_VALUE:
            schema: any
            mandatory: false
          COLUMN_NAME:
            link:
              path: Const6/value
              iterate: Iterate
            schema: string
            mandatory: false
          SOURCE_COLUMN_VALUE:
            const: Failed
            schema: string
            mandatory: false
          TARGET_COLUMN_VALUE:
            const: Failed
            schema: string
            mandatory: false
          MATCH_RESULT:
            const: NOT PASSED
            schema: string
            mandatory: false
          TARGET_VALUE_SECURED:
            const: 'false'
            schema: string
            mandatory: false
        out:
          map:
            schema: '#ref'
    split: '--------------------'
  Stage 18:
    transactional: true
    dependsOn: Stage 6
  Stage 36:
    last: 1
    transactional: true
    dependsOn: Stage 17
    actors:
      ArrayBuilder2:
        parent: ArrayBuilder
        in:
          input:
            link:
              path: MapCreate1/map
              pos: 0
        out:
          array:
            schema: '#ref'
    split: '--------------------'
  Stage 5:
    last: 1
    else: false
    transactional: true
    dependsOn: Stage 18
  Stage 9:
    transactional: true
    dependsOn: Stage 36
    actors:
      Const1:
        parent: Const
        in:
          value:
            const: null
            link: ArrayBuilder2/array
            schema: '#ref'
        out:
          value:
            schema: '#ref'
    split: '--------------------'
  Stage 10:
    transactional: true
    dependsOn: Stage 5
    actors:
      Const2:
        parent: Const
        in:
          value:
            const: null
            link: LuFunction2/result
        out:
          value:
            schema: '#ref'
  Stage 16:
    transactional: true
    actors:
      Const5:
        parent: Const
        in:
          value:
            const: null
            link:
            - Const1/value
            - Const2/value
        out:
          value:
            schema: '#ref'
  Stage 4:
    transactional: true
    actors:
      StringFormat1:
        parent: StringFormat
        in:
          format:
            const: ${verify_dir}/verify_fields_results_${source_table_name}_${execution_id}_${bucket_id}.csv
          bucket_id:
            external: bucket_id
            schema: string
            mandatory: false
            createdBy: format
          verify_dir:
            external: verify_dir
            schema: string
            mandatory: false
            createdBy: format
          source_table_name:
            external: source_table_name
            schema: string
            mandatory: false
            createdBy: format
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: format
  Stage 14:
    transactional: true
    actors:
      CsvBuilder1:
        parent: CsvBuilder
        in:
          header:
            const: false
          columns:
            const:
            - EXECUTION_ID
            - IID
            - SOURCE_TABLE_NAME
            - TARGET_TABLE_NAME
            - CUSTOMIZED_KEY
            - COLUMN_NAME
            - MATCH_RESULT
            - TARGET_VALUE_SECURED
            - SOURCE_COLUMN_VALUE
            - TARGET_COLUMN_VALUE
            - SOURCE_COLUMN_VALUE_TRANS
            - TARGET_COLUMN_VALUE_TRANS
          maps:
            link: Const5/value
  Stage 31:
    transactional: true
    actors:
      FileWrite1:
        parent: FileWrite
        in:
          interface:
            const: file://
          append:
            const: true
          stream:
            link: CsvBuilder1/csv
          path:
            external: file_name
