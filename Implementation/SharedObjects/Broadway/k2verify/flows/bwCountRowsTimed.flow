tags: k2verify
stages:
  Stage 3:
    transactional: false
    actors:
      LuFunction1:
        parent: LuFunction
        in:
          functionName:
            const: executeQueryWithTimeout
          timeoutSeconds:
            const: '60'
            schema: string
            mandatory: false
            createdBy: functionName
          interfaceName:
            external: interfaceName
            schema: string
            mandatory: false
            createdBy: functionName
          schemaName:
            external: schemaName
            schema: string
            mandatory: false
            createdBy: functionName
          tableName:
            external: tableName
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          countResult:
            external: row_count
            schema: integer
