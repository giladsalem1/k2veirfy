tags: k2verify
stages:
  Stage 4:
    actors:
      Const4:
        parent: Const
        in:
          value:
            const: null
            external: transformationFunction
        out:
          value:
            schema: string
  Stage 1:
    dependsOn: Stage 4
    actors:
      NotNull2:
        parent: NotNull
        condition: result
        in:
          value:
            link: Const4/value
      Const2:
        parent: Const
        in:
          value:
            const: null
            external: env
        out:
          value:
            schema: string
      Const3:
        parent: Const
        in:
          value:
            const: null
            external: delim
        out:
          value:
            schema: string
      Const8:
        parent: Const
        in:
          value:
            const: true
            schema: boolean
        out:
          value:
            schema: boolean
    split: '--------------------'
  Stage 16:
    else: true
    dependsOn: Stage 4
    actors:
      Const7:
        parent: Const
        in:
          value:
            const: null
            external: records
        out:
          value:
            external: transformedRecords
            schema: '#ref'
      Const9:
        parent: Const
        in:
          value:
            const: false
            schema: boolean
        out:
          value:
            schema: boolean
  Stage 17: {
    }
  Stage 6:
    actors:
      Equals1:
        parent: Equals
        condition: result
        in:
          b:
            const: true
            schema: boolean
          a:
            link:
            - Const8/value
            - Const9/value
      Split1:
        parent: Split
        in:
          delimiter:
            const: null
            link: Const3/value
          string:
            link: Const4/value
  Stage 8:
    actors:
      Split2:
        parent: Split
        in:
          delimiter:
            const: ':'
          string:
            link:
              path: Split1/strings
              iterate: Iterate
  Stage 10:
    actors:
      JavaScript3:
        parent: JavaScript
        in:
          script:
            const: arr[0]
          arr:
            link: Split2/strings
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: string
      JavaScript2:
        parent: JavaScript
        in:
          script:
            const: arr[1]
          arr:
            link: Split2/strings
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: string
  Stage 11:
    actors:
      StringFormat1:
        parent: StringFormat
        in:
          format:
            const: ${env}_${col}
          env:
            link: Const2/value
            schema: string
            mandatory: false
            createdBy: format
          col:
            link: JavaScript3/result
            schema: string
            mandatory: false
            createdBy: format
  Stage 18:
    actors:
      Uppercase1:
        parent: Uppercase
        in:
          string:
            link: StringFormat1/string
  Stage 7:
    last: 1
    actors:
      MapBuild1:
        parent: MapBuild
        in:
          value:
            link: JavaScript2/result
          key:
            link: Uppercase1/string
        out:
          map:
            schema: '#ref'
  Stage 5:
    actors:
      Const1:
        parent: Const
        in:
          value:
            const: null
            external: records
        out:
          value:
            schema: '#ref'
  Stage 2:
    actors:
      Columns:
        parent: JavaScript
        in:
          script:
            const: value.keySet();
          value:
            link:
              path: Const1/value
              iterate: Iterate
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
      Values:
        parent: JavaScript
        in:
          script:
            const: value.values();
          value:
            link:
              path: Const1/value
              iterate: Iterate
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Stage 3:
    actors:
      JavaScript1:
        parent: JavaScript
        in:
          script:
            const: map.get(column);
          column:
            link:
              path: Columns/result
              iterate: Iterate
            schema: string
            mandatory: false
          map:
            link: MapBuild1/map
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: string
  Stage 13:
    dependsOn: Stage 3
    actors:
      NotNull1:
        parent: NotNull
        condition: result
        in:
          value:
            link: JavaScript1/result
      ErrorHandler1:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: true
                log: true
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      InnerFlow1:
        parent: InnerFlow
        in:
          flowName:
            const: null
            link: JavaScript1/result
          value:
            link:
              path: Values/result
              iterate: Iterate
            schema: integer
            mandatory: false
        out:
          value:
            schema: integer
      StringFormat2:
        parent: StringFormat
        in:
          format:
            const: ${column}_ORIG
          column:
            link:
              path: Columns/result
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: format
      MapBuild3:
        parent: MapBuild
        resetOnFirstIteration: true
        in:
          value:
            link:
              path: Values/result
              iterate: Iterate
          key:
            link: StringFormat2/string
        out:
          map:
            schema: '#ref'
    split: '--------------------'
  Stage 14:
    else: true
    dependsOn: Stage 3
    actors:
      Const5:
        parent: Const
        in:
          value:
            const: null
            link:
              path: Values/result
              iterate: Iterate
        out:
          value:
            schema: string
  add FAILED_RECORD_IND column:
    actors:
      NotNull3:
        parent: NotNull
        condition: result
        in:
          value:
            link: ErrorHandler1/result
      MapBuild4:
        parent: MapBuild
        resetOnFirstIteration: true
        in:
          key:
            const: FAILED_RECORD_IND
            schema: string
          value:
            const: 'TRUE'
            schema: string
        out:
          map:
            schema: '#ref'
  Stage 19:
    actors:
      MapBuild2:
        parent: MapBuild
        resetOnFirstIteration: true
        in:
          key:
            link:
              path: Columns/result
              iterate: Iterate
          value:
            link:
            - InnerFlow1/value
            - Const5/value
        out:
          map:
            schema: '#ref'
  Stage 15:
    last: 1
    actors:
      MapMerge1:
        parent: MapMerge
        in:
          maps:
            link:
            - path: MapBuild3/map
              pos: 0
            - path: MapBuild2/map
              pos: 1
            - path: MapBuild4/map
              pos: 2
        out:
          map:
            schema: '#ref'
  Stage 12:
    last: 1
    actors:
      ArrayBuilder1:
        parent: ArrayBuilder
        in:
          input:
            link:
              path: MapMerge1/map
              pos: 0
        out:
          array:
            schema: '#ref'
  Stage 9:
    actors:
      Const6:
        parent: Const
        in:
          value:
            const: null
            link: ArrayBuilder1/array
        out:
          value:
            external: transformedRecords
            schema: '#ref'
schemas:
  Const7.out.value:
    type: array
    items:
      type: object
      properties:
        SRC_CUSTOMER_ID:
          type: string
        SRC_SSN:
          type: string
        SRC_FIRST_NAME:
          type: string
        SRC_LAST_NAME:
          type: string
  JavaScript3.in.arr:
    type: array
    items:
      type: string
  JavaScript2.in.arr:
    type: array
    items:
      type: string
  MapBuild1.out.map:
    type: object
    properties:
      FIRST_NAME:
        type: string
      SSN:
        type: string
  Const1.out.value:
    type: array
    items:
      type: object
      properties:
        SRC_FIRST_NAME:
          type: string
        SRC_CUSTOMER_ID:
          type: string
        SRC_SSN:
          type: string
  Columns.in.value:
    type: object
    properties:
      CUSTOMER_ID:
        type: integer
  Columns.out.result:
    type: array
    items:
      type: string
  Values.in.value:
    type: object
    properties:
      CUSTOMER_ID:
        type: integer
  Values.out.result:
    type: array
    items:
      type: string
  JavaScript1.in.map:
    type: object
    properties:
      SRC_FIRST_NAME:
        type: string
      SRC_SSN:
        type: string
  MapBuild3.out.map:
    type: object
    properties:
      SRC_FIRST_NAME:
        type: string
      SRC_CUSTOMER_ID:
        type: string
      SRC_SSN:
        type: string
  MapBuild4.out.map:
    type: object
    properties:
      SRC_FIRST_NAME:
        type: string
      SRC_CUSTOMER_ID:
        type: string
      SRC_SSN:
        type: string
  MapBuild2.out.map:
    type: object
    properties:
      SRC_FIRST_NAME:
        type: string
      SRC_CUSTOMER_ID:
        type: string
      SRC_SSN:
        type: string
  MapMerge1.out.map:
    type: object
    properties:
      SRC_SSN_ORIG:
        type: string
      SRC_CUSTOMER_ID:
        type: integer
      SRC_CREATED_AT:
        type: date
      SRC_CHILDREN_COUNT: {
        }
      SRC_LOYALTY_POINTS:
        type: integer
      SRC_SIGNUP_DATE:
        type: date
      SRC_PREFERRED_LANGUAGE:
        type: string
      SRC_COUNTRY:
        type: string
      SRC_COMM_CHANNEL: {
        }
      SRC_FAVORITE_NUMBER: {
        }
      SRC_LAST_LOGIN_TZ: {
        }
      SRC_UPDATED_AT: {
        }
      SRC_TIMEZONE:
        type: string
      SRC_HOME_LAT: {
        }
      SRC_IS_VIP:
        type: string
      SRC_BALANCE:
        type: integer
      SRC_CREDIT_LIMIT:
        type: integer
      SRC_SMALL_FLAG: {
        }
      SRC_LAST_NAME:
        type: string
      SRC_RISK_SCORE:
        type: integer
      SRC_ROW_VERSION: {
        }
      SRC_FIRST_NAME:
        type: string
      SRC_MARKETING_OPT_IN: {
        }
      SRC_VALID_TO: {
        }
      SRC_NOTES: {
        }
      SRC_PREFERENCES_JSON: {
        }
      SRC_FLOAT_SCORE: {
        }
      SRC_AVATAR_RAW: {
        }
      SRC_VALID_FROM: {
        }
      SRC_DATE_OF_BIRTH: {
        }
      SRC_PROFILE_BLOB: {
        }
      SRC_HEIGHT_CM: {
        }
      SRC_LAST_LOGIN_TS: {
        }
      SRC_WEIGHT_KG: {
        }
      SRC_SSN: {
        }
      SRC_HOME_LON: {
        }
      SRC_DOUBLE_SCORE: {
        }
      SRC_MIDDLE_NAME: {
        }
      SRC_EMAIL:
        type: string
      SRC_ALT_EMAIL: {
        }
      SRC_PHONE:
        type: string
      SRC_ALT_PHONE: {
        }
      SRC_ADDRESS_LINE1:
        type: string
      SRC_ADDRESS_LINE2: {
        }
      SRC_CITY:
        type: string
      SRC_STATE_PROVINCE: {
        }
      SRC_POSTAL_CODE:
        type: string
      SRC_GENDER:
        type: string
      SRC_MARITAL_STATUS:
        type: string
      SRC_NATIONAL_ID: {
        }
      SRC_PASSPORT_NO: {
        }
      FAILED_RECORD_IND:
        type: string
  ArrayBuilder1.out.array:
    type: array
    items:
      type: object
      properties:
        SRC_FIRST_NAME:
          type: string
        SRC_CUSTOMER_ID:
          type: string
        SRC_SSN:
          type: string
  Const6.out.value:
    type: array
    items:
      type: object
      properties:
        SRC_FIRST_NAME:
          type: string
        SRC_CUSTOMER_ID:
          type: string
        SRC_SSN:
          type: string
