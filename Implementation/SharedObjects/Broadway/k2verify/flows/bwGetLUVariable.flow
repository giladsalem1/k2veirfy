description: |-
  Read LU Global Key Value

  Inputs
  luName: lu name
  variableName: global key
tags: d2d,k2verify
stages:
  Input:
    actors:
      LU Type:
        parent: Const
        in:
          value:
            const: verify
            schema: string
            remark: lu name
        out:
          value:
            schema: string
      Variable Name:
        parent: Const
        in:
          value:
            const: null
            external: variableName
            schema: string
            remark: global key
        out:
          value:
            schema: string
  Prepare:
    actors:
      Create The Session Variable Name:
        parent: Concat
        in:
          delimiter:
            const: .
          elements:
            link:
            - path: LU Type/value
              pos: 0
            - path: Variable Name/value
              pos: 1
  Execute:
    actors:
      Get Variable Value:
        parent: DbFetchField
        in:
          interface:
            const: fabric
          sql:
            const: set ${@key}
          key:
            link: Create The Session Variable Name/string
            schema: string
        out:
          result:
            external: variableValue
            schema: string
            remark: global value
