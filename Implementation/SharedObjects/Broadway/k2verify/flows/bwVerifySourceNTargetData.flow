      verifyAllRecordsDuration:
        parent: Aggregate
        in:
          input:
            link:
              path: verifyRecordDataDuration/millis
              pos: 0
  Write each 1000:
    transactional: false
    dependsOn: '# processed records'
    actors:
      1000 processed:
        parent: Equals
        condition: result
        in:
          b:
            const: 0
            schema: integer
          a:
            link: MathDivMod/mod
      RetryQuery14:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      'Update #Processed':
        parent: DbCommand
        in:
          interface:
            const: null
            link: RESULT_INTERFACE/variableValue
          sql:
            const: update ${@schema}.task_execution_buckets set processed_records
              = ${processed_records}, failed_records = ${failed_records}  where task_id=${task_id}
              and execution_id=${execution_id} and table_name=${table_name} and bucket_id=${bucket_id}
          schema:
            link: LOAD_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: sql
          table_name:
            link:
            - FetchTableName/result
