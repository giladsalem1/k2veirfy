        parent: DateDuration
        in:
          from:
            link: tsBeforeVerifyKeysExists/date
          to:
            link: tsAfterVerifyKeysExists/date
      verifyAllKeysExistsDuration:
        parent: Aggregate
        in:
          input:
            link:
              path: verifyKeysExistsDuration/millis
              pos: 0
      tsBeforeVerifyRecordData:
        parent: Now
  Record exists->verify data:
    transactional: true
    dependsOn: Timestamps
    actors:
      RecordExists:
        parent: Equals
        condition: result
        in:
          b:
            const: false
            schema: boolean
          a:
            link: Or1/result
      VerifyRecordData:
        parent: InnerFlow
        in:
          flowName:
