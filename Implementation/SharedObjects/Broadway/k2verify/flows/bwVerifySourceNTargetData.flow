            schema: string
            mandatory: false
            createdBy: sql
          bucket_id:
            link: IID/value
            schema: string
            mandatory: false
            createdBy: sql
          processed_records:
            link: MathAdd1/result
            schema: integer
            mandatory: false
            createdBy: sql
          failed_records:
            link: FailedRecordCount1/result
            schema: string
            mandatory: false
            createdBy: sql
      tsAfterUpdate1000ProcessedRecords:
        parent: Now
      update1000RecordsDuration:
        parent: DateDuration
        in:
          from:
            link: tsAfterVerifyRecordData/date
          to:
            link: tsAfterUpdate1000ProcessedRecords/date
      updateNx1000RecordsDuration:
        parent: Aggregate
        in:
          input:
            link:
              path: update1000RecordsDuration/millis
              pos: 0
    split: '--------------------'
  Stage 39:
    else: true
    transactional: true
    dependsOn: '# processed records'
  Merge:
    last: 1
    transactional: true
  Close loop:
    last: 1
    transactional: true
    actors:
      Now11:
        parent: Now
  Bucket verify end_time:
    transactional: false
    actors:
      Now1:
        parent: Now
      END_TIME:
        parent: ToString
