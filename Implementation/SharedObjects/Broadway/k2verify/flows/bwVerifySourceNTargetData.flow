            schema: string
            mandatory: false
            createdBy: flowName
          target_columns_to_Ignore_null:
            external: target_columns_to_Ignore_null
            schema: string
            mandatory: false
            createdBy: flowName
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: flowName
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: flowName
          operational_interface:
            link: RESULT_INTERFACE/variableValue
            schema: string
            editor:
              interfaceType:
              - database
              - CassandraLoader
              interfaces:
              - fabric
              id: com.k2view.interface
            mandatory: false
            createdBy: flowName
          source_table_name:
            link:
            - FetchTableName/result
            - SRC table name/value
            schema: string
            mandatory: false
            createdBy: flowName
          bucket_id:
            link: IID/value
            schema: string
            mandatory: false
            createdBy: flowName
          target_table_name:
            link:
            - FetchTableName/result
            - TAR table name/value
            schema: string
            mandatory: false
