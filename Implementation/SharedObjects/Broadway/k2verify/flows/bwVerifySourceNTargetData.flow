      tsEndOfProcess:
        parent: Now
      DateDuration6:
        parent: DateDuration
        in:
          from:
            link: Now11/date
          to:
            link: tsEndOfProcess/date
      ToString2:
        parent: ToString
        in:
          value:
            link: tsEndOfProcess/date
  Bucket Verify Completed:
    transactional: false
    actors:
      RetryQuery15:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      UpdateBucketVerifyCompleted1:
        parent: DbCommand
        in:
          interface:
            const: null
            link: RESULT_INTERFACE/variableValue
          sql:
            const: |-
              update ${@schema}.task_execution_buckets set processed_records = ${processed_records}, end_time=${end_time},
              status='Completed' , prepare_keys_group_duration=${prepare_keys_group_duration} , verify_all_keys_exists_duration=${verify_all_keys_exists_duration} ,
              verify_all_records_duration=${verify_all_records_duration}, update_nx1000_records_duration=${update_nx1000_records_duration},duration_6=${duration_6}, select_all_records_from_source_duration=${select_all_records_from_source_duration},
              all_src_transformation_duration=${all_src_transformation_duration},select_all_records_from_tartget_duration=${select_all_records_from_tartget_duration}, all_tar_transformation_duration=${all_tar_transformation_duration},all_src_records_map_duration=${all_src_records_map_duration},all_tar_records_map_duration=${all_tar_records_map_duration},
              verify_source_target_data_start=${verify_source_target_data_start},keys_group_loop_start=${keys_group_loop_start},end_of_process=${end_of_process},create_src_statement_duration=${create_src_statement_duration},create_tar_statement_duration=${create_tar_statement_duration},get_bucket_key_list_duration=${get_bucket_key_list_duration},
              src_bucket_rows_duration=${src_bucket_rows_duration},tar_bucket_rows_duration=${tar_bucket_rows_duration},lu_function_duration=${lu_function_duration}
              where task_id=${task_id} and execution_id=${execution_id} and table_name=${table_name} and bucket_id=${bucket_id}
          schema:
            link: LOAD_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: sql
          table_name:
            link:
            - FetchTableName/result
            - SRC table name/value
            schema: string
            mandatory: false
            createdBy: sql
          bucket_id:
            link: IID/value
            schema: string
            mandatory: false
            createdBy: sql
