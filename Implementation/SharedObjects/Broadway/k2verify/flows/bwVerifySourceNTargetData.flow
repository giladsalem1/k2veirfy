            - FetchTableName/result
            - SRC table name/value
            schema: string
            mandatory: false
            createdBy: flowName
          target_table_name:
            link:
            - FetchTableName/result
            - TAR table name/value
            schema: string
            mandatory: false
            createdBy: flowName
          columns:
            link: SourceEnvQuery/columns
            schema: '#ref'
            mandatory: false
            createdBy: flowName
          file_name:
            external: result_file_name
            schema: string
            mandatory: false
            createdBy: flowName
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: flowName
          bucket_id:
            link: IID/value
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          keyNotFound:
            schema: boolean
    split: '--------------------'
  Stage 4:
    else: true
    transactional: true
    dependsOn: Stage 2
  read processed records:
    transactional: true
    actors:
      ProcessedRecordCount:
        parent: FabricSetRead
        in:
