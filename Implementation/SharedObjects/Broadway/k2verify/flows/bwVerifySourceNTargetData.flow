tags: k2verify
stages:
  Execution params:
    remark: This flow performs data verification between two record sets — one from
      the source and one from the target.
    actors:
      FETCH_SIZE:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_KEYS_FETCH_SIZE
          luName:
            external: schema
      SEPERATOR:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_CONF_SEPARATOR
          luName:
            external: schema
      RESULT_INTERFACE:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_OPERATIONAL_INTERFACE
          luName:
            external: schema
      LOAD_SCHEMA:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_OPERATIONAL_SCHEMA
          luName:
            external: schema
      K2VERIFY_LOG_PASS:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_LOG_PASS
      tsBwVerifySnTData:
        parent: Now
      K2VERIFY_SOURCE_ENV:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_SOURCE_ENV
      ToString1:
        parent: ToString
        in:
          value:
            link: tsBwVerifySnTData/date
      K2VERIFY_TARGET_ENV:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_TARGET_ENV
  Table config:
    actors:
      IID:
        parent: Const
        in:
          value:
            const: null
            external: IID
        out:
          value:
            schema: string
      ExcludeCondition:
        parent: Const
        in:
          value:
            const: null
            external: excludeCondition
        out:
          value:
            schema: string
      CustomizedKey:
        parent: Const
        in:
          value:
            const: null
            external: customizedKeyComparison
            schema: string
        out:
          value:
            schema: string
      PIIColumns:
        parent: Const
        in:
          value:
            const: null
            external: Pii_Columns
            schema: string
        out:
          value:
            schema: string
      BucketRowsFlow:
        parent: Const
        in:
          value:
            const: null
            external: bucketMethod
            schema: string
        out:
          value:
            schema: string
      Split1:
        parent: Split
        in:
          delimiter:
            const: _@_
          string:
            link: IID/value
      FabricSetRead1:
        parent: FabricSetRead
        in:
          key:
            const: verify.K2VERIFY_RESULT_FILES_PATH
      JavaScript1:
        parent: JavaScript
        in:
          script:
            const: |-
              if(iid[1]!=null)
              iid[1];
              else iid[0];
          iid:
            link: Split1/strings
            schema: any
            mandatory: false
        out:
          result:
            schema: string
  Tables details:
    actors:
      SRC DB Interface:
        parent: Const
        in:
          value:
            const: null
            external: sourceInterface
        out:
          value:
            schema: string
      SRC DB Schema:
        parent: Const
        in:
          value:
            const: null
            external: sourceSchema
        out:
          value:
            schema: string
      SRC DB Table:
        parent: Const
        in:
          value:
            const: null
            external: sourceTable
        out:
          value:
            schema: string
      TAR DB Interface:
        parent: Const
        in:
          value:
            const: null
            external: targetInterface
        out:
          value:
            schema: string
      TAR DB Schema:
        parent: Const
        in:
          value:
            const: null
            external: targetSchema
        out:
          value:
            schema: string
      TAR DB Table:
        parent: Const
        in:
          value:
            const: null
            external: targetTable
        out:
          value:
            schema: string
  Comparison keys:
    actors:
      CustomKeysArr:
        parent: Split
        in:
          delimiter:
            const: null
            link: SEPERATOR/variableValue
          string:
            link: CustomizedKey/value
      Now2:
        parent: Now
  Prep Data Queries:
    actors:
      SourceEnvQuery:
        parent: InnerFlow
        in:
          flowName:
            const: bwGenerateSelectStmt
          interface:
            link: SRC DB Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          schema:
            link: SRC DB Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          table:
            link: SRC DB Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          env_prefix:
            const: SRC
            schema: string
            mandatory: false
            createdBy: flowName
          excludedColumnsNames:
            external: excludedColumnsNames
            schema: string
            mandatory: false
            createdBy: flowName
          customizedKeyComparison:
            link: CustomizedKey/value
            schema: string
            mandatory: false
            createdBy: flowName
          delimiter:
            link: SEPERATOR/variableValue
            schema: string
            mandatory: false
            createdBy: flowName
          ColumnMapping:
            external: ColumnMapping
            schema: string
            mandatory: false
            createdBy: flowName
          pii_columns:
            link: PIIColumns/value
            schema: string
            mandatory: false
            createdBy: flowName
          excludeCondition:
            link: ExcludeCondition/value
            schema: string
            mandatory: false
            createdBy: flowName
          environment:
            link: K2VERIFY_SOURCE_ENV/result
            schema: string
            mandatory: false
            createdBy: flowName
          interfaceType:
            external: interfaceType
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          sql:
            schema: string
          columns:
            schema: '#ref'
      Now3:
        parent: Now
      DateDuration1:
        parent: DateDuration
        in:
          from:
            link: Now2/date
          to:
            link: Now3/date
      TargetEnvQuery:
        parent: InnerFlow
        in:
          flowName:
            const: bwGenerateSelectStmt
          interface:
            link: TAR DB Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          schema:
            link: TAR DB Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          table:
            link: TAR DB Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          env_prefix:
            const: TAR
            schema: string
            mandatory: false
            createdBy: flowName
          excludedColumnsNames:
            external: excludedColumnsNames
            schema: string
            mandatory: false
            createdBy: flowName
          customizedKeyComparison:
            link: CustomizedKey/value
            schema: string
            mandatory: false
            createdBy: flowName
          delimiter:
            link: SEPERATOR/variableValue
            schema: string
            mandatory: false
            createdBy: flowName
          ColumnMapping:
            external: ColumnMapping
            schema: string
            mandatory: false
            createdBy: flowName
          pii_columns:
            link: PIIColumns/value
            schema: string
            mandatory: false
            createdBy: flowName
          excludeCondition:
            link: ExcludeCondition/value
            schema: string
            mandatory: false
            createdBy: flowName
          environment:
            link: K2VERIFY_TARGET_ENV/result
            schema: string
            mandatory: false
            createdBy: flowName
          interfaceType:
            external: interfaceType
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          sql:
            schema: string
          columns:
            schema: '#ref'
  Exctract comparison keys:
    transactional: false
    actors:
      Now4:
        parent: Now
      DateDuration2:
        parent: DateDuration
        in:
          from:
            link: Now3/date
          to:
            link: Now4/date
      GetBucketKeysList:
        parent: InnerFlow
        in:
          flowName:
            const: bwGetBucketKeysList
          schema:
            external: schema
            schema: string
            mandatory: false
            createdBy: flowName
          IID:
            link: JavaScript1/result
            schema: string
            mandatory: false
            createdBy: flowName
          customizedKeyComparison:
            link: CustomizedKey/value
            schema: string
            mandatory: false
            createdBy: flowName
          bucketMethod:
            link: BucketRowsFlow/value
            schema: string
            mandatory: false
            createdBy: flowName
          sourceInterface:
            link: SRC DB Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          sourceSchema:
            link: SRC DB Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          sourceTable:
            link: SRC DB Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          targetInterface:
            link: TAR DB Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          targetSchema:
            link: TAR DB Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          targetTable:
            link: TAR DB Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          bucketsNum:
            external: bucketsNum
            schema: string
            mandatory: false
            createdBy: flowName
          excludeCondition:
            link: ExcludeCondition/value
            schema: string
            mandatory: false
            createdBy: flowName
          columnMapping:
            external: ColumnMapping
            schema: string
            mandatory: false
            createdBy: flowName
          interfaceType:
            external: interfaceType
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          keys_list:
            schema: '#ref'
          srcBucketRowsDuration:
            schema: integer
          tarBucketRowsDuration:
            schema: integer
          luFunctionDuration:
            schema: integer
  After keys extract:
    transactional: false
    actors:
      tsBeforePrepareKeysGroup:
        parent: Now
      DateDuration3:
        parent: DateDuration
        in:
          from:
            link: Now4/date
          to:
            link: tsBeforePrepareKeysGroup/date
  Num of records to compare:
    transactional: false
    actors:
      '# Records':
        parent: JavaScript
        in:
          script:
            const: arr.length
          arr:
            link: GetBucketKeysList/keys_list
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: integer
      '# Fields':
        parent: JavaScript
        in:
          script:
            const: arr.length
          arr:
            link: SourceEnvQuery/columns
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: integer
  Calc total fields:
    transactional: false
    actors:
      TotalFields:
        parent: MathMultiply
        in:
          a:
            link: '# Records/result'
          b:
            link: '# Fields/result'
      SetTotalRecCount:
        parent: FabricSet
        in:
          key:
            const: TOTAL_RECORD_COUNT
          value:
            const: null
            link: '# Records/result'
            default: false
  Stage 10:
    transactional: false
    actors:
      DUMMY GET1:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_CSV_MODE;
        out:
          result:
            schema: '#ref'
  Stage 9:
    transactional: false
    dependsOn: Stage 10
    actors:
      Equals1:
        parent: Equals
        condition: result
        in:
          b:
            const: 'true'
            schema: string
          a:
            link:
              path: DUMMY GET1/result/value
              iterate: First
      RetryQuery1:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      FetchTableName:
        parent: DbFetchField
        in:
          interface:
            const: null
            link: RESULT_INTERFACE/variableValue
          sql:
            const: select table_name from ${@schema}.task_execution_buckets where
              task_id=${task_id} and execution_id=${execution_id} and bucket_id=${bucket_id}
          schema:
            link: LOAD_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: sql
          bucket_id:
            link: IID/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: string
    split: '--------------------'
  Stage 11:
    else: true
    transactional: false
    dependsOn: Stage 10
    actors:
      SRC table name:
        parent: Const
        in:
          value:
            const: null
            link: SRC DB Table/value
        out:
          value:
            schema: string
      TAR table name:
        parent: Const
        in:
          value:
            const: null
            link: TAR DB Table/value
        out:
          value:
            schema: string
  'Update # records for report':
    transactional: false
    actors:
      RetryQuery11:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      UpdateTotalRecords:
        parent: DbCommand
        height: 509
        in:
          interface:
            const: null
            link: RESULT_INTERFACE/variableValue
          sql:
            const: update ${@schema}.task_execution_buckets set total_records = ${total_records},
              total_fields = ${total_fields} where task_id=${task_id} and execution_id=${execution_id}
              and table_name=${table_name} and bucket_id=${bucket_id}
          schema:
            link: LOAD_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: sql
          table_name:
            link:
            - FetchTableName/result
            - SRC table name/value
            schema: string
            mandatory: false
            createdBy: sql
          bucket_id:
            link: IID/value
            schema: string
            mandatory: false
            createdBy: sql
          total_records:
            link: '# Records/result'
            schema: integer
            mandatory: false
            createdBy: sql
          total_fields:
            link: TotalFields/result
            schema: integer
            mandatory: false
            createdBy: sql
  Prepare groups of keys:
    transactional: false
    actors:
      ArrayGrouper:
        parent: ArrayGrouper
        in:
          size:
            const: null
            link: FETCH_SIZE/variableValue
          input:
            link: GetBucketKeysList/keys_list
        out:
          result:
            schema: '#ref'
      'tsAfterPrepareKeysGroup : ':
        parent: Now
      PrepareKeysGroupDuration:
        parent: DateDuration
        in:
          from:
            link: tsBeforePrepareKeysGroup/date
          to:
            link: 'tsAfterPrepareKeysGroup : /date'
      tsBeforKeysGroupLoop:
        parent: ToString
        in:
          value:
            link: 'tsAfterPrepareKeysGroup : /date'
      ResetMismatchRecCount:
        parent: FabricSet
        in:
          key:
            const: MISMATCHED_RECORD_COUNT
          value:
            const: '0'
            default: false
      ResetProcessedRecCount:
        parent: FabricSet
        in:
          key:
            const: PROCESSED_RECORD_COUNT
          value:
            const: '0'
            default: false
      ResetFailRecCount:
        parent: FabricSet
        in:
          key:
            const: FAILED_RECORD_COUNT
          value:
            const: '0'
            default: false
  For each group of keys:
    transactional: true
    actors:
      Const1:
        parent: Const
        in:
          value:
            const: null
            link:
              path: ArrayGrouper/result
              iterate: Iterate
        out:
          value:
            schema: '#ref'
  Keys formatted in arrays and maps:
    transactional: true
    actors:
      GetKeysMapsList:
        parent: InnerFlow
        in:
          flowName:
            const: bwGetKeysMapsList
          delim:
            link: SEPERATOR/variableValue
            schema: string
            mandatory: false
            createdBy: flowName
          keyValues:
            link: Const1/value
            schema: '#ref'
            mandatory: false
            createdBy: flowName
          customizedKey:
            link: CustomizedKey/value
            schema: string
            mandatory: false
            createdBy: flowName
          columnMapping:
            external: ColumnMapping
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          SrcKeysMapsList:
            schema: '#ref'
          SrcKeysCombinations:
            schema: '#ref'
          TarKeysMapsList:
            schema: '#ref'
          TarKeysCombinations:
            schema: '#ref'
  Stage 12:
    transactional: true
    actors:
      tsBeforeSelectFromSource:
        parent: Now
  Execute Query - Source:
    transactional: true
    actors:
      RetryQuery12:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: false
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      SetSourceEnv:
        parent: FabricSet
        in:
          key:
            const: ENVIRONMENT
          value:
            link: K2VERIFY_SOURCE_ENV/result
      SourceDbQuery:
        parent: SourceDbQuery
        in:
          interface:
            const: null
            link: SRC DB Interface/value
          sql:
            const: null
            link: SourceEnvQuery/sql
          size:
            const: null
            link: FETCH_SIZE/variableValue
          rowsGeneratorDistribution:
            const: 1
            schema: integer
          __active_environment:
            const: source
            schema: string
            mandatory: false
          parent_rows:
            link: GetKeysMapsList/SrcKeysMapsList
        out:
          result:
            schema: '#ref'
      tsAfterSelectFromSource:
        parent: Now
      selectFromSourceDuration:
        parent: DateDuration
        in:
          from:
            link: tsBeforeSelectFromSource/date
          to:
            link: tsAfterSelectFromSource/date
      selectAllRecordsFromSourceDuration:
        parent: Aggregate
        in:
          input:
            link:
              path: selectFromSourceDuration/millis
              pos: 0
  Stage 6:
    transactional: true
    dependsOn: Execute Query - Source
    actors:
      JavaScript2:
        parent: JavaScript
        condition: result
        in:
          script:
            const: source_transformation_function != null && source_transformation_function
              != undefined && source_transformation_function != ''
          source_transformation_function:
            external: source_transformation_function
            schema: string
            mandatory: false
        out:
          result:
            schema: boolean
      ApplySrcTransformation:
        parent: InnerFlow
        in:
          flowName:
            const: bwApplyTransformationBW
          records:
            link: SourceDbQuery/result
            schema: '#ref'
            mandatory: false
            createdBy: flowName
          env:
            const: SRC
            schema: string
            mandatory: false
            createdBy: flowName
          transformationFunction:
            external: source_transformation_function
            schema: string
            mandatory: false
            createdBy: flowName
          delim:
            link: SEPERATOR/variableValue
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          transformedRecords:
            schema: '#ref'
    split: '--------------------'
  Stage 7:
    else: true
    transactional: true
    dependsOn: Execute Query - Source
    actors:
      Const2:
        parent: Const
        in:
          value:
            const: null
            link: SourceDbQuery/result
        out:
          value:
            schema: '#ref'
  Stage 13:
    transactional: true
    actors:
      tsAfterSrcTransformation:
        parent: Now
      srcTransformationDuration:
        parent: DateDuration
        in:
          from:
            link: tsAfterSelectFromSource/date
          to:
            link: tsAfterSrcTransformation/date
      allSRCTransformationDuration:
        parent: Aggregate
        in:
          input:
            link:
              path: srcTransformationDuration/millis
              pos: 0
  Execute Query - Target:
    transactional: true
    actors:
      RetryQuery13:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      SetTargetEnv:
        parent: FabricSet
        in:
          key:
            const: ENVIRONMENT
          value:
            link: K2VERIFY_TARGET_ENV/result
      TargetDbQuery:
        parent: SourceDbQuery
        in:
          interface:
            const: null
            link: TAR DB Interface/value
          sql:
            const: null
            link: TargetEnvQuery/sql
          size:
            const: null
            link: FETCH_SIZE/variableValue
          rowsGeneratorDistribution:
            const: 1
            schema: integer
          __active_environment:
            const: target
            schema: string
            mandatory: false
          parent_rows:
            link: GetKeysMapsList/TarKeysMapsList
        out:
          result:
            schema: '#ref'
      tsAfterSelectFromTarget:
        parent: Now
      selectFromTargertDuration:
        parent: DateDuration
        in:
          from:
            link: tsAfterSrcTransformation/date
          to:
            link: tsAfterSelectFromTarget/date
      selectAllRecordsFromTartgetDuration:
        parent: Aggregate
        in:
          input:
            link:
              path: selectFromTargertDuration/millis
              pos: 0
  Stage 5:
    transactional: true
    dependsOn: Execute Query - Target
    actors:
      JavaScript3:
        parent: JavaScript
        condition: result
        in:
          script:
            const: target_transformation_function != null && target_transformation_function
              != undefined && target_transformation_function != ''
          target_transformation_function:
            external: target_transformation_function
            schema: string
            mandatory: false
        out:
          result:
            schema: boolean
      ApplyTarTransformation:
        parent: InnerFlow
        in:
          flowName:
            const: bwApplyTransformationBW
          records:
            link: TargetDbQuery/result
            schema: '#ref'
            mandatory: false
            createdBy: flowName
          env:
            const: TAR
            schema: string
            mandatory: false
            createdBy: flowName
          transformationFunction:
            external: target_transformation_function
            schema: string
            mandatory: false
            createdBy: flowName
          delim:
            link: SEPERATOR/variableValue
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          transformedRecords:
            schema: '#ref'
    split: '--------------------'
  Stage 8:
    else: true
    transactional: true
    dependsOn: Execute Query - Target
    actors:
      Const3:
        parent: Const
        in:
          value:
            const: null
            link: TargetDbQuery/result
        out:
          value:
            schema: '#ref'
  Stage 14:
    transactional: true
    actors:
      tsAfterTARTransformation:
        parent: Now
      tarTransformationDuration:
        parent: DateDuration
        in:
          from:
            link: tsAfterSelectFromTarget/date
          to:
            link: tsAfterTARTransformation/date
      allTARTransformationDuration:
        parent: Aggregate
        in:
          input:
            link:
              path: tarTransformationDuration/millis
              pos: 0
  Extract Row Src:
    transactional: true
    actors:
      SrcRecordsMap:
        parent: LuFunction
        in:
          functionName:
            const: fnMergeValuesNdKeysArray
          targetList:
            link: GetKeysMapsList/SrcKeysMapsList
            schema: '#ref'
            mandatory: false
            createdBy: functionName
          sourceList:
            link:
            - ApplySrcTransformation/transformedRecords
            - Const2/value
            schema: '#ref'
            mandatory: false
            createdBy: functionName
          joinKeys:
            link: CustomKeysArr/strings
            schema: '#ref'
            mandatory: false
            createdBy: functionName
          env_prefix:
            const: SRC
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: '#ref'
      tsAfterSrcRecordsMap:
        parent: Now
      srcRecordsMapDuration:
        parent: DateDuration
        in:
          from:
            link: tsAfterTARTransformation/date
          to:
            link: tsAfterSrcRecordsMap/date
      allSrcRecordsMapDuration:
        parent: Aggregate
        in:
          input:
            link:
              path: srcRecordsMapDuration/millis
              pos: 0
  Extract Row Trg:
    transactional: true
    actors:
      TarRecordsMap:
        parent: LuFunction
        in:
          functionName:
            const: fnMergeValuesNdKeysArray
          targetList:
            link: GetKeysMapsList/TarKeysMapsList
            schema: '#ref'
            mandatory: false
            createdBy: functionName
          sourceList:
            link:
            - ApplyTarTransformation/transformedRecords
            - Const3/value
            schema: '#ref'
            mandatory: false
            createdBy: functionName
          joinKeys:
            link: CustomKeysArr/strings
            schema: '#ref'
            mandatory: false
            createdBy: functionName
          env_prefix:
            const: TAR
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: '#ref'
      tsAfterTarRecordsMap:
        parent: Now
      tarRecordsMapDuration:
        parent: DateDuration
        in:
          from:
            link: tsAfterSrcRecordsMap/date
          to:
            link: tsAfterTarRecordsMap/date
      allTarRecordsMapDuration:
        parent: Aggregate
        in:
          input:
            link:
              path: tarRecordsMapDuration/millis
              pos: 0
  Keys arrays and maps:
    transactional: true
    actors:
      KeysArr:
        parent: Const
        in:
          value:
            const: null
            link: GetKeysMapsList/SrcKeysMapsList
        out:
          value:
            schema: '#ref'
      SrcKeysValsCombos:
        parent: Const
        in:
          value:
            const: null
            link: GetKeysMapsList/SrcKeysCombinations
        out:
          value:
            schema: '#ref'
      TarKeysValsCombos:
        parent: Const
        in:
          value:
            const: null
            link: GetKeysMapsList/TarKeysCombinations
        out:
          value:
            schema: '#ref'
      ResetActors1:
        parent: ResetActors
        in:
          actorId:
            const:
            - SourceDbQuery
      ResetActors2:
        parent: ResetActors
        in:
          actorId:
            const:
            - TargetDbQuery
  Primary key formats:
    transactional: true
    actors:
      PrimaryKeyMap:
        parent: Const
        in:
          value:
            const: null
            link:
              path: KeysArr/value
              iterate: Iterate
        out:
          value:
            schema: '#ref'
      PrimaryKeySrcValue:
        parent: Const
        in:
          value:
            const: null
            link:
              path: SrcKeysValsCombos/value
              iterate: Iterate
