      PrimaryKeyTarValue:
        parent: Const
        in:
          value:
            const: null
            link:
              path: TarKeysValsCombos/value
              iterate: Iterate
        out:
          value:
            schema: '#ref'
  Stringify key:
    transactional: true
    actors:
      ToString:
        parent: ToString
        in:
          value:
            link: PrimaryKeyMap/value
  Deep copy record:
    transactional: true
    actors:
      FilterSrcRow:
        parent: JavaScript
        in:
          script:
            const: map.get(key)
          map:
            link: SrcRecordsMap/result
            schema: '#ref'
            mandatory: false
          key:
            link: ToString/string
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
      FilterTarRow:
        parent: JavaScript
        in:
          script:
            const: map.get(key)
          map:
            link: TarRecordsMap/result
            schema: '#ref'
            mandatory: false
          key:
            link: ToString/string
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
      tsBeforeVerifyKeysExists:
        parent: Now
  skip if record failed transformation:
    transactional: true
    dependsOn: Deep copy record
    actors:
      JavaScript4:
        parent: JavaScript
        condition: result
        in:
          script:
            const:
              userCode: |-
                (input_src != null && input_src.containsKey("FAILED_RECORD_IND")) ||
                (input_trg != null && input_trg.containsKey("FAILED_RECORD_IND"))
              script: input_src != null && input_src.containsKey("FAILED_RECORD_IND")
                || input_trg != null && input_trg.containsKey("FAILED_RECORD_IND");
          input_src:
            link: FilterSrcRow/result
            schema: '#ref'
            mandatory: false
          input_trg:
            link: FilterTarRow/result
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: boolean
      ProcessedRecordCount1:
        parent: FabricSetRead
        in:
          key:
            const: PROCESSED_RECORD_COUNT
      MathAdd2:
        parent: MathAdd
        in:
          b:
            const: 1
          a:
            link: ProcessedRecordCount1/result
      '# ProcessedRecords1':
        parent: FabricSet
        in:
          key:
            const: PROCESSED_RECORD_COUNT
          value:
            const: null
            link: MathAdd2/result
            default: false
      InnerFlow1:
        parent: InnerFlow
        in:
          flowName:
            const: bwCheckErrorThresholds
          error:
            schema: any
            mandatory: false
            createdBy: flowName
          operational_interface:
            link: RESULT_INTERFACE/variableValue
            schema: string
            mandatory: false
            createdBy: flowName
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: flowName
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: flowName
          table_name:
            link:
            - FetchTableName/result
            - SRC table name/value
            schema: string
            mandatory: false
            createdBy: flowName
          bucket_id:
            link: IID/value
            schema: string
            mandatory: false
            createdBy: flowName
      LoopSkip2:
        parent: LoopSkip
    split: '--------------------'
  Stage 15:
    else: true
    transactional: true
    dependsOn: Deep copy record
  Stage 2:
    transactional: true
    actors:
      IsNull1:
        parent: IsNull
        in:
          value:
            link: FilterSrcRow/result
      IsNull2:
        parent: IsNull
        in:
          value:
            link: FilterTarRow/result
  Verify record exists:
    transactional: true
    dependsOn: Stage 2
    actors:
      Or1:
        parent: Or
        condition: result
        in:
          a:
            link: IsNull1/result
          b:
            link: IsNull2/result
      VerifyKeysExists:
        parent: InnerFlow
        height: 274
        in:
          flowName:
            const: bwVerifyKeysExists
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: flowName
          src_row:
            link: FilterSrcRow/result
            schema: '#ref'
            mandatory: false
            createdBy: flowName
          tar_row:
            link: FilterTarRow/result
            schema: '#ref'
            mandatory: false
            createdBy: flowName
