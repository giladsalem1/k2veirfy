tags: k2verify
stages:
  Flow inputs:
    remark: This flow validates the configurations of the k2verify mtable
    actors:
      TaskProperties:
        parent: Const
        in:
          value:
            const: null
            external: taskProps
        out:
          value:
            schema: '#ref'
      K2VERIFY_OPERATIONAL_INTERFACE:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_OPERATIONAL_INTERFACE
      K2VERIFY_OPERATIONAL_SCHEMA:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_OPERATIONAL_SCHEMA
  Stage 1:
    actors:
      Source Schema:
        parent: JavaScript
        in:
          script:
            const: |-
              if(dataSource.indexOf(".") > -1){
                  dataSource.split(".")[0];
              }else{
                  dataSource;
              }
          dataSource:
            link:
              path: TaskProperties/value/K2VERIFY_TABLE_LIST/src
              iterate: Iterate
            schema: string
            mandatory: false
        out:
          result:
            schema: string
      Source Table:
        parent: JavaScript
        in:
          script:
            const: |-
              if(dataSource.indexOf(".") > -1){
                  dataSource.split(".")[1];
              }else{
                  dataSource;
              }
          dataSource:
            link:
              path: TaskProperties/value/K2VERIFY_TABLE_LIST/src
              iterate: Iterate
            schema: string
            mandatory: false
        out:
          result:
            schema: string
      Target Table:
        parent: JavaScript
        in:
          script:
            const: |-
              if(dataSource.indexOf(".") > -1){
                  dataSource.split(".")[1];
              }else{
                  dataSource;
              }
          dataSource:
            link:
              path: TaskProperties/value/K2VERIFY_TABLE_LIST/tar
              iterate: Iterate
            schema: string
            mandatory: false
        out:
          result:
            schema: string
      Target Schema:
        parent: JavaScript
        in:
          script:
            const: |-
              if(dataSource.indexOf(".") > -1){
                  dataSource.split(".")[0];
              }else{
                  dataSource;
              }
          dataSource:
            link:
              path: TaskProperties/value/K2VERIFY_TABLE_LIST/tar
              iterate: Iterate
            schema: string
            mandatory: false
        out:
          result:
            schema: string
  Mtable params:
    actors:
      MTableLookup1:
        parent: MTableLookup
        disabled: true
        in:
          mtable:
            const: k2verify_config
          Source_Table_Name:
            link: Source Table/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: mtable
          Source_Interface:
            link: TaskProperties/value/K2VERIFY_INTERFACE_SRC
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: mtable
          Source_Schema:
            link: Source Schema/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: mtable
          Target_Table_Name:
            link: Target Table/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: mtable
          Target_Interface:
            link: TaskProperties/value/K2VERIFY_INTERFACE_TAR
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: mtable
          Target_Schema:
            link: Target Schema/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: mtable
        out:
          result:
            schema: '#ref'
      DbFetchFirstRow1:
        parent: DbFetchFirstRow
        in:
          interface:
            const: null
            link: K2VERIFY_OPERATIONAL_INTERFACE/result
          sql:
            const: |2-
               select
              active as "Active",
              partitions_count as "Buckets",
              column_name_mapping as  "Column_Mapping",
              comparison_keys as "Customized_Key_Comparison",
              excluded_columns_names as "Excluded_Columns_Names",
              partitions_assignment_method as "Buckets_Method",
              pii_column_names as "Pii_Columns",
              rows_filter_condition as "Excluded_Rows_Sql",
              source_ignore_null_columns as "source_columns_to_Ignore_null",
              source_interface as "Source_Interface",
              source_schema as "Source_Schema",
              source_table_name as "Source_Table_Name",
              source_transformation_flow as "Source_Transformation_Function_Name",
              target_ignore_null_columns  as "target_columns_to_Ignore_null",
              target_interface as "Target_Interface",
              target_schema as "Target_Schema",
              target_table_name as "Target_Table_Name",
              target_transformation_flow as "Target_Transformation_Function_Name"
              from ${@schema}.verify_configuration where  source_interface=${source_interface} and source_schema=${source_schema} and source_table_name=${source_table_name} and
              target_interface= ${target_interface} and target_schema=${target_schema} and target_table_name=${target_table_name}
          schema:
            link: K2VERIFY_OPERATIONAL_SCHEMA/result
            schema: string
            mandatory: false
            createdBy: sql
          source_interface:
            link: TaskProperties/value/K2VERIFY_INTERFACE_SRC
            schema: string
            mandatory: false
            createdBy: sql
          source_schema:
            link: Source Schema/result
            schema: string
            mandatory: false
            createdBy: sql
          source_table_name:
            link: Source Table/result
            schema: string
            mandatory: false
            createdBy: sql
          target_interface:
            link: TaskProperties/value/K2VERIFY_INTERFACE_TAR
            schema: string
            mandatory: false
            createdBy: sql
          target_schema:
            link: Target Schema/result
            schema: string
            mandatory: false
            createdBy: sql
          target_table_name:
            link: Target Table/result
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Validation params:
    actors:
      SRC Interface:
        parent: Const
        in:
          value:
            const: null
            link: DbFetchFirstRow1/result/Source_Interface
        out:
          value:
            schema: string
      SRC Schema:
        parent: Const
        in:
          value:
            const: null
            link: DbFetchFirstRow1/result/Source_Schema
        out:
          value:
            schema: string
      SRC Table:
        parent: Const
        in:
          value:
            const: null
            link: DbFetchFirstRow1/result/Source_Table_Name
        out:
          value:
            schema: string
      TAR Interface:
        parent: Const
        in:
          value:
            const: null
            link: DbFetchFirstRow1/result/Target_Interface
        out:
          value:
            schema: string
      TAR Schema:
        parent: Const
        in:
          value:
            const: null
            link: DbFetchFirstRow1/result/Target_Schema
        out:
          value:
            schema: string
      TAR Table:
        parent: Const
        in:
          value:
            const: null
            link: DbFetchFirstRow1/result/Target_Table_Name
        out:
          value:
            schema: string
      Buckets Count:
        parent: Const
        in:
          value:
            const: null
            link: DbFetchFirstRow1/result/Buckets
        out:
          value:
            schema: string
      Buckets Method:
        parent: Const
        in:
          value:
            const: null
            link: DbFetchFirstRow1/result/Buckets_Method
        out:
          value:
            schema: string
  Validate interfaces:
    actors:
      NotNull1:
        parent: NotNull
        condition: result
        in:
          value:
            link: SRC Interface/value
      Validate SRC Interface:
        parent: InnerFlow
        in:
          flowName:
            const: bwCheckDBType
          interface:
            link: SRC Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          envName:
            link: TaskProperties/value/K2VERIFY_ENV_SRC
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          type:
            schema: string
      assertSrcInterface:
        parent: assertNotEquals
        in:
          unexpected:
            const: Unknown
            schema: string
          message:
            const: Please provice a valid source DB interface name
          actual:
            link: Validate SRC Interface/type
      Validate TAR Interface:
        parent: InnerFlow
        in:
          flowName:
            const: bwCheckDBType
          interface:
            link: TAR Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          envName:
            link: TaskProperties/value/K2VERIFY_ENV_TAR
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          type:
            schema: string
      assertTarInterface:
        parent: assertNotEquals
        in:
          unexpected:
            const: Unknown
            schema: string
          message:
            const: Please provice a valid target DB interface name
          actual:
            link: Validate TAR Interface/type
  Validation queries: {
    }
  Validate schemas:
    actors:
      Validate Source Schema:
        parent: LuFunction
        in:
          functionName:
            const: fnValidateSchema
          iface:
            link: SRC Interface/value
            schema: string
            mandatory: false
            createdBy: functionName
          schema:
            link: SRC Schema/value
            schema: string
            mandatory: false
            createdBy: functionName
          environment:
            link: TaskProperties/value/K2VERIFY_ENV_SRC
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: '#ref'
      assertSrcSchema:
        parent: assertNotNull
        in:
          message:
            const: Please provice a valid source schema name
          object:
            link:
              path: Validate Source Schema/result
              iterate: First
      Validate Target Schema:
        parent: LuFunction
        in:
          functionName:
            const: fnValidateSchema
          iface:
            link: TAR Interface/value
            schema: string
            mandatory: false
            createdBy: functionName
          schema:
            link: TAR Schema/value
            schema: string
            mandatory: false
            createdBy: functionName
          environment:
            link: TaskProperties/value/K2VERIFY_ENV_TAR
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: '#ref'
      assertTarSchema:
        parent: assertNotNull
        in:
          message:
            const: Please provice a valid target schema name
          object:
            link:
              path: Validate Target Schema/result
              iterate: First
  Validate tables:
    actors:
      Validate Source Table:
        parent: LuFunction
        in:
          functionName:
            const: fnValidateTable
          iface:
            link: SRC Interface/value
            schema: string
            mandatory: false
            createdBy: functionName
          schema:
            link: SRC Schema/value
            schema: string
            mandatory: false
            createdBy: functionName
          table:
            link: SRC Table/value
            schema: string
            mandatory: false
            createdBy: functionName
          environment:
            link: TaskProperties/value/K2VERIFY_ENV_SRC
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: '#ref'
      assertSrcTable:
        parent: assertNotNull
        in:
          message:
            const: Please provice a valid source table name
          object:
            link:
              path: Validate Source Table/result
              iterate: First
      Validate Target Table:
        parent: LuFunction
        in:
          functionName:
            const: fnValidateTable
          iface:
            link: TAR Interface/value
            schema: string
            mandatory: false
            createdBy: functionName
          schema:
            link: TAR Schema/value
            schema: string
            mandatory: false
            createdBy: functionName
          table:
            link: TAR Table/value
            schema: string
            mandatory: false
            createdBy: functionName
          environment:
            link: TaskProperties/value/K2VERIFY_ENV_TAR
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: '#ref'
      assertTarTable:
        parent: assertNotNull
        in:
          message:
            const: Please provice a valid target table name
          object:
            link:
              path: Validate Target Table/result
              iterate: First
  Validate buckets:
    actors:
      ErrorHandler1:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: No results found for the given
              actions:
                suppress: true
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      Buckets > 0:
        parent: GreaterThan
        in:
          b:
            const: 0
          a:
            link: Buckets Count/value
      assertBucketsCnt:
        parent: assertTrue
        in:
          message:
            const: Buckets count must be greater than 0
          condition:
            link: Buckets > 0/result
      BucketsMethodExists:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: list BF LU_NAME='verify' name='${@buckets_method}'
          buckets_method:
            link: Buckets Method/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
      assertMethodExists:
        parent: assertNotEquals
        in:
          unexpected:
            const: true
            schema: boolean
          message:
            const: Buckets method flow does not exist
          actual:
            link: ErrorHandler1/result
  Validate column mapping:
    dependsOn: Validate buckets
    actors:
      bwValidateColumnMapping1:
        parent: InnerFlow
        in:
          flowName:
            const: bwValidateColumnMapping
          src_interface:
            link: SRC Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_interface:
            link: TAR Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          src_schema:
            link: SRC Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          src_table:
            link: SRC Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_schema:
            link: TAR Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_table:
            link: TAR Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          column_mapping:
            link: DbFetchFirstRow1/result/Column_Mapping
            schema: string
            mandatory: false
            createdBy: flowName
    split: '--------------------'
  Validate keys:
    dependsOn: Validate buckets
    actors:
      bwValidateColumnsNames1:
        parent: InnerFlow
        in:
          flowName:
            const: bwValidateColumnsNames
          case_sensitive:
            const: 'true'
            schema: string
            mandatory: false
            createdBy: flowName
          src_interface:
            link: SRC Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_interface:
            link: TAR Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          columns:
            link: DbFetchFirstRow1/result/Customized_Key_Comparison
            schema: string
            mandatory: false
            createdBy: flowName
          column_mapping:
            link: DbFetchFirstRow1/result/Column_Mapping
            schema: string
            mandatory: false
            createdBy: flowName
          src_schema:
            link: SRC Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          src_table:
            link: SRC Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_schema:
            link: TAR Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_table:
            link: TAR Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          validation_env:
            const: BOTH
            schema: string
            mandatory: false
            createdBy: flowName
    split: '--------------------'
  Validate pii cols:
    dependsOn: Validate buckets
    actors:
      bwValidateColumnsNames112:
        parent: InnerFlow
        in:
          flowName:
            const: bwValidateColumnsNames
          case_sensitive:
            const: 'false'
            schema: string
            mandatory: false
            createdBy: flowName
          src_interface:
            link: SRC Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_interface:
            link: TAR Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          columns:
            link: DbFetchFirstRow1/result/Pii_Columns
            schema: string
            mandatory: false
            createdBy: flowName
          column_mapping:
            link: DbFetchFirstRow1/result/Column_Mapping
            schema: string
            mandatory: false
            createdBy: flowName
          src_schema:
            link: SRC Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          src_table:
            link: SRC Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_schema:
            link: TAR Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_table:
            link: TAR Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          validation_env:
            const: BOTH
            schema: string
            mandatory: false
            createdBy: flowName
    split: '--------------------'
  Validate excluded cols:
    dependsOn: Validate buckets
    actors:
      bwValidateColumnsNames11:
        parent: InnerFlow
        in:
          flowName:
            const: bwValidateColumnsNames
          case_sensitive:
            const: 'false'
            schema: string
            mandatory: false
            createdBy: flowName
          src_interface:
            link: SRC Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_interface:
            link: TAR Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          columns:
            link: DbFetchFirstRow1/result/Excluded_Columns_Names
            schema: string
            mandatory: false
            createdBy: flowName
          column_mapping:
            link: DbFetchFirstRow1/result/Column_Mapping
            schema: string
            mandatory: false
            createdBy: flowName
          src_schema:
            link: SRC Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          src_table:
            link: SRC Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_schema:
            link: TAR Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_table:
            link: TAR Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          validation_env:
            const: BOTH
            schema: string
            mandatory: false
            createdBy: flowName
    split: '--------------------'
  Validate ignore null cols:
    dependsOn: Validate buckets
    actors:
      bwValidateColumnsNames111:
        parent: InnerFlow
        in:
          flowName:
            const: bwValidateColumnsNames
          case_sensitive:
            const: 'false'
            schema: string
            mandatory: false
            createdBy: flowName
          src_interface:
            link: SRC Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_interface:
            link: TAR Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          columns:
            link: DbFetchFirstRow1/result/source_columns_to_Ignore_null
            schema: string
            mandatory: false
            createdBy: flowName
          column_mapping:
            link: DbFetchFirstRow1/result/Column_Mapping
            schema: string
            mandatory: false
            createdBy: flowName
          src_schema:
            link: SRC Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          src_table:
            link: SRC Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_schema:
            link: TAR Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_table:
            link: TAR Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          validation_env:
            const: SRC
            schema: string
            mandatory: false
            createdBy: flowName
      bwValidateColumnsNames1111:
        parent: InnerFlow
        in:
          flowName:
            const: bwValidateColumnsNames
          case_sensitive:
            const: 'false'
            schema: string
            mandatory: false
            createdBy: flowName
          src_interface:
            link: SRC Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_interface:
            link: TAR Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          columns:
            link: DbFetchFirstRow1/result/target_columns_to_Ignore_null
            schema: string
            mandatory: false
            createdBy: flowName
          column_mapping:
            link: DbFetchFirstRow1/result/Column_Mapping
            schema: string
            mandatory: false
            createdBy: flowName
          src_schema:
            link: SRC Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          src_table:
            link: SRC Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_schema:
            link: TAR Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_table:
            link: TAR Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          validation_env:
            const: TAR
            schema: string
            mandatory: false
            createdBy: flowName
  Validate transformation function:
    actors:
      bwValidateTransformationFunc1:
        parent: InnerFlow
        in:
          flowName:
            const: bwValidateTransformationFunc
          src_trn_fun:
            link: DbFetchFirstRow1/result/Source_Transformation_Function_Name
            schema: string
            mandatory: false
            createdBy: flowName
          src_interface:
            link: SRC Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_interface:
            link: TAR Interface/value
            schema: string
            mandatory: false
            createdBy: flowName
          src_schema:
            link: SRC Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          src_table:
            link: SRC Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_table:
            link: TAR Table/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_schema:
            link: TAR Schema/value
            schema: string
            mandatory: false
            createdBy: flowName
          tar_trn_fun:
            link: DbFetchFirstRow1/result/Target_Transformation_Function_Name
            schema: string
            mandatory: false
            createdBy: flowName
schemas:
  TaskProperties.out.value:
    type: object
    properties:
      K2VERIFY_TASK_TITLE:
        type: string
      K2VERIFY_TASK_DESCRIPTION:
        type: string
      K2VERIFY_INTERFACE_SRC:
        type: string
      K2VERIFY_INTERFACE_TAR:
        type: string
      K2VERIFY_ENV_SRC:
        type: string
      K2VERIFY_ENV_TAR:
        type: string
      K2VERIFY_SRC_CONTAINS_SENSITIVE_DATA:
        type: boolean
      K2VERIFY_TAR_CONTAINS_SENSITIVE_DATA:
        type: boolean
      K2VERIFY_PRE_EXECUTION_PROCESSES:
        type: array
        items: {
          }
      K2VERIFY_POST_EXECUTION_PROCESSES:
        type: array
        items: {
          }
      K2VERIFY_MAXWORKERSPERNODE: {
        }
      K2VERIFY_LOGPASS:
        type: boolean
      K2VERIFY_PII_ONLY_COMPARISON:
        type: boolean
      K2VERIFY_TABLE_LIST:
        type: array
        items:
          type: object
          properties:
            src:
              type: string
            tar:
              type: string
            buckets:
              type: string
  MTableLookup1.out.result:
    type: array
    items:
      type: object
      properties:
        Source_Table_Name:
          type: string
        Source_Interface:
          type: string
        Source_Schema:
          type: string
        Source_Transformation_Function_Name: {
          }
        source_columns_to_Ignore_null: {
          }
        Target_Table_Name:
          type: string
        Target_Interface:
          type: string
        Target_Schema:
          type: string
        Target_Transformation_Function_Name: {
          }
        target_columns_to_Ignore_null: {
          }
        Customized_Key_Comparison:
          type: string
        Pii_Columns: {
          }
        Excluded_Columns_Names:
          type: string
        Active:
          type: string
        Mode: {
          }
        Excluded_Rows_Sql: {
          }
        Column_Mapping: {
          }
        Buckets:
          type: string
        Buckets_Method:
          type: string
  DbFetchFirstRow1.out.result:
    type: object
    properties:
      Active:
        type: boolean
      Buckets:
        type: integer
      Column_Mapping:
        type: string
      Customized_Key_Comparison:
        type: string
      Excluded_Columns_Names:
        type: string
      Buckets_Method:
        type: string
      Pii_Columns:
        type: string
      Excluded_Rows_Sql:
        type: string
