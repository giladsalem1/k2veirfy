      SSN:
        type: string
      STATE_PROVINCE:
        type: string
      TIMEZONE: {
        }
      UPDATED_AT: {
        }
      VALID_FROM: {
        }
      VALID_TO: {
        }
      WEIGHT_KG: {
        }
      AVATAR_RAW: {
        }
      LAST_LOGIN_TZ: {
        }
      NOTES:
        type: string
      PREFERENCES_JSON: {
        }
      PROFILE_BLOB: {
        }
  DbCommand1.out.result:
    type: array
    items:
      type: object
      properties:
        column_name:
          type: string
        total_failed:
          type: integer
  JavaScript1.in.dataMap:
    type: object
    properties:
      column_name:
        type: string
      total_failed:
        type: integer
  JavaScript1.in.piiMap:
    type: object
    properties:
      ADDRESS_LINE1:
        type: string
      ADDRESS_LINE2:
        type: string
      ALT_EMAIL: {
        }
      ALT_PHONE:
        type: string
      BALANCE: {
        }
      CHILDREN_COUNT: {
        }
      CITY:
        type: string
      COMM_CHANNEL: {
        }
      COUNTRY:
        type: string
      CREATED_AT: {
        }
      CREDIT_LIMIT: {
        }
      CUSTOMER_ID: {
        }
      DATE_OF_BIRTH: {
