        }
      COUNTRY:
        type: string
      CREATED_AT: {
        }
      CREDIT_LIMIT: {
        }
      CUSTOMER_ID: {
        }
      DATE_OF_BIRTH: {
        }
      DOUBLE_SCORE: {
        }
      EMAIL:
        type: string
      FAVORITE_NUMBER: {
        }
      FIRST_NAME:
        type: string
      FLOAT_SCORE: {
