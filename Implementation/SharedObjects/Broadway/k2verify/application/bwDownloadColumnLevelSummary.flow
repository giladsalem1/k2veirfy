tags: k2verify
stages:
  Stage 1:
    actors:
      K2VERIFY_OPERATIONAL_INTERFACE:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_OPERATIONAL_INTERFACE
      K2VERIFY_OPERATIONAL_SCHEMA:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_OPERATIONAL_SCHEMA
      execution_id:
        parent: ToString
        in:
          value:
            external: execution_id
  Stage 2:
    actors:
      DbCommand2:
        parent: DbCommand
        in:
          interface:
            const: K2VERIFY_OPERATIONAL_DB
            link: K2VERIFY_OPERATIONAL_INTERFACE/result
            default: true
          sql:
            const: select distinct source_table_name from ${@schema_name}.k2verify_table_summary
              where execution_id =${execution_id}
          schema_name:
            link: K2VERIFY_OPERATIONAL_SCHEMA/result
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: execution_id/string
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Stage 3:
    actors:
      table name:
        parent: Const
        in:
          value:
            const: null
            link:
              path: DbCommand2/result/source_table_name
              iterate: Iterate
        out:
          value:
            schema: string
      MTableLookup1:
        parent: MTableLookup
        in:
          mtable:
            const: catalog_field_info
          dataset:
            link:
              path: DbCommand2/result/source_table_name
              iterate: Iterate
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: mtable
        out:
          result:
            schema: '#ref'
          pii:
            schema: string
  Stage 8:
    last: 1
    actors:
      MapBuild2:
        parent: MapBuild
        in:
          key:
            link:
              path: MTableLookup1/result/field
              iterate: Iterate
          value:
            link:
              path: MTableLookup1/result/pii
              iterate: Iterate
        out:
          map:
            schema: '#ref'
  Stage 4:
    actors:
      DbCommand1:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_OPERATIONAL_INTERFACE/result
          sql:
            const: |-
              select column_name,count(*) as total_failed
               from ${@schema}.k2verify_field_summary_${@execution_id} where execution_id =${execution_id} and match_result='NOT PASSED' and source_table_name=${source_table_name} group by column_name
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: sql
          schema:
            link: K2VERIFY_OPERATIONAL_SCHEMA/result
            schema: string
            mandatory: false
            createdBy: sql
          source_table_name:
            link: table name/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
      JavaScript2:
        parent: JavaScript
        in:
          script:
            const: '"execution_id_"+execution_id+"/"+tableName+"_column_details.csv"'
          tableName:
            link: table name/value
            schema: string
            mandatory: false
          execution_id:
            link: execution_id/string
            schema: string
            mandatory: false
        out:
          result:
            schema: string
  Stage 9:
    actors:
      JavaScript1:
        parent: JavaScript
        in:
          script:
            const: |-
              dataMap.pii = piiMap[dataMap.column_name] === null ? false : true;
              dataMap
          dataMap:
            link:
              path: DbCommand1/result
              iterate: Iterate
            schema: '#ref'
            mandatory: false
          piiMap:
            link: MapBuild2/map
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Stage 5:
    actors:
      MapBuild1:
        parent: MapBuild
        disabled: true
        in:
          duplicateKeys:
            const: all
          key:
            link: table name/value
          value:
            link: JavaScript1/result
        out:
          map:
            external: map
            schema: '#ref'
      CsvBuilder1:
        parent: CsvBuilder
        in:
          maps:
            link: JavaScript1/result
  Stage 7:
    last: 1
    actors:
      FileWrite1:
        parent: FileWrite
        in:
          interface:
            const: null
            external: interface
          append:
            const: true
          path:
            link: JavaScript2/result
          stream:
            link: CsvBuilder1/csv
  Stage 6:
    actors:
      ResetActors1:
        parent: ResetActors
        in:
          actorId:
            const:
            - 'MapBuild2 '
schemas:
  DbCommand2.out.result:
    type: array
    items:
      type: object
      properties:
        source_table_name:
          type: string
  MTableLookup1.out.result:
    type: array
    items:
      type: object
      properties:
        dataPlatform:
          type: string
        schema:
          type: string
        dataset:
          type: string
        class:
          type: string
        field:
          type: string
        sqlDataType:
          type: string
        sourceDataType:
          type: string
        sourceEntityType:
          type: string
        sourceNullable:
          type: string
        columnSize:
          type: string
        definedBy:
          type: string
        ordinalPosition:
          type: string
        pk: {
          }
        pii:
          type: string
        classification:
          type: string
        encodingType: {
          }
        idx: {
          }
        V11: {
          }
  MapBuild2.out.map:
    type: object
    properties:
      ADDRESS_LINE1:
        type: string
      ADDRESS_LINE2:
        type: string
      ALT_EMAIL: {
        }
      ALT_PHONE:
        type: string
      BALANCE: {
        }
