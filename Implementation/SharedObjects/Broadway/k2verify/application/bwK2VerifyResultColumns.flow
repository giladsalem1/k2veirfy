tags: k2verify
stages:
  Stage 1:
    actors:
      K2VERIFY_OPERATIONAL_INTERFACE:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_OPERATIONAL_INTERFACE
      K2VERIFY_OPERATIONAL_SCHEMA:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_OPERATIONAL_SCHEMA
      execution_id:
        parent: ToString
        in:
          value:
            external: execution_id
      SEPERATOR:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_CONF_SEPARATOR
          luName:
            external: schema
  Stage 2:
    actors:
      table name:
        parent: Const
        in:
          value:
            const: null
            external: source_table_name
        out:
          value:
            schema: string
  Stage 3:
    actors:
      DbFetchFirstRow1:
        parent: DbFetchFirstRow
        in:
          interface:
            const: null
            link: K2VERIFY_OPERATIONAL_INTERFACE/result
          sql:
            const: |-
              select
              pii_column_names as "Pii_Columns",
              source_interface as "Source_Interface",
              source_schema as "Source_Schema",
              source_table_name as "Source_Table_Name"
              from ${@schema}.verify_configuration where  source_table_name=${source_table_name}
          schema:
            link: K2VERIFY_OPERATIONAL_SCHEMA/result
            schema: string
            mandatory: false
            createdBy: sql
          source_table_name:
            link: table name/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Stage 17:
    actors:
      bwGetPiiColumns:
        parent: InnerFlow
        in:
          flowName:
            const: bwGetPiiColumns
          interface:
            link: DbFetchFirstRow1/result/Source_Interface
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          schema:
            link: DbFetchFirstRow1/result/Source_Schema
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          table:
            link: DbFetchFirstRow1/result/Source_Table_Name
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          customized_pii:
            link: DbFetchFirstRow1/result/Pii_Columns
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          pii_columns:
            schema: string
  Stage 10:
    dependsOn: Stage 17
    actors:
      NotNull1:
        parent: NotNull
        condition: result
        in:
          value:
            link: bwGetPiiColumns/pii_columns
      Split1:
        parent: Split
        in:
          delimiter:
            const: '|'
          string:
            link: bwGetPiiColumns/pii_columns
    split: '--------------------'
  Stage 11:
    else: true
    dependsOn: Stage 17
  Stage 15:
    dependsOn: Stage 10
    actors:
      Uppercase1:
        parent: Uppercase
        in:
          string:
            link:
              path: Split1/strings
              iterate: Iterate
    split: '--------------------'
  Stage 16:
    dependsOn: Stage 11
  Stage 8:
    last: 1
    dependsOn: Stage 15
    actors:
      MapBuild2:
        parent: MapBuild
        in:
          value:
            const: 'true'
            schema: string
          key:
            link: Uppercase1/string
        out:
          map:
            schema: '#ref'
    split: '--------------------'
  Stage 12:
    last: 1
    dependsOn: Stage 16
  Stage 13: {
    }
  Stage 4:
    actors:
      DbCommand1:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_OPERATIONAL_INTERFACE/result
          sql:
            const: |-
              SELECT
                  column_name,
                  COUNT(CASE
                            WHEN LOWER(match_result) = 'not passed' THEN 1
                       END) AS total_failed
              FROM ${@schema}.k2verify_field_summary_${@execution_id}
              WHERE execution_id = ${execution_id}
                AND source_table_name = ${source_table_name}
              GROUP BY column_name
              ORDER BY column_name;
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: sql
          schema:
            link: K2VERIFY_OPERATIONAL_SCHEMA/result
            schema: string
            mandatory: false
            createdBy: sql
          source_table_name:
            link: table name/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
      JavaScript2:
        parent: JavaScript
        in:
          script:
            const: '"execution_id_"+execution_id+"/"+tableName+"_column_details.csv"'
          tableName:
            link: table name/value
            schema: string
            mandatory: false
          execution_id:
            link: execution_id/string
            schema: string
            mandatory: false
        out:
          result:
            schema: string
  Stage 9:
    actors:
      JavaScript1:
        parent: JavaScript
        in:
          script:
            const: |-
              dataMap.pii = !!(piiMap && piiMap[dataMap.column_name] != null);
              dataMap
          dataMap:
            link:
              path: DbCommand1/result
              iterate: Iterate
            schema: '#ref'
            mandatory: false
          piiMap:
            link: MapBuild2/map
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Stage 5:
    actors:
      ArrayBuilder1:
        parent: ArrayBuilder
        in:
          input:
            link:
              path: JavaScript1/result
              pos: 0
        out:
          array:
            external: array
            schema: '#ref'
  Stage 7:
    last: 1
  Stage 6:
    actors:
      ResetActors1:
        parent: ResetActors
        in:
          actorId:
            const:
            - 'MapBuild2 '
            - CsvBuilder1
schemas:
  DbFetchFirstRow1.out.result:
    type: object
    properties:
      Pii_Columns:
        type: string
      Source_Interface:
        type: string
      Source_Schema:
        type: string
      Source_Table_Name:
        type: string
  MapBuild2.out.map:
    type: object
    properties:
      ADDRESS_LINE1:
        type: string
      ADDRESS_LINE2:
        type: string
      ALT_EMAIL: {
        }
      ALT_PHONE:
        type: string
      BALANCE: {
        }
      CHILDREN_COUNT: {
        }
      CITY:
        type: string
      COMM_CHANNEL: {
        }
      COUNTRY:
        type: string
      CREATED_AT: {
        }
      CREDIT_LIMIT: {
        }
      CUSTOMER_ID: {
        }
      DATE_OF_BIRTH: {
        }
      DOUBLE_SCORE: {
        }
      EMAIL:
        type: string
      FAVORITE_NUMBER: {
        }
      FIRST_NAME:
        type: string
      FLOAT_SCORE: {
        }
      GENDER:
        type: string
      HEIGHT_CM: {
        }
      HOME_LAT: {
        }
      HOME_LON: {
        }
      IS_VIP: {
        }
      LAST_LOGIN_TS: {
        }
      LAST_NAME:
        type: string
      LOYALTY_POINTS: {
        }
      MARITAL_STATUS: {
        }
      MARKETING_OPT_IN: {
        }
      MIDDLE_NAME:
        type: string
      NATIONAL_ID:
        type: string
      PASSPORT_NO:
        type: string
      PHONE:
        type: string
      POSTAL_CODE:
        type: string
      PREFERRED_LANGUAGE:
        type: string
      RISK_SCORE: {
        }
      ROW_VERSION: {
        }
      SIGNUP_DATE: {
        }
      SMALL_FLAG: {
        }
      SSN:
        type: string
      STATE_PROVINCE:
        type: string
      TIMEZONE: {
        }
      UPDATED_AT: {
        }
      VALID_FROM: {
        }
      VALID_TO: {
        }
      WEIGHT_KG: {
        }
      AVATAR_RAW: {
        }
      LAST_LOGIN_TZ: {
        }
      NOTES:
        type: string
      PREFERENCES_JSON: {
        }
      PROFILE_BLOB: {
        }
  DbCommand1.out.result:
    type: array
    items:
      type: object
      properties:
        column_name:
          type: string
        total_failed:
          type: integer
  JavaScript1.in.dataMap:
    type: object
    properties:
      column_name:
        type: string
      total_failed:
        type: integer
  JavaScript1.in.piiMap:
    type: object
    properties:
      ADDRESS_LINE1:
        type: string
      ADDRESS_LINE2:
        type: string
      ALT_EMAIL: {
        }
      ALT_PHONE:
        type: string
      BALANCE: {
        }
      CHILDREN_COUNT: {
        }
      CITY:
        type: string
      COMM_CHANNEL: {
        }
      COUNTRY:
        type: string
      CREATED_AT: {
        }
      CREDIT_LIMIT: {
        }
      CUSTOMER_ID: {
        }
      DATE_OF_BIRTH: {
        }
      DOUBLE_SCORE: {
        }
      EMAIL:
        type: string
      FAVORITE_NUMBER: {
        }
      FIRST_NAME:
        type: string
      FLOAT_SCORE: {
        }
      GENDER:
        type: string
      HEIGHT_CM: {
        }
      HOME_LAT: {
        }
      HOME_LON: {
        }
      IS_VIP: {
        }
      LAST_LOGIN_TS: {
        }
      LAST_NAME:
        type: string
      LOYALTY_POINTS: {
        }
      MARITAL_STATUS: {
        }
      MARKETING_OPT_IN: {
        }
      MIDDLE_NAME:
        type: string
      NATIONAL_ID:
        type: string
      PASSPORT_NO:
        type: string
      PHONE:
        type: string
      POSTAL_CODE:
        type: string
      PREFERRED_LANGUAGE:
        type: string
      RISK_SCORE: {
        }
      ROW_VERSION: {
        }
      SIGNUP_DATE: {
        }
      SMALL_FLAG: {
        }
      SSN:
        type: string
      STATE_PROVINCE:
        type: string
      TIMEZONE: {
        }
      UPDATED_AT: {
        }
      VALID_FROM: {
        }
      VALID_TO: {
        }
      WEIGHT_KG: {
        }
      AVATAR_RAW: {
