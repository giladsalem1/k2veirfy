  JavaScript1.out.result:
    type: object
    properties:
      column_name:
        type: string
      total_failed:
        type: integer
      pii:
        type: boolean
  ArrayBuilder1.out.array:
    type: array
    items:
      type: object
      properties:
        column_name:
          type: string
        total_failed:
          type: integer
        pii:
          type: boolean
