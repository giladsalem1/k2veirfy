tags: k2verify
stages:
  Stage 8:
    actors:
      Const2:
        parent: Const
        in:
          value:
            const: -r
            schema: string
        out:
          value:
            schema: string
      Const3:
        parent: Const
        in:
          value:
            const: -j
            schema: string
        out:
          value:
            schema: string
      FabricSetRead1:
        parent: FabricSetRead
        in:
          key:
            const: verify.K2VERIFY_RESULT_FILES_PATH
  Stage 15:
    actors:
      File Name:
        parent: JavaScript
        in:
          script:
            const: '"execution_id_"+execution_id'
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
        out:
          result:
            schema: string
      JavaScript1:
        parent: JavaScript
        in:
          script:
            const: path+"/"
          path:
            link: FabricSetRead1/result
            schema: any
            mandatory: false
  Stage 7:
    actors:
      JavaScript5:
        parent: JavaScript
        in:
          script:
            const: '"file://"+path'
          path:
            link: JavaScript1/result
            schema: string
            mandatory: false
        out:
          result:
            schema: string
      File Name with Extension:
        parent: JavaScript
        in:
          script:
            const: file_name+'.zip'
          file_name:
            link: File Name/result
            schema: string
            mandatory: false
        out:
          result:
            schema: string
  Stage 1:
    actors:
      ErrorHandler1:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: true
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      ls:
        parent: ls
        height: 212
        in:
          interface:
            const: null
            link: JavaScript5/result
          directories:
            const: true
          path:
            link: File Name/result
        out:
          result:
            schema: '#ref'
      Zip File Name Path:
        parent: JavaScript
        in:
          script:
            const: path+file_name
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
          path:
            link: JavaScript1/result
            schema: string
            mandatory: false
          file_name:
            link: File Name with Extension/result
            schema: string
            mandatory: false
        out:
          result:
            schema: string
  Stage 2:
    dependsOn: Stage 1
    actors:
      Const1:
        parent: Const
        condition: value
        in:
          value:
            const: null
            link: ErrorHandler1/result
        out:
          value:
            schema: boolean
      md1:
        parent: md
        in:
          interface:
            const: null
            link: JavaScript5/result
          path:
            link: File Name/result
      InnerFlow1:
        parent: InnerFlow
        in:
          flowName:
            const: bwDownloadColumnLevelSummary
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: flowName
          interface:
            link: JavaScript5/result
            schema: string
            editor:
              id: com.k2view.interface
              interfaceType:
              - LOCAL
              - SFTP
              - filesystem
              interfaces:
              - file://
            mandatory: false
            createdBy: flowName
          schema:
            const: verify
            schema: string
            mandatory: false
            createdBy: flowName
      InnerFlow2:
        parent: InnerFlow
        in:
          flowName:
            const: bwK2VerifyDownloadRecordDetailsData
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: flowName
          interface:
            link: JavaScript5/result
            schema: string
            editor:
              id: com.k2view.interface
              interfaceType:
              - LOCAL
              - SFTP
              - filesystem
              interfaces:
              - file://
            mandatory: false
            createdBy: flowName
        out:
          map:
            schema: '#ref'
    split: '--------------------'
  Stage 11:
    else: true
    dependsOn: Stage 1
  Stage 3: {
    }
  Stage 9:
    actors:
      Concat1:
        parent: Concat
        in:
          delimiter:
            const: ''
          elements:
            link:
            - path: JavaScript1/result
              pos: 0
            - path: File Name/result
              pos: 1
  Stage 4:
    actors:
      ArrayBuilder1:
        parent: ArrayBuilder
        in:
          input:
            link:
            - path: Const2/value
              pos: 0
            - path: Zip File Name Path/result
              pos: 1
            - path: Const3/value
              pos: 2
            - path: Concat1/string
              pos: 3
        out:
          array:
            schema: '#ref'
  Stage 5:
    actors:
      Exec1:
        parent: Exec
        in:
          command:
            const: zip
          params:
            const: null
            link: ArrayBuilder1/array
  Stage 6:
    actors:
      Return Path and file name:
        parent: Const
        in:
          value:
            const: null
            link: Zip File Name Path/result
        out:
          value:
            external: fPath
            schema: string
schemas:
  ls.out.result:
    type: array
    items:
      type: object
      properties:
        name:
          type: string
        size:
          type: integer
        createTime:
          type: integer
        lastModifiedTime:
          type: integer
        lastAccessTime:
          type: integer
        directory:
          type: boolean
  InnerFlow2.out.map:
    type: object
    properties:
      CUSTOMER_1:
        type: array
        items:
          type: object
          properties:
            column_name:
              type: string
            total_failed:
              type: integer
      CUSTOMER_2:
        type: array
        items:
          type: object
          properties:
            column_name:
              type: string
            total_failed:
              type: integer
      CUSTOMER_3:
        type: array
        items:
          type: object
          properties:
            column_name:
              type: string
            total_failed:
              type: integer
      CUSTOMER_4:
        type: array
        items:
          type: object
          properties:
            column_name:
              type: string
            total_failed:
              type: integer
      CUSTOMER_5:
        type: array
        items:
          type: object
          properties:
            column_name:
              type: string
            total_failed:
              type: integer
      CUSTOMER_6:
        type: array
        items:
          type: object
          properties:
            column_name:
              type: string
            total_failed:
              type: integer
      CUSTOMER_7:
        type: array
        items:
          type: object
          properties:
            column_name:
              type: string
            total_failed:
              type: integer
      CUSTOMER_8:
        type: array
        items:
          type: object
          properties:
            column_name:
              type: string
            total_failed:
              type: integer
      CUSTOMER_SRC:
        type: array
        items:
          type: object
          properties:
            column_name:
              type: string
            total_failed:
              type: integer
  ArrayBuilder1.out.array:
    type: array
    items:
      type: string
