tags: application,k2verify
stages:
  Stage 1:
    actors:
      Const1:
        parent: Const
        in:
          value:
            const: null
            external: old_task_id
        out:
          value:
            schema: string
      JsonParser1:
        parent: JsonParser
        in:
          stream:
            external: task_params
        out:
          object:
            schema: '#ref'
      FabricSetRead1:
        parent: FabricSetRead
        in:
          key:
            const: username
      Const2:
        parent: Const
        in:
          value:
            const: Inactive
            schema: string
        out:
          value:
            schema: string
      Now1:
        parent: Now
      K2VERIFY_OPERATIONAL_INTERFACE:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_OPERATIONAL_INTERFACE
      K2VERIFY_OPERATIONAL_INTERFACE1:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_OPERATIONAL_SCHEMA
  Stage 2:
    actors:
      ToString1:
        parent: ToString
        in:
          value:
            link: Now1/date
      JavaScript3:
        parent: JavaScript
        in:
          script:
            const: |2-


              delete obj.K2VERIFY_TABLE_LIST;

              obj;
          obj:
            link: JsonParser1/object
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Prepare properties:
    actors:
      JsonStringify1:
        parent: JsonStringify
        in:
          object:
            link: JavaScript3/result
  Stage 3:
    transactional: true
    dependsOn: Prepare properties
    actors:
      JavaScript1:
        parent: JavaScript
        condition: result
        in:
          script:
            const: |-
              if(old_task_id){
                  true
              }
              else{
                  false
              }
          old_task_id:
            link: Const1/value
            schema: string
            mandatory: false
        out:
          result:
            schema: boolean
      DbLoad2:
        parent: DbLoad
        in:
          interface:
            const: null
            link: K2VERIFY_OPERATIONAL_INTERFACE/result
          command:
            const: update
          schema:
            const: null
            link: K2VERIFY_OPERATIONAL_INTERFACE1/result
          table:
            const: tasks
          fields:
            const:
            - task_id
            - task_status
            - updated_by
            - updated_at
          keys:
            const:
            - task_id
          dialect:
            const: postgres
          task_id:
            link: Const1/value
            schema: string
            mandatory: false
            createdBy: schema
          task_status:
            link: Const2/value
            schema: string
            mandatory: false
            createdBy: schema
          updated_by:
            link: FabricSetRead1/result
            schema: string
            mandatory: false
            createdBy: schema
          updated_at:
            link: ToString1/string
            schema: string
            mandatory: false
            createdBy: schema
    split: '--------------------'
  Stage 4:
    else: true
    transactional: true
    dependsOn: Prepare properties
  Stage 13:
    transactional: true
  Stage 5:
    transactional: true
    actors:
      DbLoad1:
        parent: DbLoad
        in:
          interface:
            const: null
            link: K2VERIFY_OPERATIONAL_INTERFACE/result
          schema:
            const: null
            link: K2VERIFY_OPERATIONAL_INTERFACE1/result
          table:
            const: tasks
          fields:
            const:
            - task_title
            - task_description
            - source_interface
            - target_interface
            - properties
            - created_by
            - updated_by
            - updated_at
          keys:
            const:
            - task_id
          dialect:
            const: postgres
          task_title:
            link: JsonParser1/object/K2VERIFY_TASK_TITLE
            schema: string
            mandatory: false
            createdBy: schema
          task_description:
            link: JsonParser1/object/K2VERIFY_TASK_DESCRIPTION
            schema: string
            mandatory: false
            createdBy: schema
          source_interface:
            link: JsonParser1/object/K2VERIFY_INTERFACE_SRC
            schema: string
            mandatory: false
            createdBy: schema
          target_interface:
            link: JsonParser1/object/K2VERIFY_INTERFACE_TAR
            schema: string
            mandatory: false
            createdBy: schema
          created_by:
            link: FabricSetRead1/result
            schema: string
            mandatory: false
            createdBy: schema
          updated_by:
            schema: any
            mandatory: false
            createdBy: schema
          updated_at:
            schema: any
            mandatory: false
            createdBy: schema
          properties:
            link: JsonStringify1/string
            schema: string
            mandatory: false
            createdBy: fields
      DbFetchField1:
        parent: DbFetchField
        in:
          interface:
            const: K2VERIFY_OPERATIONAL_DB
          sql:
            const: SELECT currval('k2verify.tasks_task_id_seq')
        out:
          result:
            schema: integer
  Stage 11:
    transactional: true
    actors:
      Const3:
        parent: Const
        in:
          value:
            const: null
            link: JsonParser1/object/K2VERIFY_TABLE_LIST
        out:
          value:
            schema: '#ref'
  Stage 10:
    transactional: true
    actors:
      ToString5:
        parent: ToString
        in:
          value:
            link:
              path: Const3/value
              iterate: Iterate
  Stage 12:
    last: 1
    transactional: true
    actors:
      DbLoad task_table_properties:
        parent: DbLoad
        in:
          interface:
            const: null
            link: K2VERIFY_OPERATIONAL_INTERFACE/result
          schema:
            const: null
            link: K2VERIFY_OPERATIONAL_INTERFACE1/result
          table:
            const: task_table_properties
          fields:
            const:
            - table_properties
            - task_id
            - source_table_name
            - target_table_name
          keys:
            const:
            - ''
            - ''
          dialect:
            const: postgres
          table_properties:
            link: ToString5/string
            schema: string
            mandatory: false
          source_table_name:
            link: Const3/value/src
            schema: string
            mandatory: false
          target_table_name:
            link: Const3/value/tar
            schema: string
            mandatory: false
          task_id:
            link: DbFetchField1/result
            schema: integer
            mandatory: false
  Stage 8:
    actors:
      Task_id:
        parent: Const
        in:
          value:
            const: null
            link: DbFetchField1/result
        out:
          value:
            external: task_id
            schema: integer
schemas:
  JsonParser1.out.object:
    type: object
    properties:
      K2VERIFY_TASK_TITLE:
        type: string
      K2VERIFY_TASK_DESCRIPTION:
        type: string
      K2VERIFY_INTERFACE_SRC:
        type: string
      K2VERIFY_INTERFACE_TAR:
        type: string
      K2VERIFY_ENV_SRC:
        type: string
      K2VERIFY_ENV_TAR:
        type: string
      K2VERIFY_SRC_CONTAINS_SENSITIVE_DATA:
        type: boolean
      K2VERIFY_TAR_CONTAINS_SENSITIVE_DATA:
        type: boolean
      K2VERIFY_TABLE_LIST:
        type: array
        items:
          type: object
          properties:
            src:
              type: string
            tar:
              type: string
            buckets:
              type: string
      K2VERIFY_MAXWORKERSPERNODE:
        type: integer
      K2VERIFY_LOGPASS:
        type: boolean
      K2VERIFY_PII_ONLY_COMPARISON:
        type: boolean
  JavaScript3.in.obj:
    type: object
    properties:
      K2VERIFY_TASK_TITLE:
        type: string
      K2VERIFY_TASK_DESCRIPTION:
        type: string
      K2VERIFY_INTERFACE_SRC:
        type: string
      K2VERIFY_INTERFACE_TAR:
        type: string
      K2VERIFY_ENV_SRC:
        type: string
      K2VERIFY_ENV_TAR:
        type: string
      K2VERIFY_SRC_CONTAINS_SENSITIVE_DATA:
        type: boolean
      K2VERIFY_TAR_CONTAINS_SENSITIVE_DATA:
        type: boolean
      K2VERIFY_TABLE_LIST:
        type: array
        items:
          type: object
          properties:
            src:
              type: string
            tar:
              type: string
            buckets:
              type: string
      K2VERIFY_MAXWORKERSPERNODE: {
        }
      K2VERIFY_LOGPASS:
        type: boolean
      K2VERIFY_PII_ONLY_COMPARISON:
        type: boolean
  JavaScript3.out.result:
    type: object
    properties:
      K2VERIFY_TASK_TITLE:
        type: string
      K2VERIFY_TASK_DESCRIPTION:
        type: string
      K2VERIFY_INTERFACE_SRC:
        type: string
      K2VERIFY_INTERFACE_TAR:
        type: string
      K2VERIFY_ENV_SRC:
        type: string
      K2VERIFY_ENV_TAR:
        type: string
      K2VERIFY_SRC_CONTAINS_SENSITIVE_DATA:
        type: boolean
      K2VERIFY_TAR_CONTAINS_SENSITIVE_DATA:
        type: boolean
      K2VERIFY_PRE_EXECUTION_PROCESSES:
        type: array
        items: {
          }
      K2VERIFY_POST_EXECUTION_PROCESSES:
        type: array
        items: {
          }
      K2VERIFY_MAXWORKERSPERNODE: {
        }
      K2VERIFY_LOGPASS:
        type: boolean
      K2VERIFY_PII_ONLY_COMPARISON:
        type: boolean
  Const3.out.value:
    type: array
    items:
      type: object
      properties:
        src:
          type: string
        tar:
          type: string
        buckets:
          type: string
