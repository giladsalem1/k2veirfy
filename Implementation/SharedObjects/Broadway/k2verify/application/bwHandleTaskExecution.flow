        {
            "stages": [
                {
                    "name": "Update time after record sumary",
                    "dependsOnList": [],
                    "actors": [
                        {
                            "name": "UpTimAfterRecSum",
                            "actorType": {
                                "parentType": "DbCommand",
                                "inputs": [
                                    {
                                        "name": "interface",
                                        "const": null
                                    },
                                    {
                                        "name": "sql",
                                        "const": "update ${@schema}.task_execution set time_after_record_summary='${@time_after_record_summary}' where task_id=${@task_id} and execution_id=${@execution_id} and execution_status='In_Progress'"
                                    },
                                    {
                                        "name": "schema",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "sql",
                                        "mandatory": false
                                    },
                                    {
                                        "name": "task_id",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "sql",
                                        "mandatory": false
                                    },
                                    {
                                        "name": "execution_id",
                                        "schema": {
                                            "type": "integer"
                                        },
                                        "createdBy": "sql",
                                        "mandatory": false
                                    },
                                    {
                                        "name": "time_after_record_summary",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "sql",
                                        "mandatory": false
                                    }
                                ],
                                "outputs": [
                                    {
                                        "name": "result",
                                        "schema": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "batch_id": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        }
