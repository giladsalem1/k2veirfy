        {
            "stages": [
                {
                    "name": "Fiels/Record summary creation command",
                    "dependsOnList": [
                        "Fetch generated execution id"
                    ],
                    "actors": [
                        {
                            "name": "CreateFieldSumCmd",
                            "actorType": {
                                "parentType": "StringFormat",
                                "inputs": [
                                    {
                                        "name": "format",
                                        "const": "CREATE TABLE IF NOT EXISTS ${k2verify_schema}.k2verify_field_summary_${execution_id} (\r\n  EXECUTION_ID bigint,\r\n  IID character varying(200),\r\n  SOURCE_TABLE_NAME character varying(200),\r\n  TARGET_TABLE_NAME character varying(200),\r\n  CUSTOMIZED_KEY character varying(1000),\r\n  COLUMN_NAME character varying(200),\r\n  MATCH_RESULT character varying(50),\r\n  TARGET_VALUE_SECURED character varying(50),\r\n  SOURCE_COLUMN_VALUE character varying(1000),\r\n  TARGET_COLUMN_VALUE character varying(1000),\r\n  SOURCE_COLUMN_VALUE_TRANS character varying(1000),\r\n  TARGET_COLUMN_VALUE_TRANS character varying(1000),\r\n  BW_TRANSFORMATION_FLOW boolean,\r\n  NULL_COMPARE boolean,\r\n  LOOKUP boolean,\r\n  DEFAULT_VALUE boolean)"
                                    },
                                    {
                                        "name": "k2verify_schema",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "format",
                                        "mandatory": false
                                    },
                                    {
                                        "name": "execution_id",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "format",
                                        "mandatory": false
                                    }
                                ],
                                "outputs": []
                            }
                        },
                        {
                            "name": "CreateRecSumCmd",
                            "minHeight": 90,
                            "actorType": {
                                "parentType": "StringFormat",
                                "inputs": [
                                    {
                                        "name": "format",
                                        "const": "CREATE TABLE IF NOT EXISTS ${k2verify_schema}.k2verify_record_summary_${execution_id} (\r\nexecution_id BIGINT,\r\niid character varying(200),\r\nsource_table_name character varying(200),\r\ntarget_table_name character varying(200),\r\ncustomized_key character varying(1000),\r\nnumber_of_fields_mismatch integer,\r\nnumber_of_fields_match integer,\r\nnumber_of_fields_only_in_target integer,\r\nnumber_of_fields_only_in_source integer,\r\nnumber_of_fields_unsecured_in_target integer\r\n)"
                                    },
                                    {
                                        "name": "execution_id",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "format",
                                        "mandatory": false
                                    },
                                    {
                                        "name": "k2verify_schema",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "format",
                                        "mandatory": false
                                    }
                                ],
                                "outputs": []
                            }
                        }
                    ]
                },
                {
                    "name": " ",
                    "dependsOnList": [
                        "Execution started"
                    ],
                    "actors": []
                }
