            ]
        },
        {
            "stages": [
                {
                    "name": "Table Summary",
                    "dependsOnList": [],
                    "actors": [
                        {
                            "name": "TableSummaryRows",
                            "actorType": {
                                "parentType": "DbCommand",
                                "inputs": [
                                    {
                                        "name": "interface",
                                        "const": null
                                    },
                                    {
                                        "name": "sql",
                                        "const": "INSERT INTO ${@result_schema}.k2verify_table_summary (\n    execution_id,\n    iid,\n    source_table_name,\n    target_table_name,\n    number_of_records_match,\n    number_of_records_mismatch,\n    number_of_records_only_in_source,\n    number_of_records_only_in_target,\n    number_of_records_unsecured_in_target,\n    match_result\n)\nSELECT\n    execution_id,\n    0 AS iid,\n    source_table_name,\n    target_table_name,\n\n    COUNT(*) FILTER (\n        WHERE number_of_fields_mismatch = 0\n          AND number_of_fields_only_in_target = 0\n          AND number_of_fields_only_in_source = 0\n    ) AS number_of_records_match,\n\n    COUNT(*) FILTER (WHERE number_of_fields_mismatch > 0)\n        AS number_of_records_mismatch,\n\n    COUNT(*) FILTER (WHERE number_of_fields_only_in_source > 0)\n        AS number_of_records_only_in_source,\n\n    COUNT(*) FILTER (WHERE number_of_fields_only_in_target > 0)\n        AS number_of_records_only_in_target,\n\n    COUNT(*) FILTER (WHERE number_of_fields_unsecured_in_target > 0)\n        AS number_of_records_unsecured_in_target,\n\n    CASE\n        WHEN\n            MAX(number_of_fields_mismatch) > 0\n            OR MAX(number_of_fields_only_in_source) > 0\n            OR MAX(number_of_fields_only_in_target) > 0\n        THEN 'NOT PASSED'\n        ELSE 'PASSED'\n    END AS match_result\n\nFROM ${@result_schema}.k2verify_record_summary_${@execution_id}\nGROUP BY\n    execution_id,\n    iid,\n    source_table_name,\n    target_table_name\n\nON CONFLICT (execution_id, iid, source_table_name, target_table_name)\nDO UPDATE SET\n    number_of_records_match = EXCLUDED.number_of_records_match,\n    number_of_records_mismatch = EXCLUDED.number_of_records_mismatch,\n    number_of_records_only_in_source = EXCLUDED.number_of_records_only_in_source,\n    number_of_records_only_in_target = EXCLUDED.number_of_records_only_in_target,\n    number_of_records_unsecured_in_target = EXCLUDED.number_of_records_unsecured_in_target,\n    match_result = EXCLUDED.match_result;"
                                    },
                                    {
                                        "name": "execution_id",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "sql",
                                        "mandatory": false
                                    },
                                    {
                                        "name": "result_schema",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "sql",
                                        "mandatory": false
                                    }
                                ],
                                "outputs": [
                                    {
                                        "name": "result",
                                        "schema": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "execution_id": {
                                                        "type": "string"
                                                    },
                                                    "iid": {
                                                        "type": "string"
                                                    },
                                                    "source_table_name": {
                                                        "type": "string"
                                                    },
                                                    "target_table_name": {
                                                        "type": "string"
                                                    },
                                                    "number_of_records_match": {
                                                        "type": "integer"
                                                    },
                                                    "number_of_records_mismatch": {
                                                        "type": "integer"
                                                    },
                                                    "number_of_records_only_in_source": {
                                                        "type": "integer"
                                                    },
                                                    "number_of_records_only_in_target": {
                                                        "type": "integer"
                                                    },
                                                    "number_of_records_unsecured_in_target": {
                                                        "type": "integer"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        },
