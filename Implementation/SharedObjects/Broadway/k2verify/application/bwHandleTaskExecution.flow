                                        "name": "script",
                                        "const": {
                                            "userCode": "(IsRetryMode == \"true\" && table_status=='Failed') || !(IsRetryMode ==\"true\")",
                                            "script": "IsRetryMode == \"true\" && table_status == 'Failed' || !(IsRetryMode == \"true\");"
