                                        "const": "INSERT INTO ${@result_schema}.k2verify_record_summary_${@execution_id}(\n    execution_id,\n    iid,\n    source_table_name,\n    target_table_name,\n    customized_key,\n    number_of_fields_mismatch,\n    number_of_fields_match,\n    number_of_fields_only_in_target,\n    number_of_fields_only_in_source,\n    number_of_fields_unsecured_in_target\n)\nSELECT\n    execution_id,\n    0 AS iid,\n    source_table_name,\n    target_table_name,\n    customized_key,\n    COUNT(*) FILTER (WHERE match_result = 'NOT PASSED') AS number_of_fields_mismatch,\n    COUNT(*) FILTER (WHERE match_result = 'PASSED') AS number_of_fields_match,\n    COUNT(*) FILTER (\n        WHERE match_result IN ('Target Key Not Found In Source','Instance Not Found In Source')\n    ) AS number_of_fields_only_in_target,\n    COUNT(*) FILTER (\n        WHERE match_result IN ('Source Key Not Found In Target','Instance Not Found In Target')\n    ) AS number_of_fields_only_in_source,\n    COUNT(*) FILTER (WHERE match_result = 'NOT PASSED') AS number_of_fields_unsecured_in_target\nFROM ${@result_schema}.k2verify_field_summary_${@execution_id}\nGROUP BY\n    execution_id,\n    iid,\n    source_table_name,\n    target_table_name,\n    customized_key;"
                                    },
                                    {
                                        "name": "execution_id",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "sql",
                                        "mandatory": false
                                    },
                                    {
                                        "name": "result_schema",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "sql",
                                        "mandatory": false
                                    }
                                ],
                                "outputs": [
                                    {
                                        "name": "result",
                                        "schema": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "execution_id": {
                                                        "type": "string"
                                                    },
                                                    "iid": {
                                                        "type": "string"
                                                    },
                                                    "source_table_name": {
                                                        "type": "string"
                                                    },
                                                    "target_table_name": {
                                                        "type": "string"
                                                    },
                                                    "customized_key": {
                                                        "type": "string"
                                                    },
                                                    "number_of_fields_mismatch": {
                                                        "type": "integer"
                                                    },
                                                    "number_of_fields_match": {
                                                        "type": "integer"
                                                    },
                                                    "number_of_fields_only_in_target": {
                                                        "type": "integer"
                                                    },
                                                    "number_of_fields_only_in_source": {
                                                        "type": "integer"
                                                    },
                                                    "number_of_fields_unsecured_in_target": {
                                                        "type": "integer"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "stages": [
                {
                    "name": "Execution history table",
                    "dependsOnList": [],
                    "isTransactional": false,
                    "actors": [
                        {
                            "name": "ExecutionHistory",
                            "actorType": {
                                "parentType": "DbCommand",
                                "inputs": [
                                    {
                                        "name": "interface",
                                        "const": null
                                    },
                                    {
                                        "name": "sql",
                                        "const": "INSERT INTO ${@result_schema}.task_execution_history(\n    execution_id,\n    number_of_fields_match,\n    number_of_fields_mismatch,\n    number_of_fields_only_in_target,\n    number_of_fields_only_in_source\n)\nSELECT\n    execution_id,\n    SUM(number_of_fields_match) AS number_of_fields_match,\n    SUM(number_of_fields_mismatch) AS number_of_fields_mismatch,\n    SUM(number_of_fields_only_in_target) AS number_of_fields_only_in_target,\n    SUM(number_of_fields_only_in_source) AS number_of_fields_only_in_source\nFROM ${@result_schema}.k2verify_record_summary_${@execution_id}\nGROUP BY execution_id\nON CONFLICT (execution_id)\nDO UPDATE SET\n    number_of_fields_match = EXCLUDED.number_of_fields_match,\n    number_of_fields_mismatch = EXCLUDED.number_of_fields_mismatch,\n    number_of_fields_only_in_target = EXCLUDED.number_of_fields_only_in_target,\n    number_of_fields_only_in_source = EXCLUDED.number_of_fields_only_in_source;"
                                    },
                                    {
                                        "name": "execution_id",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "sql",
                                        "mandatory": false
                                    },
                                    {
                                        "name": "result_schema",
                                        "schema": {
                                            "type": "string"
                                        },
                                        "createdBy": "sql",
                                        "mandatory": false
                                    }
                                ],
                                "outputs": [
                                    {
                                        "name": "result",
                                        "schema": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "execution_id": {
                                                        "type": "string"
                                                    },
                                                    "iid": {
                                                        "type": "string"
                                                    },
                                                    "source_table_name": {
                                                        "type": "string"
                                                    },
                                                    "target_table_name": {
                                                        "type": "string"
                                                    },
                                                    "customized_key": {
                                                        "type": "string"
                                                    },
                                                    "number_of_fields_mismatch": {
                                                        "type": "integer"
                                                    },
                                                    "number_of_fields_match": {
                                                        "type": "integer"
                                                    },
                                                    "number_of_fields_only_in_target": {
                                                        "type": "integer"
                                                    },
                                                    "number_of_fields_only_in_source": {
                                                        "type": "integer"
                                                    },
                                                    "number_of_fields_unsecured_in_target": {
                                                        "type": "integer"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
