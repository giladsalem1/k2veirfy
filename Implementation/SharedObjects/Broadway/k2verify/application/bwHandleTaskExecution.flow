                        {
                            "name": "UpTaskEndTimeDueFail",
                            "actorType": {
                                "parentType": "DbCommand",
                                "inputs": [
                                    {
                                        "name": "interface",
                                        "const": null
                                    },
                                    {
                                        "name": "sql",
                                        "const": "update ${@schema}.task_execution set execution_status='Stopped', end_time='${@end_time}' where task_id=${@task_id} and execution_id=${@execution_id} and lower(execution_status) <> 'failed' AND lower(execution_status) <> 'completed'  AND lower(execution_status) <> 'stopped' AND lower(execution_status) <> 'killed'"
                                    },
                                    {
                                        "name": "schema",
