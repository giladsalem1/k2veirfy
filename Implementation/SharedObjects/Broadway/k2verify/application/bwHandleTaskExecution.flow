                                            "userCode": "const myMap = {};\n\nmyMap.src_schema =src_table[0];\nmyMap.src_table  = src_table[1];\nmyMap.tar_schema = tar_table[0];\nmyMap.tar_table  = tar_table[1];\n\nmyMap;",
                                            "script": "var myMap = {};\nmyMap.src_schema = src_table[0];\nmyMap.src_table = src_table[1];\nmyMap.tar_schema = tar_table[0];\nmyMap.tar_table = tar_table[1];\nmyMap;"
