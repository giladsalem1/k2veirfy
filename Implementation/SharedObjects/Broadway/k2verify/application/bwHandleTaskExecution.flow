tags: k2verify
stages:
  Flow Params:
    actors:
      GetLUName1:
        parent: GetLUName
        out:
          lu_name:
            schema: string
      Now:
        parent: Now
      START_TIME:
        parent: ToString
        in:
          value:
            link: Now/date
      K2VERIFY_INTERFACE:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_OPERATIONAL_INTERFACE
          luName:
            link: GetLUName1/lu_name
      K2VERIFY_SCHEMA:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_OPERATIONAL_SCHEMA
          luName:
            link: GetLUName1/lu_name
  User name:
    actors:
      FetchUser:
        parent: DbFetchField
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: select created_by from ${@schema}.tasks where task_id=${task_id}
          schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            link: K2VERIFY_SCHEMA/variableValue
            external: task_id
            schema: integer
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: integer
  Generate new execution:
    dependsOn: User name
    actors:
      RegularMode:
        parent: NotEquals
        condition: result
        in:
          a:
            external: IsRetryMode
            schema: string
          b:
            const: 'true'
            schema: string
      RetryPhysicalError1:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      LoadNewExecution:
        parent: DbLoad
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          command:
            const: upsert
          schema:
            const: null
            link: K2VERIFY_SCHEMA/variableValue
          table:
            const: task_execution
          fields:
            const:
            - task_id
            - execution_status
            - start_time
            - started_by
          keys:
            const:
            - execution_id
            - task_id
          dialect:
            const: postgres
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: schema
          execution_status:
            const: In_Progress
            schema: string
            mandatory: false
            createdBy: schema
          start_time:
            link: START_TIME/string
            schema: integer
            mandatory: false
            createdBy: schema
          started_by:
            link: FetchUser/result
            schema: string
            mandatory: false
            createdBy: fields
    split: '--------------------'
  Retry Mode:
    else: true
    dependsOn: User name
    actors:
      RETRY_EXECUTION_ID:
        parent: ToNumber
        in:
          value:
            external: retry_execution_id
  Fetch generated execution id:
    dependsOn: Generate new execution
    actors:
      RetryPhysicalError2:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      FetchExecutionID:
        parent: DbFetchField
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: select execution_id from ${@schema}.task_execution where task_id=${task_id}
              and execution_status='In_Progress'
          schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: integer
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: integer
    split: '--------------------'
  Execution started:
    dependsOn: Retry Mode
    actors:
      LoadExecutionStarted:
        parent: DbLoad
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          command:
            const: update
          schema:
            const: null
            link: K2VERIFY_SCHEMA/variableValue
          table:
            const: task_execution
          fields:
            const:
            - execution_status
            - start_time
            - started_by
          keys:
            const:
            - execution_id
            - task_id
          dialect:
            const: postgres
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: schema
          execution_status:
            const: In_Progress
            schema: string
            mandatory: false
            createdBy: schema
          start_time:
            link: START_TIME/string
            schema: integer
            mandatory: false
            createdBy: schema
          started_by:
            link: FetchUser/result
            schema: string
            mandatory: false
            createdBy: fields
          execution_id:
            link: RETRY_EXECUTION_ID/number
            schema: integer
            mandatory: false
  Fiels/Record summary creation command:
    dependsOn: Fetch generated execution id
    actors:
      CreateFieldSumCmd:
        parent: StringFormat
        in:
          format:
            const: "CREATE TABLE IF NOT EXISTS ${k2verify_schema}.k2verify_field_summary_${execution_id}\
              \ (\r\n  EXECUTION_ID bigint,\r\n  IID character varying(200),\r\n \
              \ SOURCE_TABLE_NAME character varying(200),\r\n  TARGET_TABLE_NAME character\
              \ varying(200),\r\n  CUSTOMIZED_KEY character varying(1000),\r\n  COLUMN_NAME\
              \ character varying(200),\r\n  MATCH_RESULT character varying(50),\r\
              \n  TARGET_VALUE_SECURED character varying(50),\r\n  SOURCE_COLUMN_VALUE\
              \ character varying(1000),\r\n  TARGET_COLUMN_VALUE character varying(1000),\r\
              \n  SOURCE_COLUMN_VALUE_TRANS character varying(1000),\r\n  TARGET_COLUMN_VALUE_TRANS\
              \ character varying(1000),\r\n  BW_TRANSFORMATION_FLOW boolean,\r\n\
              \  NULL_COMPARE boolean,\r\n  LOOKUP boolean,\r\n  DEFAULT_VALUE boolean)"
          k2verify_schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: format
          execution_id:
            link: FetchExecutionID/result
            schema: string
            mandatory: false
            createdBy: format
      CreateRecSumCmd:
        parent: StringFormat
        height: 90
        in:
          format:
            const: "CREATE TABLE IF NOT EXISTS ${k2verify_schema}.k2verify_record_summary_${execution_id}\
              \ (\r\nexecution_id BIGINT,\r\niid character varying(200),\r\nsource_table_name\
              \ character varying(200),\r\ntarget_table_name character varying(200),\r\
              \ncustomized_key character varying(1000),\r\nnumber_of_fields_mismatch\
              \ integer,\r\nnumber_of_fields_match integer,\r\nnumber_of_fields_only_in_target\
              \ integer,\r\nnumber_of_fields_only_in_source integer,\r\nnumber_of_fields_unsecured_in_target\
              \ integer\r\n)"
          execution_id:
            link: FetchExecutionID/result
            schema: string
            mandatory: false
            createdBy: format
          k2verify_schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: format
    split: '--------------------'
  ' ':
    dependsOn: Execution started
  Create field/record summary tables:
    dependsOn: Fiels/Record summary creation command
    actors:
      RetryPhysicalError3:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      CreateFieldSummary:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: null
            link: CreateFieldSumCmd/string
      CreateRecordSummary:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: null
            link: CreateRecSumCmd/string
    split: '--------------------'
  '  ':
    dependsOn: ' '
  Task Execution ID:
    actors:
      Execution ID:
        parent: ToString
        in:
          value:
            link:
            - RETRY_EXECUTION_ID/number
            - FetchExecutionID/result
  Task tables properties:
    actors:
      RetryPhysicalError4:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      FetchTaskProps:
        parent: DbFetchField
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: select properties from ${@schema}.tasks where task_id=${task_id}
          schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: integer
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: string
      FetchTablesProps:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: ' select table_properties  from ${@schema}.task_table_properties
              where task_id=${task_id}'
          schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: integer
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Format properties:
    actors:
      Task properties:
        parent: JsonParser
        in:
          stream:
            link: FetchTaskProps/result
        out:
          object:
            schema: '#ref'
      Tables properties:
        parent: JsonParser
        in:
          single:
            const: false
          stream:
            link: FetchTablesProps/result/table_properties
        out:
          object:
            schema: '#ref'
      DeepCopyProps:
        parent: DeepCopy
        in:
          value:
            link: Tables properties/object
        out:
          value:
            schema: '#ref'
  Execute pre process:
    actors:
      PreProcessErrorFields:
        parent: ErrorFields
        error: message
        out:
          inputs:
            schema: '#ref'
      ExecutePreProcess:
        parent: InnerFlow
        in:
          flowName:
            const: bwExecutePrePostProcess
          process_type:
            const: pre
            schema: string
            mandatory: false
            createdBy: flowName
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: flowName
          task_id:
            external: task_id
            schema: integer
            mandatory: false
            createdBy: flowName
          task_properties:
            link: Task properties/object
            schema: '#ref'
            mandatory: false
            createdBy: flowName
          table_properties:
            link: DeepCopyProps/value
            schema: '#ref'
            mandatory: false
            createdBy: flowName
          table_status_details:
            schema: any
            mandatory: false
            createdBy: flowName
          IsRetryMode:
            external: IsRetryMode
            schema: boolean
            mandatory: false
            createdBy: flowName
  pre process failed - stop task:
    dependsOn: Execute pre process
    actors:
      PreProcessFailed:
        parent: NotNull
        condition: result
        in:
          value:
            link: PreProcessErrorFields/message
      RetryPhysicalError5:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      Now1:
        parent: Now
      TimeAfterPreProcess:
        parent: ToString
        in:
          value:
            link: Now1/date
      UpPreProcessFailed:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: update ${@k2verify_schema}.task_execution_tables set status='Failed'
              , end_time='${@end_time}' where task_id=${task_id} and execution_id=${execution_id}
              and status='In_Progress'
          k2verify_schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          end_time:
            link: TimeAfterPreProcess/string
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: sql
      UpTaskEndTimeDueFail:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: update ${@schema}.task_execution set execution_status='Stopped',
              end_time='${@end_time}' where task_id=${@task_id} and execution_id=${@execution_id}
              and lower(execution_status) <> 'failed' AND lower(execution_status)
              <> 'completed'  AND lower(execution_status) <> 'stopped' AND lower(execution_status)
              <> 'killed'
          schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: Execution ID/string
            schema: integer
            mandatory: false
            createdBy: sql
          end_time:
            link: TimeAfterPreProcess/string
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
      StopTaskJob:
        parent: LuFunction
        in:
          functionName:
            const: failJobWithoutRetry
          errorMessage:
            link: PreProcessErrorFields/message
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          failureReason:
            schema: any
    split: '--------------------'
  Pre process success:
    else: true
    dependsOn: Execute pre process
  Interface Type:
    actors:
      SourceInterfaceType:
        parent: InnerFlow
        in:
          flowName:
            const: bwCheckDBType
          interface:
            link: Task properties/object/K2VERIFY_INTERFACE_SRC
            schema: string
            mandatory: false
            createdBy: flowName
          envName:
            link: Task properties/object/K2VERIFY_ENV_SRC
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          type:
            schema: string
          error:
            schema: string
  JDBC interface:
    dependsOn: Interface Type
    actors:
      JDBC Interface:
        parent: JavaScript
        condition: result
        in:
          script:
            const: '!(dbtype.indexOf(''FileSystem'') > -1 || dbtype ==''SFTP'')'
          dbtype:
            link: SourceInterfaceType/type
            schema: string
            mandatory: false
        out:
          result:
            schema: boolean
      TableVerifyJobName:
        parent: Const
        in:
          value:
            const: bwExecuteTableDataVerify
            schema: string
        out:
          value:
            schema: string
    split: '--------------------'
  FileSystem Interface:
    else: true
    dependsOn: Interface Type
    actors:
      FileVerifyJobName:
        parent: Const
        in:
          value:
            const: bwExecuteCsvDataVerify
            schema: string
        out:
          value:
            schema: string
  Table props:
    dependsOn: JDBC interface
    actors:
      Props:
        parent: Const
        height: 331
        in:
          value:
            const: null
            link: DeepCopyProps/value
        out:
          value:
            schema: '#ref'
    split: '--------------------'
  File pros:
    dependsOn: FileSystem Interface
    actors:
      FilesProps:
        parent: Const
        in:
          value:
            const: null
            link: DeepCopyProps/value
        out:
          value:
            schema: '#ref'
  For each table defined:
    dependsOn: Table props
    actors:
      SourceTableName:
        parent: Split
        in:
          delimiter:
            const: .
          string:
            link:
              path: Props/value/src
              iterate: Iterate
      TargetTableName:
        parent: Split
        in:
          delimiter:
            const: .
          string:
            link:
              path: Props/value/tar
              iterate: Iterate
    split: '--------------------'
  For each file defined:
    dependsOn: File pros
    actors:
      SrcFileName:
        parent: Split
        in:
          delimiter:
            const: \.(?=.*)
          regex:
            const: true
          limit:
            const: 2
          string:
            link:
              path: FilesProps/value/src
              iterate: Iterate
      TarFileName:
        parent: Split
        in:
          delimiter:
            const: \.(?=.*)
          regex:
            const: true
          limit:
            const: 2
          string:
            link:
              path: FilesProps/value/tar
              iterate: Iterate
  tables details:
    dependsOn: For each table defined
    actors:
      TablesDetailsMap:
        parent: JavaScript
        in:
          script:
            const:
              userCode: |-
                const myMap = {};

                myMap.src_schema =src_table[0];
                myMap.src_table  = src_table[1];
                myMap.tar_schema = tar_table[0];
                myMap.tar_table  = tar_table[1];

                myMap;
              script: |-
                var myMap = {};
                myMap.src_schema = src_table[0];
                myMap.src_table = src_table[1];
                myMap.tar_schema = tar_table[0];
                myMap.tar_table = tar_table[1];
                myMap;
          src_table:
            link: SourceTableName/strings
            schema: '#ref'
            mandatory: false
          tar_table:
            link: TargetTableName/strings
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  Stage 14:
    dependsOn: For each file defined
    actors:
      FilesMetadataMap:
        parent: JavaScript
        in:
          script:
            const:
              userCode: |-
                const myMap = {};

                myMap.src_schema =src_table[0];
                myMap.src_table  = src_table[1];
                myMap.tar_schema = tar_table[0];
                myMap.tar_table  = tar_table[1];

                myMap;
              script: |-
                var myMap = {};
                myMap.src_schema = src_table[0];
                myMap.src_table = src_table[1];
                myMap.tar_schema = tar_table[0];
                myMap.tar_table = tar_table[1];
                myMap;
          src_table:
            link: SrcFileName/strings
            schema: '#ref'
            mandatory: false
          tar_table:
            link: TarFileName/strings
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Stage 1:
    dependsOn: tables details
    actors:
      CheckTableStatus:
        parent: DbFetchField
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: select status from ${@verify_schema}.task_execution_tables where
              task_id=${task_id} and execution_id=${execution_id} and table_name=${table_name}
          verify_schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: sql
          table_name:
            link: TablesDetailsMap/result/src_table
            schema: string
            mandatory: false
            createdBy: sql
    split: '--------------------'
  Stage 2:
    dependsOn: Stage 14
    actors:
      VerifyCsvExecution:
        parent: BroadwayJob
        in:
          flowName:
            const: bwExecuteCsvDataVerify
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: flowName
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: flowName
          Source_Table_Name:
            link: FilesMetadataMap/result/src_table
            schema: string
            mandatory: false
            createdBy: flowName
          Source_Interface:
            link: Task properties/object/K2VERIFY_INTERFACE_SRC
            schema: string
            editor:
              interfaceType:
              - LOCAL
              - SFTP
              - filesystem
              interfaces:
              - file:///
              id: com.k2view.interface
            mandatory: false
            createdBy: flowName
          Target_Table_Name:
            link: FilesMetadataMap/result/tar_table
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Target_Interface:
            link: Task properties/object/K2VERIFY_INTERFACE_TAR
            schema: string
            editor:
              interfaceType:
              - LOCAL
              - SFTP
              - filesystem
              interfaces:
              - file://
              id: com.k2view.interface
            mandatory: false
            createdBy: flowName
          log_pass:
            link: Task properties/object/K2VERIFY_LOGPASS
            schema: string
            mandatory: false
            createdBy: flowName
          compare_only_pii:
            link: Task properties/object/K2VERIFY_PII_ONLY_COMPARISON
            schema: string
            mandatory: false
            createdBy: flowName
          maxWorkers:
            link: Task properties/object/K2VERIFY_MAXWORKERSPERNODE
            schema: any
            mandatory: false
            createdBy: flowName
          source_environment:
            link: Task properties/object/K2VERIFY_ENV_SRC
            schema: string
            mandatory: false
            createdBy: flowName
          target_environment:
            link: Task properties/object/K2VERIFY_ENV_TAR
            schema: string
            mandatory: false
            createdBy: flowName
          source_environment_is_pii:
            link: Task properties/object/K2VERIFY_SRC_CONTAINS_SENSITIVE_DATA
            schema: string
            mandatory: false
            createdBy: flowName
          target_environment_is_pii:
            link: Task properties/object/K2VERIFY_TAR_CONTAINS_SENSITIVE_DATA
            schema: string
            mandatory: false
            createdBy: flowName
          Source_Schema:
            link: FilesMetadataMap/result/src_schema
            schema: string
            mandatory: false
            createdBy: flowName
          Target_Schema:
            link: FilesMetadataMap/result/tar_schema
            schema: string
            mandatory: false
            createdBy: flowName
          buckets_num:
            link:
              path: FilesProps/value/buckets
              iterate: Iterate
            schema: any
            mandatory: false
            createdBy: flowName
          buckets_count:
            schema: string
            mandatory: false
            createdBy: flowName
          interfaceType:
            link: SourceInterfaceType/type
            schema: any
            mandatory: false
            createdBy: flowName
  Check table status:
    remark: Execute verify on the the if the execution is in retry mode and the tables
      status is Failed. Or the execution is regular mode (not retry)
    last: 1
    dependsOn: Stage 1
    actors:
      ExecuteVerify:
        parent: JavaScript
        condition: result
        in:
          script:
            const:
              userCode: (IsRetryMode == "true" && table_status=='Failed') || !(IsRetryMode
                =="true")
              script: IsRetryMode == "true" && table_status == 'Failed' || !(IsRetryMode
                == "true");
          IsRetryMode:
            external: IsRetryMode
            schema: any
            mandatory: false
          table_status:
            link: CheckTableStatus/result
            schema: any
            mandatory: false
        out:
          result:
            schema: boolean
      VerifyTableExecution:
        parent: BroadwayJob
        in:
          flowName:
            const: bwExecuteTableDataVerify
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: flowName
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: flowName
          Source_Table_Name:
            link: TablesDetailsMap/result/src_table
            schema: string
            mandatory: false
            createdBy: flowName
          Source_Interface:
            link: Task properties/object/K2VERIFY_INTERFACE_SRC
            schema: string
            editor:
              interfaceType:
              - database
              - CassandraLoader
              interfaces:
              - fabric
              id: com.k2view.interface
            mandatory: false
            createdBy: flowName
          Source_Schema:
            link: TablesDetailsMap/result/src_schema
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Target_Table_Name:
            link: TablesDetailsMap/result/tar_table
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Target_Interface:
            link: Task properties/object/K2VERIFY_INTERFACE_TAR
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Target_Schema:
            link: TablesDetailsMap/result/tar_schema
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          maxWorkers:
            link: Task properties/object/K2VERIFY_MAXWORKERSPERNODE
            schema: string
            mandatory: false
            createdBy: flowName
          log_pass:
            link: Task properties/object/K2VERIFY_LOGPASS
            schema: boolean
            mandatory: false
            createdBy: flowName
          compare_only_pii:
            link: Task properties/object/K2VERIFY_PII_ONLY_COMPARISON
            schema: boolean
            mandatory: false
            createdBy: flowName
          Buckets:
            link:
              path: Props/value/buckets
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
          interfaceType:
            link: SourceInterfaceType/type
            schema: string
            mandatory: false
            createdBy: flowName
          source_environment:
            link: Task properties/object/K2VERIFY_ENV_SRC
            schema: string
            mandatory: false
            createdBy: flowName
          target_environment:
            link: Task properties/object/K2VERIFY_ENV_TAR
            schema: string
            mandatory: false
            createdBy: flowName
          source_environment_is_pii:
            link: Task properties/object/K2VERIFY_SRC_CONTAINS_SENSITIVE_DATA
            schema: string
            mandatory: false
            createdBy: flowName
          target_environment_is_pii:
            link: Task properties/object/K2VERIFY_TAR_CONTAINS_SENSITIVE_DATA
            schema: string
            mandatory: false
            createdBy: flowName
          IsRetryMode:
            external: IsRetryMode
            schema: string
            mandatory: false
            createdBy: flowName
    split: '--------------------'
  Stage 4:
    last: 1
    else: true
    dependsOn: Stage 1
    split: '--------------------'
  Stage 3:
    last: 1
    dependsOn: Stage 2
  While:
    actors:
      While1:
        parent: While
        in:
          script:
            const: true;
        out:
          result:
            schema: '#ref'
  While true:
    actors:
      Loop:
        parent: Const
        in:
          value:
            const: null
            link:
              path: While1/result
              iterate: Iterate
        out:
          value:
            schema: boolean
      TableVerifyJobStatus:
        parent: DbFetchFirstRow
        in:
          interface:
            const: fabric
          sql:
            const: jobstatus name='verify.${@jobName}'
          jobName:
            link:
            - TableVerifyJobName/value
            - FileVerifyJobName/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Job still running:
    last: 1
    dependsOn: While true
    actors:
      NotNull:
        parent: NotNull
        condition: result
        in:
          value:
            link:
              path: TableVerifyJobStatus/result/Name
              iterate: First
      Sleep1:
        parent: Sleep
        in:
          millis:
            const: 5000
    split: '--------------------'
  else:
    last: 1
    else: true
    dependsOn: While true
    actors:
      LoopStop1:
        parent: LoopStop
  Time Before PK Creation:
    actors:
      TimeBeforePK:
        parent: Now
      TimeBeforePKStr:
        parent: ToString
        in:
          value:
            link: TimeBeforePK/date
  Update time before PK creation:
    actors:
      RetryPhysicalError6:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      UpTimeBeforePKCreation:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: update ${@schema}.task_execution set time_until_pk='${@time_until_pk}'
              where task_id=${@task_id} and execution_id=${@execution_id} and execution_status='In_Progress'
          schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: Execution ID/string
            schema: integer
            mandatory: false
            createdBy: sql
          time_until_pk:
            link: TimeBeforePKStr/string
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Create PK:
    dependsOn: Update time before PK creation
    actors:
      ToCreatePK:
        parent: NotEquals
        condition: result
        in:
          a:
            external: IsRetryMode
            schema: string
          b:
            const: 'true'
            schema: string
      RetryPhysicalError7:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      FieldSumPK:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: ALTER TABLE ${@k2verify_schema}.k2verify_field_summary_${@execution_id}
              ADD CONSTRAINT k2verify_field_summary_${@execution_id}_pkey PRIMARY
              KEY (EXECUTION_ID, IID, SOURCE_TABLE_NAME, TARGET_TABLE_NAME, CUSTOMIZED_KEY,
              COLUMN_NAME);
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: sql
          k2verify_schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
    split: '--------------------'
  Stage 7:
    else: true
    dependsOn: Update time before PK creation
  Time after PK creation:
    actors:
      TimeAfterPK:
        parent: Now
      TimeAfterPKStr:
        parent: ToString
        in:
          value:
            link: TimeAfterPK/date
  Update time after PK creation:
    actors:
      RetryPhysicalError8:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      UpTimeAfterPKCreation:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: update ${@schema}.task_execution set time_after_pk='${@time_after_pk}'
              where task_id=${@task_id} and execution_id=${@execution_id} and execution_status='In_Progress'
          schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: Execution ID/string
            schema: integer
            mandatory: false
            createdBy: sql
          time_after_pk:
            link: TimeAfterPKStr/string
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Time before index creation:
    actors:
      TimeBeforeIDX:
        parent: Now
      TimeBeforeIDXStr:
        parent: ToString
        in:
          value:
            link: TimeBeforeIDX/date
  Update time before index creation:
    actors:
      RetryPhysicalError9:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      UpTimeBeforeIDXCreation:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: update ${@schema}.task_execution set time_until_index='${@time_until_index}'
              where task_id=${@task_id} and execution_id=${@execution_id} and execution_status='In_Progress'
          schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: Execution ID/string
            schema: integer
            mandatory: false
            createdBy: sql
          time_until_index:
            link: TimeBeforeIDXStr/string
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Create index:
    dependsOn: Update time before index creation
    actors:
      ToCreateIndex:
        parent: NotEquals
        condition: result
        in:
          a:
            external: IsRetryMode
            schema: string
          b:
            const: 'true'
            schema: string
      RetryPhysicalError10:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      FieldSumIDX:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: CREATE INDEX IF NOT EXISTS IID_FIELD_SUMMARY_${@execution_id}_IDX
              ON ${@k2verify_schema}.k2verify_field_summary_${@execution_id} (iid);
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: sql
          k2verify_schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
    split: '--------------------'
  Retry Mode - index already created:
    else: true
    dependsOn: Update time before index creation
  Time after index creation:
    transactional: false
    actors:
      TimeAfterIDX:
        parent: Now
      TimeAfterIDXStr:
        parent: ToString
        in:
          value:
            link: TimeAfterIDX/date
  Update time after index creation:
    transactional: false
    actors:
      RetryPhysicalError101:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      UpTimeAfterIDXCreation:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: update ${@schema}.task_execution set time_after_index='${@time_after_index}'
              where task_id=${@task_id} and execution_id=${@execution_id} and execution_status='In_Progress'
          schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: Execution ID/string
            schema: integer
            mandatory: false
            createdBy: sql
          time_after_index:
            link: TimeAfterIDXStr/string
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Record table summary:
    transactional: false
    actors:
      RetryPhysicalError102:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      RecordSummary:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: |-
              INSERT INTO ${@result_schema}.k2verify_record_summary_${@execution_id}(
                  execution_id,
                  iid,
                  source_table_name,
                  target_table_name,
                  customized_key,
                  number_of_fields_mismatch,
                  number_of_fields_match,
                  number_of_fields_only_in_target,
                  number_of_fields_only_in_source,
                  number_of_fields_unsecured_in_target
              )
              SELECT
                  execution_id,
                  0 AS iid,
                  source_table_name,
                  target_table_name,
                  customized_key,
                  COUNT(*) FILTER (WHERE match_result = 'NOT PASSED') AS number_of_fields_mismatch,
                  COUNT(*) FILTER (WHERE match_result = 'PASSED') AS number_of_fields_match,
                  COUNT(*) FILTER (
                      WHERE match_result IN ('Target Key Not Found In Source','Instance Not Found In Source')
                  ) AS number_of_fields_only_in_target,
                  COUNT(*) FILTER (
                      WHERE match_result IN ('Source Key Not Found In Target','Instance Not Found In Target')
                  ) AS number_of_fields_only_in_source,
                  COUNT(*) FILTER (WHERE match_result = 'NOT PASSED') AS number_of_fields_unsecured_in_target
              FROM ${@result_schema}.k2verify_field_summary_${@execution_id}
              GROUP BY
                  execution_id,
                  iid,
                  source_table_name,
                  target_table_name,
                  customized_key;
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: sql
          result_schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Execution history table:
    transactional: false
    actors:
      RetryPhysicalError103:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      ExecutionHistory:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: |-
              INSERT INTO ${@result_schema}.task_execution_history(
                  execution_id,
                  number_of_fields_match,
                  number_of_fields_mismatch,
                  number_of_fields_only_in_target,
                  number_of_fields_only_in_source
              )
              SELECT
                  execution_id,
                  SUM(number_of_fields_match) AS number_of_fields_match,
                  SUM(number_of_fields_mismatch) AS number_of_fields_mismatch,
                  SUM(number_of_fields_only_in_target) AS number_of_fields_only_in_target,
                  SUM(number_of_fields_only_in_source) AS number_of_fields_only_in_source
              FROM ${@result_schema}.k2verify_record_summary_${@execution_id}
              GROUP BY execution_id
              ON CONFLICT (execution_id)
              DO UPDATE SET
                  number_of_fields_match = EXCLUDED.number_of_fields_match,
                  number_of_fields_mismatch = EXCLUDED.number_of_fields_mismatch,
                  number_of_fields_only_in_target = EXCLUDED.number_of_fields_only_in_target,
                  number_of_fields_only_in_source = EXCLUDED.number_of_fields_only_in_source;
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: sql
          result_schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Time after record summary:
    actors:
      TimeAfterRecSum:
        parent: Now
      TimeAfterRecSumStr:
        parent: ToString
        in:
          value:
            link: TimeAfterRecSum/date
  Update time after record sumary:
    actors:
      RetryPhysicalError104:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      UpTimAfterRecSum:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: update ${@schema}.task_execution set time_after_record_summary='${@time_after_record_summary}'
              where task_id=${@task_id} and execution_id=${@execution_id} and execution_status='In_Progress'
          schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: Execution ID/string
            schema: integer
            mandatory: false
            createdBy: sql
          time_after_record_summary:
            link: TimeAfterRecSumStr/string
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Table Summary:
    actors:
      RetryPhysicalError105:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      TableSummaryRows:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: |-
              INSERT INTO ${@result_schema}.k2verify_table_summary (
                  execution_id,
                  iid,
                  source_table_name,
                  target_table_name,
                  number_of_records_match,
                  number_of_records_mismatch,
                  number_of_records_only_in_source,
                  number_of_records_only_in_target,
                  number_of_records_unsecured_in_target,
                  match_result
              )
              SELECT
                  execution_id,
                  0 AS iid,
                  source_table_name,
                  target_table_name,

                  COUNT(*) FILTER (
                      WHERE number_of_fields_mismatch = 0
                        AND number_of_fields_only_in_target = 0
                        AND number_of_fields_only_in_source = 0
                  ) AS number_of_records_match,

                  COUNT(*) FILTER (WHERE number_of_fields_mismatch > 0)
                      AS number_of_records_mismatch,

                  COUNT(*) FILTER (WHERE number_of_fields_only_in_source > 0)
                      AS number_of_records_only_in_source,

                  COUNT(*) FILTER (WHERE number_of_fields_only_in_target > 0)
                      AS number_of_records_only_in_target,

                  COUNT(*) FILTER (WHERE number_of_fields_unsecured_in_target > 0)
                      AS number_of_records_unsecured_in_target,

                  CASE
                      WHEN
                          MAX(number_of_fields_mismatch) > 0
                          OR MAX(number_of_fields_only_in_source) > 0
                          OR MAX(number_of_fields_only_in_target) > 0
                      THEN 'NOT PASSED'
                      ELSE 'PASSED'
                  END AS match_result

              FROM ${@result_schema}.k2verify_record_summary_${@execution_id}
              GROUP BY
                  execution_id,
                  iid,
                  source_table_name,
                  target_table_name

              ON CONFLICT (execution_id, iid, source_table_name, target_table_name)
              DO UPDATE SET
                  number_of_records_match = EXCLUDED.number_of_records_match,
                  number_of_records_mismatch = EXCLUDED.number_of_records_mismatch,
                  number_of_records_only_in_source = EXCLUDED.number_of_records_only_in_source,
                  number_of_records_only_in_target = EXCLUDED.number_of_records_only_in_target,
                  number_of_records_unsecured_in_target = EXCLUDED.number_of_records_unsecured_in_target,
                  match_result = EXCLUDED.match_result;
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: sql
          result_schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Loop Tables:
    actors:
      Task Tables:
        parent: Const
        in:
          value:
            const: null
            link: DeepCopyProps/value
        out:
          value:
            schema: '#ref'
  For each table:
    actors:
      SrcTable:
        parent: Split
        in:
          delimiter:
            const: \.(?=.*)
          regex:
            const: true
          limit:
            const: 2
          string:
            link:
              path: Task Tables/value/src
              iterate: Iterate
      TarTable:
        parent: Split
        in:
          delimiter:
            const: \.(?=.*)
          regex:
            const: true
          limit:
            const: 2
          string:
            link:
              path: Task Tables/value/tar
              iterate: Iterate
  Tables metadata:
    actors:
      TablesMetadataMap:
        parent: JavaScript
        in:
          script:
            const:
              userCode: |-
                const myMap = {};

                myMap.src_schema =src_table[0];
                myMap.src_table  = src_table[1];
                myMap.tar_schema = tar_table[0];
                myMap.tar_table  = tar_table[1];

                myMap;
              script: |-
                var myMap = {};
                myMap.src_schema = src_table[0];
                myMap.src_table = src_table[1];
                myMap.tar_schema = tar_table[0];
                myMap.tar_table = tar_table[1];
                myMap;
          src_table:
            link: SrcTable/strings
            schema: '#ref'
            mandatory: false
          tar_table:
            link: TarTable/strings
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: '#ref'
  Select table result:
    actors:
      RetryPhysicalError106:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      FetchTableResult:
        parent: DbFetchField
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: select 1 from ${@result_schema}.k2verify_table_summary where execution_id=${execution_id}
              and iid='0' and source_table_name=${source_table_name} and target_table_name=${target_table_name}
          result_schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: sql
          source_table_name:
            link: TablesMetadataMap/result/src_table
            schema: string
            mandatory: false
            createdBy: sql
          target_table_name:
            link: TablesMetadataMap/result/tar_table
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: integer
  Generate table result:
    dependsOn: Select table result
    actors:
      ResultNotExists:
        parent: IsNull
        condition: result
        in:
          value:
            link: FetchTableResult/result
      RetryPhysicalError107:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      GenerateResultData:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: |-
              select sum(total_records) as tr, sum(total_fields) as tf
               from ${@schema}.task_execution_buckets where task_id =${task_id} and execution_id=${execution_id} and table_name=${table_name}
          schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: integer
            mandatory: false
            createdBy: sql
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: sql
          table_name:
            link: TablesMetadataMap/result/src_table
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
    split: '--------------------'
  Stage 5:
    else: true
    dependsOn: Select table result
  Load table result:
    last: 1
    dependsOn: Generate table result
    actors:
      RetryPhysicalError108:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      LoadTableResult:
        parent: DbLoad
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          command:
            const: upsert
          schema:
            const: null
            link: K2VERIFY_SCHEMA/variableValue
          table:
            const: k2verify_table_summary
          fields:
            const:
            - execution_id
            - iid
            - source_table_name
            - target_table_name
            - number_of_records_match
            - number_of_records_mismatch
            - number_of_records_only_in_source
            - number_of_records_only_in_target
            - number_of_records_unsecured_in_target
            - match_result
          keys:
            const:
            - execution_id
            - iid
            - source_table_name
            - target_table_name
          dialect:
            const: postgres
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: fields
          match_result:
            const: PASSED
            schema: string
            mandatory: false
            createdBy: fields
          iid:
            const: '0'
            schema: string
            mandatory: false
            createdBy: fields
          source_table_name:
            link: TablesMetadataMap/result/src_table
            schema: string
            mandatory: false
            createdBy: fields
          target_table_name:
            link: TablesMetadataMap/result/tar_table
            schema: string
            mandatory: false
            createdBy: fields
          number_of_records_match:
            link:
              path: GenerateResultData/result/tr
              iterate: First
            schema: integer
            mandatory: false
            createdBy: fields
          number_of_records_mismatch:
            const: 0
            schema: integer
            mandatory: false
            createdBy: fields
          number_of_records_only_in_source:
            const: 0
            schema: integer
            mandatory: false
            createdBy: fields
          number_of_records_only_in_target:
            const: 0
            schema: integer
            mandatory: false
            createdBy: fields
          number_of_records_unsecured_in_target:
            const: 0
            schema: integer
            mandatory: false
            createdBy: fields
    split: '--------------------'
  Stage 6:
    last: 1
    dependsOn: Stage 5
  TablesStatus:
    actors:
      RetryPhysicalError109:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      FetchTablesStatus:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: select table_name,status  from ${@result_schema}.task_execution_tables
              where execution_id=${execution_id}
          result_schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
      ParseTablesStatus:
        parent: JsonParser
        in:
          single:
            const: false
          stream:
            link: FetchTablesStatus/result
        out:
          object:
            schema: '#ref'
  Execute post process:
    actors:
      PostProcessError:
        parent: ErrorFields
        error: message
        out:
          inputs:
            schema: '#ref'
      ExecutePostProcess:
        parent: InnerFlow
        in:
          flowName:
            const: bwExecutePrePostProcess
          process_type:
            const: post
            schema: string
            mandatory: false
            createdBy: flowName
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: flowName
          task_id:
            external: task_id
            schema: integer
            mandatory: false
            createdBy: flowName
          task_properties:
            link: Task properties/object
            schema: '#ref'
            mandatory: false
            createdBy: flowName
          table_properties:
            link: DeepCopyProps/value
            schema: '#ref'
            mandatory: false
            createdBy: flowName
          table_status_details:
            link: ParseTablesStatus/object
            schema: '#ref'
            mandatory: false
          IsRetryMode:
            external: IsRetryMode
            schema: boolean
            mandatory: false
            createdBy: flowName
      TimeAfterPostProcess:
        parent: Now
      TimeAfterPostProcessStr:
        parent: ToString
        in:
          value:
            link: TimeAfterPostProcess/date
  post process failed - stop task:
    dependsOn: Execute post process
    actors:
      PostProcessFailed:
        parent: NotNull
        condition: result
        in:
          value:
            link: PostProcessError/message
      RetryPhysicalError1010:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      UpTaskEndTimeDueFail2:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: update ${@schema}.task_execution set execution_status='Stopped',
              end_time='${@end_time}' where task_id=${@task_id} and execution_id=${@execution_id}
              and lower(execution_status) <> 'failed' AND lower(execution_status)
              <> 'completed'  AND lower(execution_status) <> 'stopped' AND lower(execution_status)
              <> 'killed'
          schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: Execution ID/string
            schema: integer
            mandatory: false
            createdBy: sql
          end_time:
            link: TimeAfterPostProcessStr/string
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
      UpdatePostFailed:
        parent: DbCommand
        height: 309
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: update ${@k2verify_schema}.task_execution_tables set status='Failed'
              , end_time='${@end_time}' where task_id=${task_id} and execution_id=${execution_id}
              and status='In_Progress'
          k2verify_schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          end_time:
            link: TimeAfterPostProcessStr/string
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: Execution ID/string
            schema: string
            mandatory: false
            createdBy: sql
      'StopTaskJob ':
        parent: LuFunction
        in:
          functionName:
            const: failJobWithoutRetry
          errorMessage:
            link: PostProcessError/message
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          failureReason:
            schema: any
    split: '--------------------'
  Stage 26:
    else: true
    dependsOn: Execute post process
  Task end time:
    actors:
      TskEndTime:
        parent: Now
      TskEndTimeStr:
        parent: ToString
        in:
          value:
            link: TskEndTime/date
  Update task completed:
    actors:
      RetryPhysicalError1011:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      UpTaskEndTime:
        parent: DbCommand
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          sql:
            const: update ${@schema}.task_execution set execution_status='Completed',
              end_time='${@end_time}' where task_id=${@task_id} and execution_id=${@execution_id}
              and lower(execution_status) <> 'failed' AND lower(execution_status)
              <> 'completed'  AND lower(execution_status) <> 'stopped' AND lower(execution_status)
              <> 'killed'
          schema:
            link: K2VERIFY_SCHEMA/variableValue
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            external: task_id
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: Execution ID/string
            schema: integer
            mandatory: false
            createdBy: sql
          end_time:
            link: TskEndTimeStr/string
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
