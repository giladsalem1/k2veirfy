tags: k2verify
stages:
  Stage 1:
    actors:
      table name:
        parent: Const
        in:
          value:
            const: null
            external: table_name
        out:
          value:
            schema: string
  Stage 2: {
    }
  Stage 3:
    actors:
      DbCommand1:
        parent: DbCommand
        in:
          interface:
            const: null
            external: dbInterface
          sql:
            const: |-
              select customized_key,column_name,match_result,source_column_value,target_column_value from ${@schema_name}.k2verify_field_summary
              where execution_id = ${execution_id} and source_table_name = ${source_table_name} and lower(match_result)='not passed'
          schema_name:
            external: schema_name
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
            createdBy: sql
          source_table_name:
            link: table name/value
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
      JavaScript2:
        parent: JavaScript
        in:
          script:
            const: '"execution_id_"+execution_id+"/"+tableName+"_record_details.csv"'
          tableName:
            link: table name/value
            schema: string
            mandatory: false
          execution_id:
            external: execution_id
            schema: string
            mandatory: false
        out:
          result:
            schema: string
  Stage 4:
    actors:
      CsvBuilder1:
        parent: CsvBuilder
        in:
          maps:
            link:
              path: DbCommand1/result
              iterate: Iterate
  Stage 5:
    actors:
      FileWrite1:
        parent: FileWrite
        in:
          interface:
            const: null
            external: interface
          append:
            const: true
          ioBufferSize:
            const: 65536
          path:
            link: JavaScript2/result
          stream:
            link: CsvBuilder1/csv
schemas:
  DbCommand1.out.result:
    type: array
    items:
      type: object
      properties:
        column_name:
          type: string
        total_failed:
          type: integer
