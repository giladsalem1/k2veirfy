tags: k2verify
stages:
  Stage 1:
    actors:
      K2VERIFY_OPERATIONAL_INTERFACE:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_OPERATIONAL_INTERFACE
      K2VERIFY_OPERATIONAL_INTERFACE1:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_OPERATIONAL_SCHEMA
      SEPERATOR:
        parent: GetLUVariable
        in:
          luName:
            const: verify
          variableName:
            const: K2VERIFY_CONF_SEPARATOR
  Stage 2:
    actors:
      DbCommand1:
        parent: DbCommand
        in:
          interface:
            const: K2VERIFY_OPERATIONAL_DB
            link: K2VERIFY_OPERATIONAL_INTERFACE/result
            default: true
          sql:
            const: select distinct source_table_name from ${@schema_name}.k2verify_field_summary_${@execution_id}
              where execution_id = ${execution_id} order by source_table_name
          schema_name:
            link: K2VERIFY_OPERATIONAL_INTERFACE1/result
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            external: execution_id
            schema: integer
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Stage 3:
    actors:
      DbFetchFirstRow1:
        parent: DbFetchFirstRow
        in:
          interface:
            const: null
            link: K2VERIFY_OPERATIONAL_INTERFACE/result
          sql:
            const: |-
              select
              pii_column_names as "Pii_Columns",
              source_interface as "Source_Interface",
              source_schema as "Source_Schema",
              source_table_name as "Source_Table_Name"
              from ${@schema}.verify_configuration where  source_table_name=${source_table_name}
          schema:
            link: K2VERIFY_OPERATIONAL_INTERFACE1/result
            schema: string
            mandatory: false
            createdBy: sql
          source_table_name:
            link:
              path: DbCommand1/result/source_table_name
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: sql
        out:
          result:
            schema: '#ref'
  Stage 9:
    actors:
      bwGetPiiColumns:
        parent: InnerFlow
        in:
          flowName:
            const: bwGetPiiColumns
          interface:
            link: DbFetchFirstRow1/result/Source_Interface
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          schema:
            link: DbFetchFirstRow1/result/Source_Schema
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          table:
            link: DbFetchFirstRow1/result/Source_Table_Name
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          customized_pii:
            link: DbFetchFirstRow1/result/Pii_Columns
            schema: string
            mandatory: false
            createdBy: flowName
          delim:
            link: SEPERATOR/variableValue
        out:
          pii_columns:
            schema: string
  Stage 6:
    dependsOn: Stage 9
    actors:
      JavaScript1:
        parent: JavaScript
        condition: result
        in:
          script:
            const: |-
              if(pii_columns){true}
              else{false}
          pii_columns:
            link: bwGetPiiColumns/pii_columns
            schema: string
            mandatory: false
        out:
          result:
            schema: boolean
      Split1:
        parent: Split
        in:
          delimiter:
            const: '|'
          string:
            link: bwGetPiiColumns/pii_columns
    split: '--------------------'
  Stage 8:
    else: true
    dependsOn: Stage 9
  Stage 7:
    actors:
      MapCreate1:
        parent: MapCreate
        in:
          interface_name:
            link: DbFetchFirstRow1/result/Source_Interface
            schema: string
            mandatory: false
          table_name:
            link: DbFetchFirstRow1/result/Source_Table_Name
            schema: string
            mandatory: false
          schema_name:
            link: DbFetchFirstRow1/result/Source_Schema
            schema: string
            mandatory: false
          pii_column:
            link:
              path: Split1/strings
              iterate: Iterate
            schema: string
            mandatory: false
        out:
          map:
            schema: '#ref'
  Stage 5:
    dependsOn: Stage 7
    actors:
      ArrayBuilder1:
        parent: ArrayBuilder
        in:
          input:
            link:
              path: MapCreate1/map
              pos: 0
        out:
          array:
            external: array
            schema: '#ref'
    split: '--------------------'
  Stage 10:
    dependsOn: Stage 7
schemas:
  DbCommand1.out.result:
    type: array
    items:
      type: object
      properties:
        source_table_name:
          type: string
        target_table_name:
          type: string
        column_name:
          type: string
        execution_id:
          type: integer
  DbFetchFirstRow1.out.result:
    type: object
    properties:
      Pii_Columns:
        type: string
      Source_Interface:
        type: string
      Source_Schema:
        type: string
      Source_Table_Name:
        type: string
  MapCreate1.out.map:
    type: object
    properties:
      dataPlatform:
        type: array
        items:
          type: string
      table:
        type: array
        items:
          type: string
      piiColumn:
        type: string
  ArrayBuilder1.out.array:
    type: array
    items:
      type: object
      properties:
        dataPlatform:
          type: string
        schema:
          type: string
        dataset:
          type: string
        class:
          type: string
        field:
          type: string
        sqlDataType:
          type: string
        pii: {
          }
        sourceDataType:
          type: string
        sourceEntityType:
          type: string
        sourceNullable:
          type: string
        columnSize:
          type: string
        definedBy:
          type: string
        ordinalPosition:
          type: string
        classification: {
          }
        idx: {
          }
        pk: {
          }
        V1: {
          }
