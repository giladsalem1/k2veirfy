stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          IID:
            external: IID
            schema: any
            mandatory: false
        out:
          parent_rows:
            schema: '#ref'
      SRC TABLE:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_TABLE_SRC
      TASK ID:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_TASK_ID
      EXEC ID:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_EXEC_ID
      K2VERIFY_INTERFACE:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_OPERATIONAL_INTERFACE
          luName:
            external: schema
      K2VERIFY_SCHEMA:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_OPERATIONAL_SCHEMA
          luName:
            external: schema
      K2VERIFY_SRC_TABLE:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_TABLE_SRC
          luName:
            external: schema
      RootPopStartTime:
        parent: Now
      RootPopStartTimeStr:
        parent: ToString
        in:
          value:
            link: RootPopStartTime/date
  Load root table:
    actors:
      LoadRootTable:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
            - IID
          dialect:
            const: sqlite
          IID:
            link: PopulationArgs/iid
            schema: string
  Skip GET functionality:
    remark: In CSV mode, we execute get to load the LUI tables. we don't need to execute
      Verify logic
    actors:
      IgnoreGET:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_CSV_MODE_DUMMY_GET
        out:
          result:
            schema: '#ref'
  Execute population logic:
    actors:
      ExecutePop:
        parent: NotEquals
        condition: result
        in:
          b:
            const: 'true'
            schema: string
          a:
            link:
              path: IgnoreGET/result/value
              iterate: First
      SplitIID:
        parent: Split
        height: 254
        in:
          delimiter:
            const: _@_
          string:
            link: PopulationArgs/iid
  Check CSV moce:
    actors:
      CSV Mode:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_CSV_MODE;
        out:
          result:
            schema: '#ref'
  Is CSV Verify mode:
    dependsOn: Check CSV moce
    actors:
      =TRUE:
        parent: Equals
        condition: result
        in:
          b:
            const: 'true'
            schema: string
          a:
            link:
              path: CSV Mode/result/value
              iterate: First
      CSV Verify Bucket:
        parent: Const
        in:
          value:
            const: null
            link: PopulationArgs/iid
    split: '--------------------'
  Table to table mode:
    else: true
    dependsOn: Check CSV moce
    actors:
      Table Verify Bucket:
        parent: JavaScript
        in:
          script:
            const: arr[1]
          arr:
            link: SplitIID/strings
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: string
  Load verify execution table:
    actors:
      LoadExecutionTable:
        parent: DbLoad
        in:
          interface:
            const: null
            link: K2VERIFY_INTERFACE/variableValue
          command:
            const: upsert
          schema:
            const: null
            link: K2VERIFY_SCHEMA/variableValue
          table:
            const: task_execution_buckets
          fields:
            const:
            - task_id
            - execution_id
            - table_name
            - bucket_id
            - status
            - total_records
            - processed_records
            - failed_records
            - start_time
            - end_time
            - error_info
          keys:
            const:
            - task_id
            - execution_id
            - table_name
            - bucket_id
          dialect:
            const: postgres
          task_id:
            link: TASK ID/result
            schema: string
            mandatory: false
            createdBy: table
          execution_id:
            link: EXEC ID/result
            schema: string
            mandatory: false
            createdBy: table
          table_name:
            link: K2VERIFY_SRC_TABLE/variableValue
            schema: string
            mandatory: false
            createdBy: table
          bucket_id:
            link:
            - CSV Verify Bucket/value
            - Table Verify Bucket/result
            schema: string
            mandatory: false
            createdBy: table
          status:
            const: In_Progress
            schema: string
            mandatory: false
            createdBy: table
          start_time:
            link: RootPopStartTimeStr/string
            schema: string
            mandatory: false
            createdBy: table
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        IID:
          type: string
  IgnoreGET.out.result:
    type: array
    items:
      type: object
      properties:
        value:
          type: string
  CSV Mode.out.result:
    type: array
    items:
      type: object
      properties:
        value:
          type: string
  Table Verify Bucket.in.arr:
    type: array
    items:
      type: string
