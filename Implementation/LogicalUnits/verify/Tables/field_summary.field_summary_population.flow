stages:
  Population args:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          iid:
            external: iid
            schema: any
            mandatory: false
        out:
          parent_rows:
            schema: '#ref'
      SRC Interface:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_INTERFACE_SRC
      SRC SCHEMA:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_SCHEMA_SRC
      SRC TABLE:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_TABLE_SRC
      TAR Interface:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_INTERFACE_TAR
      TAR SCHEMA:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_SCHEMA_TAR
      TAR TABLE:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_TABLE_TAR
      BucketsNum:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_TABLE_BUCKETS_NUM
      SEPERATOR:
        parent: GetLUVariable
        in:
          variableName:
            const: K2VERIFY_CONF_SEPARATOR
          luName:
            external: schema
      K2VERIFY_INTERFACE_SRC_TYPE:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_INTERFACE_SRC_TYPE
      TASK ID:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_TASK_ID
      EXEC ID:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_EXEC_ID
      RESULTS DIR:
        parent: FabricSetRead
        in:
          key:
            const: verify.K2VERIFY_RESULT_FILES_PATH
      RESULTS INTERFACE:
        parent: FabricSetRead
        in:
          key:
            const: verify.K2VERIFY_OPERATIONAL_INTERFACE
      RESULTS SCHEMA:
        parent: FabricSetRead
        in:
          key:
            const: verify.K2VERIFY_OPERATIONAL_SCHEMA
      K2VERIFY_SRC_CONTAINS_SENSITIVE_DATA:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_SRC_CONTAINS_SENSITIVE_DATA
      K2VERIFY_TAR_CONTAINS_SENSITIVE_DATA:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_TAR_CONTAINS_SENSITIVE_DATA
  Stage 1:
    actors:
      DUMMY GET:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_DUMMY_GET;
        out:
          result:
            schema: '#ref'
  Bucket number:
    actors:
      NotEquals1:
        parent: NotEquals
        condition: result
        in:
          b:
            const: 'true'
            schema: string
          a:
            link:
              path: DUMMY GET/result/value
              iterate: First
      SplitIID:
        parent: Split
        in:
          delimiter:
            const: _@_
          string:
            link: PopulationArgs/iid
      csvFileName:
        parent: JavaScript
        in:
          script:
            const: arr[0]
          arr:
            link: SplitIID/strings
            schema: any
            mandatory: false
        out:
          result:
            schema: string
      ToNumber1:
        parent: ToNumber
        height: 329
        in:
          value:
            link: TASK ID/result
      ToNumber2:
        parent: ToNumber
        height: 84
        in:
          value:
            link: EXEC ID/result
  Fetch table verify config:
    actors:
      bwGetTableParams1:
        parent: InnerFlow
        in:
          flowName:
            const: bwGetTableParams
          Source_Table_Name:
            link: SRC TABLE/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Source_Interface:
            link: SRC Interface/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Source_Schema:
            link: SRC SCHEMA/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Target_Table_Name:
            link: TAR TABLE/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Target_Interface:
            link: TAR Interface/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Target_Schema:
            link: TAR SCHEMA/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Buckets:
            link: BucketsNum/result
            schema: string
            mandatory: false
            createdBy: flowName
        out:
          tableParams:
            schema: '#ref'
  Table info:
    transactional: false
    actors:
      Row Info:
        parent: Const
        in:
          value:
            const: null
            link: bwGetTableParams1/tableParams
        out:
          value:
            schema: '#ref'
      tableName:
        parent: StringFormat
        in:
          format:
            const: k2verify_field_summary_${execution_id}
          execution_id:
            link: EXEC ID/result
            schema: string
            mandatory: false
            createdBy: format
      IID:
        parent: JavaScript
        in:
          script:
            const: arr[1]
          arr:
            link: SplitIID/strings
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: string
  Execluded columns:
    transactional: false
    actors:
      UpperExcluded:
        parent: Uppercase
        in:
          string:
            link: Row Info/value/Excluded_Columns_Names
  Stage 2:
    transactional: false
    dependsOn: Execluded columns
    actors:
      Equals1:
        parent: Equals
        condition: result
        in:
          b:
            const: LocalFileSystem
            schema: string
          a:
            link: K2VERIFY_INTERFACE_SRC_TYPE/result
      InterfaceForCsv:
        parent: Const
        in:
          value:
            const: fabric
            schema: string
        out:
          value:
            schema: string
      Source:
        parent: Const
        in:
          value:
            const: verify
            schema: string
        out:
          value:
            schema: string
      SourceTblForCsv:
        parent: StringFormat
        in:
          format:
            const: src_${fileName}
          fileName:
            link: csvFileName/result
            schema: string
            mandatory: false
            createdBy: format
      SourceTblForCsv1:
        parent: StringFormat
        in:
          format:
            const: tar_${fileName}
          fileName:
            link: csvFileName/result
            schema: string
            mandatory: false
            createdBy: format
      InterfaceForCsv1:
        parent: Const
        in:
          value:
            const: sqlite (db)
            schema: string
        out:
          value:
            schema: string
      fileName1:
        parent: StringFormat
        in:
          format:
            const: ${dir}/verify_fields_results_${source_table_name}_${execution_id}_${bucket_id}.csv
          bucket_id:
            link: IID/result
            schema: string
            mandatory: false
            createdBy: format
          dir:
            link: RESULTS DIR/result
            schema: string
            mandatory: false
            createdBy: format
          execution_id:
            link: EXEC ID/result
            schema: string
            mandatory: false
            createdBy: format
          source_table_name:
            link: SourceTblForCsv/string
            schema: string
            mandatory: false
            createdBy: format
      Const9:
        parent: Const
        in:
          value:
            const: null
            link: PopulationArgs/iid
        out:
          value:
            schema: string
    split: '--------------------'
  Stage 3:
    else: true
    transactional: false
    dependsOn: Execluded columns
    actors:
      Const1:
        parent: Const
        in:
          value:
            const: null
            link: Row Info/value/Source_Interface
        out:
          value:
            schema: string
      Const2:
        parent: Const
        in:
          value:
            const: null
            link: Row Info/value/Source_Schema
        out:
          value:
            schema: string
      Const3:
        parent: Const
        in:
          value:
            const: null
            link: Row Info/value/Source_Table_Name
        out:
          value:
            schema: string
      Const4:
        parent: Const
        in:
          value:
            const: null
            link: Row Info/value/Target_Interface
        out:
          value:
            schema: string
      Const5:
        parent: Const
        in:
          value:
            const: null
            link: Row Info/value/Target_Schema
        out:
          value:
            schema: string
      Const6:
        parent: Const
        in:
          value:
            const: null
            link: Row Info/value/Target_Table_Name
        out:
          value:
            schema: string
      Const7:
        parent: Const
        in:
          value:
            const: null
            link: K2VERIFY_INTERFACE_SRC_TYPE/result
        out:
          value:
            schema: string
      fileName:
        parent: StringFormat
        in:
          format:
            const: ${dir}/verify_fields_results_${source_table_name}_${execution_id}_${bucket_id}.csv
          bucket_id:
            link: IID/result
            schema: string
            mandatory: false
            createdBy: format
          dir:
            link: RESULTS DIR/result
            schema: string
            mandatory: false
            createdBy: format
          execution_id:
            link: EXEC ID/result
            schema: string
            mandatory: false
            createdBy: format
          source_table_name:
            link: SRC TABLE/result
            schema: string
            mandatory: false
            createdBy: format
      Const8:
        parent: Const
        in:
          value:
            const: null
            link: IID/result
        out:
          value:
            schema: string
  Stage 4:
    transactional: false
  Verify data:
    transactional: false
    actors:
      Check Active:
        parent: ToBool
        condition: bool
        in:
          value:
            link: Row Info/value/Active
      VerifyTargetData:
        parent: InnerFlow
        height: 971
        in:
          flowName:
            const: bwVerifySourceNTargetData
          schema:
            external: schema
            schema: string
            editor:
              id: com.k2view.dbtable
            mandatory: false
            createdBy: flowName
          IID:
            link:
            - Const9/value
            - Const8/value
            schema: string
            mandatory: false
            createdBy: flowName
          excludeCondition:
            link: Row Info/value/Excluded_Rows_Sql
            schema: string
            mandatory: false
            createdBy: flowName
          ColumnMapping:
            link: Row Info/value/Column_Mapping
            schema: string
            mandatory: false
            createdBy: flowName
          Pii_Columns:
            link: Row Info/value/Pii_Columns
            schema: string
            mandatory: false
            createdBy: flowName
          sourceInterface:
            link:
            - InterfaceForCsv/value
            - Const1/value
            schema: string
            mandatory: false
            createdBy: flowName
          sourceSchema:
            link:
            - Source/value
            - Const2/value
            schema: string
            mandatory: false
            createdBy: flowName
          sourceTable:
            link:
            - SourceTblForCsv/string
            - Const3/value
            schema: string
            mandatory: false
            createdBy: flowName
          targetInterface:
            link:
            - InterfaceForCsv/value
            - Const4/value
            schema: string
            mandatory: false
            createdBy: flowName
          targetSchema:
            link:
            - Source/value
            - Const5/value
            schema: string
            mandatory: false
            createdBy: flowName
          targetTable:
            link:
            - SourceTblForCsv1/string
            - Const6/value
            schema: string
            mandatory: false
            createdBy: flowName
          excludedColumnsNames:
            link: UpperExcluded/string
            schema: string
            mandatory: false
            createdBy: flowName
          customizedKeyComparison:
            link: Row Info/value/Customized_Key_Comparison
            schema: string
            mandatory: false
            createdBy: flowName
          source_columns_to_Ignore_null:
            link: Row Info/value/source_columns_to_Ignore_null
            schema: string
            mandatory: false
            createdBy: flowName
          target_columns_to_Ignore_null:
            link: Row Info/value/target_columns_to_Ignore_null
            schema: string
            mandatory: false
            createdBy: flowName
          bucketMethod:
            link: Row Info/value/Buckets_Method
            schema: string
            mandatory: false
            createdBy: flowName
          bucketsNum:
            link: Row Info/value/Buckets
            schema: string
            mandatory: false
            createdBy: flowName
          execution_id:
            link: EXEC ID/result
            schema: string
            mandatory: false
            createdBy: flowName
          task_id:
            link: TASK ID/result
            schema: string
            mandatory: false
            createdBy: flowName
          source_transformation_function:
            link: Row Info/value/Source_Transformation_Function_Name
            schema: string
            mandatory: false
            createdBy: flowName
          target_transformation_function:
            link: Row Info/value/Target_Transformation_Function_Name
            schema: any
            mandatory: false
            createdBy: flowName
          interfaceType:
            link:
            - InterfaceForCsv1/value
            - Const7/value
            schema: string
            mandatory: false
            createdBy: flowName
          result_file_name:
            link:
            - fileName1/string
            - fileName/string
            schema: string
            mandatory: false
            createdBy: flowName
          k2verify_src_contains_sensitive_data:
            link: K2VERIFY_SRC_CONTAINS_SENSITIVE_DATA/result
            schema: any
            mandatory: false
          k2verify_tar_contains_sensitive_data:
            link: K2VERIFY_TAR_CONTAINS_SENSITIVE_DATA/result
            schema: any
            mandatory: false
  Tme befor PG Copy:
    actors:
      TmeBeforPGCopy:
        parent: Now
      TmeBeforPGCopyStr:
        parent: ToString
        in:
          value:
            link: TmeBeforPGCopy/date
  Update time before PG Copy:
    actors:
      UpTimeBeforePGCP:
        parent: DbCommand
        in:
          interface:
            const: null
            link: RESULTS INTERFACE/result
          sql:
            const: update ${@schema}.task_execution_buckets set time_until_copy =
              ${time_until_copy} where task_id=${task_id} and execution_id=${execution_id}
              and table_name=${table_name} and bucket_id=${bucket_id}
          schema:
            link: RESULTS SCHEMA/result
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            link: ToNumber1/number
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: ToNumber2/number
            schema: string
            mandatory: false
            createdBy: sql
          table_name:
            link: SRC TABLE/result
            schema: string
            mandatory: false
            createdBy: sql
          bucket_id:
            link: IID/result
            schema: string
            mandatory: false
            createdBy: sql
          time_until_copy:
            link: TmeBeforPGCopyStr/string
            schema: string
            mandatory: false
            createdBy: sql
  Copy bucket data to pg:
    actors:
      ErrorHandler2:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: No such file or directory
              actions:
                suppress: true
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
      pgCopy:
        parent: pgCopy
        in:
          interface:
            const: null
            link: RESULTS INTERFACE/result
          schema:
            const: null
            link: RESULTS SCHEMA/result
          table:
            const: null
            link: tableName/string
          fields:
            const:
            - EXECUTION_ID
            - IID
            - SOURCE_TABLE_NAME
            - TARGET_TABLE_NAME
            - CUSTOMIZED_KEY
            - COLUMN_NAME
            - MATCH_RESULT
            - TARGET_VALUE_SECURED
            - SOURCE_COLUMN_VALUE
            - TARGET_COLUMN_VALUE
            - SOURCE_COLUMN_VALUE_TRANS
            - TARGET_COLUMN_VALUE_TRANS
          header:
            const: false
          file_path:
            link:
            - fileName1/string
            - fileName/string
  Time after PG Copy:
    actors:
      TimeAfterPGCopy:
        parent: Now
      TimeAfterPGCopyStr:
        parent: ToString
        in:
          value:
            link: TimeAfterPGCopy/date
  Update time after PG Copy:
    actors:
      UpTimeAfterPGCP:
        parent: DbCommand
        in:
          interface:
            const: null
            link: RESULTS INTERFACE/result
          sql:
            const: update ${@schema}.task_execution_buckets set time_after_copy =
              ${time_after_copy} where task_id=${task_id} and execution_id=${execution_id}
              and table_name=${table_name} and bucket_id=${bucket_id}
          schema:
            link: RESULTS SCHEMA/result
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            link: ToNumber1/number
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: ToNumber2/number
            schema: string
            mandatory: false
            createdBy: sql
          table_name:
            link: SRC TABLE/result
            schema: string
            mandatory: false
            createdBy: sql
          bucket_id:
            link: IID/result
            schema: string
            mandatory: false
            createdBy: sql
          time_after_copy:
            link: TimeAfterPGCopyStr/string
            schema: string
            mandatory: false
            createdBy: sql
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        iid:
          type: string
  DUMMY GET.out.result:
    type: array
    items:
      type: object
      properties:
        value:
          type: string
  bwGetTableParams1.out.tableParams:
    type: object
    properties:
      Source_Table_Name:
        type: string
      Source_Interface:
        type: string
      Source_Schema:
        type: string
      Source_Transformation_Function_Name: {
        }
      source_columns_to_Ignore_null: {
        }
      Target_Table_Name:
        type: string
      Target_Interface:
        type: string
      Target_Schema:
        type: string
      Target_Transformation_Function_Name: {
        }
      target_columns_to_Ignore_null: {
        }
      Customized_Key_Comparison:
        type: string
      Pii_Columns: {
        }
      Excluded_Columns_Names: {
        }
      Active:
        type: string
      Mode: {
        }
      Excluded_Rows_Sql: {
        }
      Column_Mapping: {
        }
      Buckets:
        type: string
      Buckets_Method:
        type: string
  Row Info.out.value:
    type: object
    properties:
      Source_Table_Name:
        type: string
      Source_Interface:
        type: string
      Source_Schema:
        type: string
      Source_Transformation_Function_Name: {
        }
      source_columns_to_Ignore_null: {
        }
      Target_Table_Name:
        type: string
      Target_Interface:
        type: string
      Target_Schema:
        type: string
      Target_Transformation_Function_Name: {
        }
      target_columns_to_Ignore_null: {
        }
      Customized_Key_Comparison:
        type: string
      Pii_Columns:
        type: string
      Excluded_Columns_Names: {
        }
      Active:
        type: string
      Mode: {
        }
      Excluded_Rows_Sql: {
        }
      Column_Mapping: {
        }
      Buckets:
        type: string
      Buckets_Method:
        type: string
  IID.in.arr:
    type: array
    items:
      type: string
