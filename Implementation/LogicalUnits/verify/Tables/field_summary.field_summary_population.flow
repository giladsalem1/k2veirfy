stages:
  Population args:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          iid:
            external: iid
            schema: any
            mandatory: false
        out:
          parent_rows:
            schema: '#ref'
      SRC Interface:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_INTERFACE_SRC
      SRC SCHEMA:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_SCHEMA_SRC
      SRC TABLE:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_TABLE_SRC
      TAR Interface:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_INTERFACE_TAR
      TAR SCHEMA:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_SCHEMA_TAR
      TAR TABLE:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_TABLE_TAR
      BucketsNum:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_TABLE_BUCKETS_NUM
      K2VERIFY_INTERFACE_SRC_TYPE:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_INTERFACE_SRC_TYPE
      TASK ID:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_TASK_ID
      EXEC ID:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_EXEC_ID
      RESULTS DIR:
        parent: FabricSetRead
        in:
          key:
            const: verify.K2VERIFY_RESULT_FILES_PATH
      RESULTS INTERFACE:
        parent: FabricSetRead
        in:
          key:
            const: verify.K2VERIFY_OPERATIONAL_INTERFACE
      RESULTS SCHEMA:
        parent: FabricSetRead
        in:
          key:
            const: verify.K2VERIFY_OPERATIONAL_SCHEMA
      K2VERIFY_SRC_CONTAINS_SENSITIVE_DATA:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_SRC_CONTAINS_SENSITIVE_DATA
      K2VERIFY_TAR_CONTAINS_SENSITIVE_DATA:
        parent: FabricSetRead
        in:
          key:
            const: K2VERIFY_TAR_CONTAINS_SENSITIVE_DATA
  Skip GET functionality:
    remark: In CSV mode, we execute get to load the LUI tables. we don't need to execute
      Verify logic
    actors:
      DUMMY GET:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: set K2VERIFY_CSV_MODE_DUMMY_GET;
        out:
          result:
            schema: '#ref'
  Bucket number:
    actors:
      '!=TRUE':
        parent: NotEquals
        condition: result
        in:
          b:
            const: 'true'
            schema: string
          a:
            link:
              path: DUMMY GET/result/value
              iterate: First
      SplitIID:
        parent: Split
        in:
          delimiter:
            const: _@_
          string:
            link: PopulationArgs/iid
      csvFileName:
        parent: JavaScript
        in:
          script:
            const: arr[0]
          arr:
            link: SplitIID/strings
            schema: any
            mandatory: false
        out:
          result:
            schema: string
      TaskID:
        parent: ToNumber
        in:
          value:
            link: TASK ID/result
      ExecutionID:
        parent: ToNumber
        height: 84
        in:
          value:
            link: EXEC ID/result
  Fetch table verify config:
    actors:
      GetTableParams:
        parent: InnerFlow
        in:
          flowName:
            const: bwGetTableParams
          Source_Table_Name:
            link: SRC TABLE/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Source_Interface:
            link: SRC Interface/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Source_Schema:
            link: SRC SCHEMA/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Target_Table_Name:
            link: TAR TABLE/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Target_Interface:
            link: TAR Interface/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Target_Schema:
            link: TAR SCHEMA/result
            schema: string
            editor:
              id: com.k2view.mTableKey
            mandatory: false
            createdBy: flowName
          Buckets:
            link: BucketsNum/result
            schema: string
            mandatory: false
            createdBy: flowName
          task_id:
            link: TaskID/number
            schema: any
            mandatory: false
            createdBy: flowName
        out:
          tableParams:
            schema: '#ref'
  Table info:
    transactional: false
    actors:
      TableInfo:
        parent: Const
        in:
          value:
            const: null
            link: GetTableParams/tableParams
        out:
          value:
            schema: '#ref'
      ResultTableName:
        parent: StringFormat
        in:
          format:
            const: k2verify_field_summary_${execution_id}
          execution_id:
            link: EXEC ID/result
            schema: string
            mandatory: false
            createdBy: format
      IID:
        parent: JavaScript
        in:
          script:
            const: arr[1]
          arr:
            link: SplitIID/strings
            schema: '#ref'
            mandatory: false
        out:
          result:
            schema: string
  Execluded columns:
    transactional: false
    actors:
      UpperExcluded:
        parent: Uppercase
        in:
          string:
            link: TableInfo/value/Excluded_Columns_Names
  Csv mode:
    transactional: false
    dependsOn: Execluded columns
    actors:
      JavaScript1:
        parent: JavaScript
        condition: result
        in:
          script:
            const: dbtype.indexOf('FileSystem') > -1 || dbtype =='SFTP'
          dbtype:
            link: K2VERIFY_INTERFACE_SRC_TYPE/result
            schema: any
            mandatory: false
      FabricAsInterafce:
        parent: Const
        in:
          value:
            const: fabric
            schema: string
        out:
          value:
            schema: string
      SqliteAsDbType:
        parent: Const
        in:
          value:
            const: sqlite (db)
            schema: string
        out:
          value:
            schema: string
      VerifyAsSchema:
        parent: Const
        in:
          value:
            const: verify
            schema: string
        out:
          value:
            schema: string
      SourceTblForCsv:
        parent: StringFormat
        in:
          format:
            const: src_${fileName}
          fileName:
            link: csvFileName/result
            schema: string
            mandatory: false
            createdBy: format
      TargetTblForCsv:
        parent: StringFormat
        in:
          format:
            const: tar_${fileName}
          fileName:
            link: csvFileName/result
            schema: string
            mandatory: false
            createdBy: format
      ResultFileNameForCsv:
        parent: StringFormat
        in:
          format:
            const: ${dir}/verify_fields_results_${source_table_name}_${execution_id}_${bucket_id}.csv
          bucket_id:
            link: IID/result
            schema: string
            mandatory: false
            createdBy: format
          dir:
            link: RESULTS DIR/result
            schema: string
            mandatory: false
            createdBy: format
          execution_id:
            link: EXEC ID/result
            schema: string
            mandatory: false
            createdBy: format
          source_table_name:
            link: SourceTblForCsv/string
            schema: string
            mandatory: false
            createdBy: format
      BucketIDForCSV:
        parent: Const
        in:
          value:
            const: null
            link: PopulationArgs/iid
        out:
          value:
            schema: string
    split: '--------------------'
  DB Table mode:
    else: true
    transactional: false
    dependsOn: Execluded columns
    actors:
      SourceInterface:
        parent: Const
        in:
          value:
            const: null
            link: TableInfo/value/Source_Interface
        out:
          value:
            schema: string
      SourceSchema:
        parent: Const
        in:
          value:
            const: null
            link: TableInfo/value/Source_Schema
        out:
          value:
            schema: string
      SourceTable:
        parent: Const
        in:
          value:
            const: null
            link: TableInfo/value/Source_Table_Name
        out:
          value:
            schema: string
      TargetInterface:
        parent: Const
        in:
          value:
            const: null
            link: TableInfo/value/Target_Interface
        out:
          value:
            schema: string
      TargetSchema:
        parent: Const
        in:
          value:
            const: null
            link: TableInfo/value/Target_Schema
        out:
          value:
            schema: string
      TargetTable:
        parent: Const
        in:
          value:
            const: null
            link: TableInfo/value/Target_Table_Name
        out:
          value:
            schema: string
      DbType:
        parent: Const
        in:
          value:
            const: null
            link: K2VERIFY_INTERFACE_SRC_TYPE/result
        out:
          value:
            schema: string
      ResultFileNameForTables:
        parent: StringFormat
        in:
          format:
            const: ${dir}/verify_fields_results_${source_table_name}_${execution_id}_${bucket_id}.csv
          bucket_id:
            link: IID/result
            schema: string
            mandatory: false
            createdBy: format
          dir:
            link: RESULTS DIR/result
            schema: string
            mandatory: false
            createdBy: format
          execution_id:
            link: EXEC ID/result
            schema: string
            mandatory: false
            createdBy: format
          source_table_name:
            link: SRC TABLE/result
            schema: string
            mandatory: false
            createdBy: format
      BucketIDForTables:
        parent: Const
        in:
          value:
            const: null
            link: IID/result
        out:
          value:
            schema: string
  Stage 4:
    transactional: false
  Verify data:
    transactional: false
    actors:
      Check Active:
        parent: ToBool
        condition: bool
        in:
          value:
            link: TableInfo/value/Active
      VerifySourceTargetData:
        parent: InnerFlow
        height: 971
        in:
          flowName:
            const: bwVerifySourceNTargetData
          schema:
            external: schema
            schema: string
            editor:
              id: com.k2view.dbtable
            mandatory: false
            createdBy: flowName
          IID:
            link:
            - BucketIDForCSV/value
            - BucketIDForTables/value
            schema: string
            mandatory: false
            createdBy: flowName
          excludeCondition:
            link: TableInfo/value/Excluded_Rows_Sql
            schema: string
            mandatory: false
            createdBy: flowName
          ColumnMapping:
            link: TableInfo/value/Column_Mapping
            schema: string
            mandatory: false
            createdBy: flowName
          Pii_Columns:
            link: TableInfo/value/Pii_Columns
            schema: string
            mandatory: false
            createdBy: flowName
          sourceInterface:
            link:
            - FabricAsInterafce/value
            - SourceInterface/value
            schema: string
            mandatory: false
            createdBy: flowName
          sourceSchema:
            link:
            - VerifyAsSchema/value
            - SourceSchema/value
            schema: string
            mandatory: false
            createdBy: flowName
          sourceTable:
            link:
            - SourceTblForCsv/string
            - SourceTable/value
            schema: string
            mandatory: false
            createdBy: flowName
          targetInterface:
            link:
            - FabricAsInterafce/value
            - TargetInterface/value
            schema: string
            mandatory: false
            createdBy: flowName
          targetSchema:
            link:
            - VerifyAsSchema/value
            - TargetSchema/value
            schema: string
            mandatory: false
            createdBy: flowName
          targetTable:
            link:
            - TargetTblForCsv/string
            - TargetTable/value
            schema: string
            mandatory: false
            createdBy: flowName
          excludedColumnsNames:
            link: UpperExcluded/string
            schema: string
            mandatory: false
            createdBy: flowName
          customizedKeyComparison:
            link: TableInfo/value/Customized_Key_Comparison
            schema: string
            mandatory: false
            createdBy: flowName
          source_columns_to_Ignore_null:
            link: TableInfo/value/source_columns_to_Ignore_null
            schema: any
            mandatory: false
            createdBy: flowName
          target_columns_to_Ignore_null:
            link: TableInfo/value/target_columns_to_Ignore_null
            schema: any
            mandatory: false
            createdBy: flowName
          bucketMethod:
            link: TableInfo/value/Buckets_Method
            schema: string
            mandatory: false
            createdBy: flowName
          bucketsNum:
            link: TableInfo/value/Buckets
            schema: string
            mandatory: false
            createdBy: flowName
          execution_id:
            link: EXEC ID/result
            schema: string
            mandatory: false
            createdBy: flowName
          task_id:
            link: TASK ID/result
            schema: string
            mandatory: false
            createdBy: flowName
          source_transformation_function:
            link: TableInfo/value/Source_Transformation_Function_Name
            schema: string
            mandatory: false
            createdBy: flowName
          target_transformation_function:
            link: TableInfo/value/Target_Transformation_Function_Name
            schema: any
            mandatory: false
            createdBy: flowName
          interfaceType:
            link:
            - SqliteAsDbType/value
            - DbType/value
            schema: string
            mandatory: false
            createdBy: flowName
          result_file_name:
            link:
            - ResultFileNameForCsv/string
            - ResultFileNameForTables/string
            schema: string
            mandatory: false
            createdBy: flowName
          source_env_contains_sensitive_data:
            link: K2VERIFY_SRC_CONTAINS_SENSITIVE_DATA/result
            schema: any
            mandatory: false
            createdBy: flowName
          target_env_contains_sensitive_data:
            link: K2VERIFY_TAR_CONTAINS_SENSITIVE_DATA/result
            schema: any
            mandatory: false
            createdBy: flowName
  Tme befor PG Copy:
    actors:
      TmeBeforPGCopy:
        parent: Now
      TmeBeforPGCopyStr:
        parent: ToString
        in:
          value:
            link: TmeBeforPGCopy/date
  Update time before PG Copy:
    actors:
      RetryPhysicalError1:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      UpTimeBeforePGCP:
        parent: DbCommand
        in:
          interface:
            const: null
            link: RESULTS INTERFACE/result
          sql:
            const: update ${@schema}.task_execution_buckets set time_until_copy =
              ${time_until_copy} where task_id=${task_id} and execution_id=${execution_id}
              and table_name=${table_name} and bucket_id=${bucket_id}
          schema:
            link: RESULTS SCHEMA/result
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            link: TaskID/number
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: ExecutionID/number
            schema: string
            mandatory: false
            createdBy: sql
          table_name:
            link: SRC TABLE/result
            schema: string
            mandatory: false
            createdBy: sql
          bucket_id:
            link: IID/result
            schema: string
            mandatory: false
            createdBy: sql
          time_until_copy:
            link: TmeBeforPGCopyStr/string
            schema: string
            mandatory: false
            createdBy: sql
  Copy bucket data to pg:
    actors:
      HandlePGCopy:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: No such file or directory
              actions:
                suppress: true
                log: false
                flowName: ''
                number_of_retries: ''
                retry_interval: ''
            - exceptionKey: java.lang.Exception
              conditions:
                message: (?s)^(?!.*No such file or directory).*
              actions:
                suppress: true
                log: true
                flowName: bwPhysicalError
                number_of_retries: ''
                retry_interval: ''
          physical_error_type:
            const: PG_COPY_OPERATION_FAILED
            schema: string
            mandatory: false
      pgCopy:
        parent: pgCopy
        in:
          interface:
            const: null
            link: RESULTS INTERFACE/result
          schema:
            const: null
            link: RESULTS SCHEMA/result
          table:
            const: null
            link: ResultTableName/string
          fields:
            const:
            - EXECUTION_ID
            - IID
            - SOURCE_TABLE_NAME
            - TARGET_TABLE_NAME
            - CUSTOMIZED_KEY
            - COLUMN_NAME
            - MATCH_RESULT
            - TARGET_VALUE_SECURED
            - SOURCE_COLUMN_VALUE
            - TARGET_COLUMN_VALUE
            - SOURCE_COLUMN_VALUE_TRANS
            - TARGET_COLUMN_VALUE_TRANS
          header:
            const: false
          file_path:
            link:
            - ResultFileNameForCsv/string
            - ResultFileNameForTables/string
  Time after PG Copy:
    actors:
      TimeAfterPGCopy:
        parent: Now
      TimeAfterPGCopyStr:
        parent: ToString
        in:
          value:
            link: TimeAfterPGCopy/date
  Update time after PG Copy:
    actors:
      RetryPhysicalError2:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.sql.SQLException
              conditions:
                errorCode: ''
              actions:
                suppress: true
                log: false
                flowName: bwPhysicalError
                number_of_retries: '3'
                retry_interval: '1000'
          physical_error_type:
            const: DATABASE_OPERATION_FAILED
            schema: string
            mandatory: false
      UpTimeAfterPGCP:
        parent: DbCommand
        in:
          interface:
            const: null
            link: RESULTS INTERFACE/result
          sql:
            const: update ${@schema}.task_execution_buckets set time_after_copy =
              ${time_after_copy} where task_id=${task_id} and execution_id=${execution_id}
              and table_name=${table_name} and bucket_id=${bucket_id}
          schema:
            link: RESULTS SCHEMA/result
            schema: string
            mandatory: false
            createdBy: sql
          task_id:
            link: TaskID/number
            schema: string
            mandatory: false
            createdBy: sql
          execution_id:
            link: ExecutionID/number
            schema: string
            mandatory: false
            createdBy: sql
          table_name:
            link: SRC TABLE/result
            schema: string
            mandatory: false
            createdBy: sql
          bucket_id:
            link: IID/result
            schema: string
            mandatory: false
            createdBy: sql
          time_after_copy:
            link: TimeAfterPGCopyStr/string
            schema: string
            mandatory: false
            createdBy: sql
schemas:
  PopulationArgs.out.parent_rows:
    type: array
    items:
      type: object
      properties:
        iid:
          type: string
  DUMMY GET.out.result:
    type: array
    items:
      type: object
      properties:
        value:
          type: string
  GetTableParams.out.tableParams:
    type: object
    properties:
      Source_Table_Name:
        type: string
      Source_Interface:
        type: string
      Source_Schema:
        type: string
      Source_Transformation_Function_Name: {
        }
      source_columns_to_Ignore_null: {
        }
      Target_Table_Name:
        type: string
      Target_Interface:
        type: string
      Target_Schema:
        type: string
      Target_Transformation_Function_Name: {
        }
      target_columns_to_Ignore_null: {
        }
      Customized_Key_Comparison:
        type: string
      Pii_Columns: {
        }
      Excluded_Columns_Names: {
        }
      Active:
        type: string
      Mode: {
        }
      Excluded_Rows_Sql: {
        }
      Column_Mapping: {
        }
      Buckets:
        type: string
      Buckets_Method:
        type: string
  TableInfo.out.value:
    type: object
    properties:
      Source_Table_Name:
        type: string
      Source_Interface:
        type: string
      Source_Schema:
        type: string
      Source_Transformation_Function_Name: {
        }
      source_columns_to_Ignore_null: {
        }
      Target_Table_Name:
        type: string
      Target_Interface:
        type: string
      Target_Schema:
        type: string
      Target_Transformation_Function_Name: {
        }
      target_columns_to_Ignore_null: {
        }
      Customized_Key_Comparison:
        type: string
      Pii_Columns:
        type: string
      Excluded_Columns_Names: {
        }
      Active:
        type: string
      Mode: {
        }
      Excluded_Rows_Sql: {
        }
      Column_Mapping: {
        }
      Buckets:
        type: string
      Buckets_Method:
        type: string
  IID.in.arr:
    type: array
    items:
      type: string
